---
import Layout from '~/layouts/PageLayout.astro';
import AdminNav from '~/components/admin/AdminNav.astro';
import type { MetaData } from '~/types';

interface Props {
  metadata?: MetaData;
  title?: string;
  subtitle?: string;
  maxWidth?: '4xl' | '5xl' | '6xl';
}

const { metadata, title, subtitle, maxWidth = '5xl' } = Astro.props;

const widthClass = {
  '4xl': 'max-w-4xl',
  '5xl': 'max-w-5xl',
  '6xl': 'max-w-6xl',
}[maxWidth];
---

<Layout metadata={metadata}>
  <section class="py-10 md:py-14 bg-cream min-h-[60vh]">
    <div class={`${widthClass} mx-auto px-4 sm:px-6`}>
      <p class="cm-eyebrow mb-2">Admin</p>
      <AdminNav />
      {
        title && (
          <header class="mb-8">
            <h1 class="cm-heading text-2xl md:text-3xl font-bold text-plum">{title}</h1>
            {subtitle && <p class="mt-2 text-sm text-plum-soft">{subtitle}</p>}
          </header>
        )
      }
      <slot />
    </div>
  </section>
</Layout>
