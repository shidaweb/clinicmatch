---
import Layout from '~/layouts/PageLayout.astro';
import AccountNav from '~/components/account/AccountNav.astro';
import type { MetaData } from '~/types';

interface Props {
  metadata?: MetaData;
  title?: string;
  subtitle?: string;
  maxWidth?: 'lg' | '2xl' | '3xl' | '4xl' | '5xl';
  showNav?: boolean;
}

const { metadata, title, subtitle, maxWidth = '5xl', showNav = true } = Astro.props;

const widthClass = {
  lg: 'max-w-lg',
  '2xl': 'max-w-2xl',
  '3xl': 'max-w-3xl',
  '4xl': 'max-w-4xl',
  '5xl': 'max-w-5xl',
}[maxWidth];
---

<Layout metadata={metadata}>
  <section class="py-10 md:py-14 bg-cream min-h-[60vh]">
    <div class={`${widthClass} mx-auto px-4 sm:px-6`}>
      {showNav && <AccountNav />}
      {
        title && (
          <header class="mb-8 flex flex-wrap items-start justify-between gap-4">
            <div>
              <h1 class="cm-heading text-2xl md:text-3xl font-bold">{title}</h1>
              {subtitle && <p class="mt-2 text-sm text-plum-soft">{subtitle}</p>}
            </div>
            <slot name="actions" />
          </header>
        )
      }
      <slot />
    </div>
  </section>
</Layout>
