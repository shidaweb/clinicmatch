---
export const prerender = false;

import { getCollection } from 'astro:content';
import Layout from '~/layouts/PageLayout.astro';
import PostCard from '~/components/PostCard.astro';
import CaseCard from '~/components/CaseCard.astro';
import MarketFilters from '~/components/MarketFilters.astro';
import EmptyState from '~/components/EmptyState.astro';
import TrustBadges from '~/components/TrustBadges.astro';
import Breadcrumb from '~/components/seo/Breadcrumb.astro';
import { getCanonical, getHomePermalink, getPermalink } from '~/utils/permalinks';
import { hasSupabaseConfig } from '~/lib/env';
import {
  buildCasesUrl,
  fetchMarketPosts,
  mergeMarketPosts,
  parseCasesFilters,
} from '~/lib/cases-page';

const filters = parseCasesFilters(Astro.url);
const { view, type, category, prefecture, city, minPrice, maxPrice, sort, q } = filters;

const allCases = await getCollection('cases');
let staticCases = allCases.sort(
  (a, b) => new Date(b.data.transactionDate).getTime() - new Date(a.data.transactionDate).getTime()
);
if (category) {
  staticCases = staticCases.filter((c) => c.data.category === category);
}

let marketPosts: ReturnType<typeof mergeMarketPosts> = [];
if (hasSupabaseConfig(Astro.locals as never) && view !== 'done') {
  const { listings, wanted } = await fetchMarketPosts(Astro.cookies, Astro.locals as never, filters);
  marketPosts = mergeMarketPosts(listings, wanted, type, sort);
}

const showMarket = view === 'active' || view === 'all';
const showDone = view === 'done' || view === 'all';
const totalCount = (showMarket ? marketPosts.length : 0) + (showDone ? staticCases.length : 0);

const casesCanonical = String(getCanonical(getPermalink('cases')));
const metadata = {
  title: view === 'done' ? '成約事例' : '在庫・取引事例',
  description:
    '美容医療機器の募集中在庫と成約事例。脱毛機・ピコレーザー・IPL・HIFU・RF・痩身機器をカテゴリ・エリア・価格で探せます。',
  canonical: category || view !== 'active' ? casesCanonical : String(getCanonical(Astro.url.pathname)),
  robots: category || view !== 'active' ? { index: false, follow: true } : undefined,
};

const tabClass = (active: boolean) =>
  active
    ? 'rounded-xl bg-brand-600 px-4 py-2 text-sm font-semibold text-white shadow-sm'
    : 'rounded-xl border border-border bg-surface px-4 py-2 text-sm font-medium text-text hover:bg-surface-muted transition';
---

<Layout metadata={metadata}>
  <section class="py-12 md:py-16 bg-surface-muted">
    <div class="max-w-7xl mx-auto px-4 sm:px-6">
      <Breadcrumb
        class="mb-6 text-sm"
        items={[
          { name: 'トップ', url: getHomePermalink() },
          { name: '在庫・取引事例' },
        ]}
      />

      <div class="mb-8">
        <h1 class="text-3xl md:text-4xl font-bold text-text">在庫・取引事例</h1>
        <p class="mt-2 text-text-muted max-w-2xl">
          いま募集中の売りたい・買いたいと、過去の成約事例を同じ画面で探せます。匿名表示・運営仲介です。
        </p>
        <div class="mt-4">
          <TrustBadges />
        </div>
      </div>

      <div class="flex flex-wrap items-center gap-2 mb-6">
        <a href={buildCasesUrl({ view: 'active', type, category, prefecture, city, minPrice, maxPrice, sort, q })} class={tabClass(view === 'active')}>
          募集中（在庫）
        </a>
        <a href={buildCasesUrl({ view: 'done', type, category, prefecture, city, minPrice, maxPrice, sort, q })} class={tabClass(view === 'done')}>
          成約事例
        </a>
        <a href={buildCasesUrl({ view: 'all', type, category, prefecture, city, minPrice, maxPrice, sort, q })} class={tabClass(view === 'all')}>
          すべて
        </a>
        <span class="ml-auto text-sm text-text-muted tabular-nums">{totalCount}件</span>
      </div>

      <div class="grid lg:grid-cols-[280px_1fr] gap-8">
        <aside>
          {view !== 'done' && (
            <MarketFilters {view} {type} {category} {prefecture} {city} {minPrice} {maxPrice} {sort} {q} />
          )}
          {view === 'done' && category && (
            <div class="rounded-xl border border-border bg-surface p-4 text-sm text-text-muted">
              カテゴリ: {category}
              <a href={buildCasesUrl({ view: 'done' })} class="block mt-2 text-brand-600 hover:underline">フィルタを解除</a>
            </div>
          )}
        </aside>

        <div class="space-y-10">
          {
            showMarket && (
              <div>
                {view === 'all' && (
                  <h2 class="text-lg font-semibold text-text mb-4">募集中</h2>
                )}
                {
                  marketPosts.length === 0 ? (
                    <EmptyState
                      title="募集中の投稿がありません"
                      message="条件を変えるか、運営に相談してマッチングを依頼できます。"
                      actionHref="/contact"
                      actionLabel="条件で相談する"
                    />
                  ) : (
                    <div class="grid sm:grid-cols-2 xl:grid-cols-3 gap-4">
                      {marketPosts.map(({ kind, post }) => (
                        <PostCard {post} {kind} />
                      ))}
                    </div>
                  )
                }
              </div>
            )
          }

          {
            showDone && (
              <div>
                {view === 'all' && (
                  <h2 class="text-lg font-semibold text-text mb-4">成約事例</h2>
                )}
                {
                  staticCases.length === 0 ? (
                    <EmptyState
                      title="成約事例がありません"
                      message="カテゴリを変えるか、相談フォームからお問い合わせください。"
                      actionHref="/contact"
                      actionLabel="相談する"
                    />
                  ) : (
                    <div class="grid sm:grid-cols-2 xl:grid-cols-3 gap-4">
                      {staticCases.map((entry) => {
                        const slug = entry.id.replace(/\.mdx?$/, '');
                        const { data } = entry;
                        return (
                          <CaseCard
                            {slug}
                            title={data.title}
                            categoryLabel={data.categoryLabel}
                            manufacturedDate={data.manufacturedDate}
                            transactionDate={data.transactionDate}
                            manufacturer={data.manufacturer}
                            model={data.model}
                          />
                        );
                      })}
                    </div>
                  )
                }
              </div>
            )
          }
        </div>
      </div>
    </div>
  </section>
</Layout>
