---
export const prerender = false;

import { getCollection } from 'astro:content';
import Layout from '~/layouts/PageLayout.astro';
import MaintenanceBadge from '~/components/MaintenanceBadge.astro';
import ConsultButton from '~/components/ConsultButton.astro';
import MatchSuggestions from '~/components/MatchSuggestions.astro';
import Breadcrumb from '~/components/seo/Breadcrumb.astro';
import Button from '~/components/ui/Button.astro';
import { createSupabaseServerClient } from '~/lib/supabase/server';
import {
  anonymousOrgLabel,
  formatLocation,
  formatPriceYen,
  PUBLIC_LISTING_SELECT,
  PUBLIC_WANTED_SELECT,
  type PublicListing,
  type PublicWanted,
} from '~/lib/marketplace';
import { hasSupabaseConfig } from '~/lib/env';
import { getProfile } from '~/lib/auth';
import { matchWantedForListing, matchListingsForWanted } from '~/lib/matching';
import { isUuid } from '~/lib/cases-page';
import { getPermalink, getHomePermalink, getCanonical } from '~/utils/permalinks';
import type { MetaData } from '~/types';

const slugParam = Astro.params.slug;
const slug = Array.isArray(slugParam) ? slugParam.join('/') : (slugParam ?? '');
const detailType = Astro.url.searchParams.get('type') ?? 'listing';

if (!slug) return Astro.redirect('/cases');

type PageMode = 'listing' | 'wanted' | 'static' | 'redirect';
let mode: PageMode = 'redirect';

let listing: PublicListing | null = null;
let wanted: PublicWanted | null = null;
let matchWanted: ReturnType<typeof matchWantedForListing> = [];
let matchListings: ReturnType<typeof matchListingsForWanted> = [];
let images: Array<{ url: string | null; storage_path: string; is_cover: boolean }> = [];
let wantedImages: Array<{ url: string; alt: string }> = [];
let profile: Awaited<ReturnType<typeof getProfile>> = null;
let isOwnListing = false;
let isOwnWanted = false;

let staticEntry: Awaited<ReturnType<typeof getCollection<'cases'>>>[number] | null = null;
let StaticContent: Awaited<ReturnType<Awaited<ReturnType<typeof getCollection<'cases'>>>[number]['render']>>['Content'] | null = null;
let staticData: Awaited<ReturnType<typeof getCollection<'cases'>>>[number]['data'] | null = null;
let relatedCases: Array<{ slug: string; title: string; categoryLabel: string; manufacturer: string; model: string; status: string }> = [];
let productJsonLd: Record<string, unknown> | null = null;

const detailPath = `/cases/${slug}?type=${detailType}`;
const supabaseUrl = import.meta.env.PUBLIC_SUPABASE_URL ?? '';

if (isUuid(slug) && hasSupabaseConfig(Astro.locals as never)) {
  const supabase = createSupabaseServerClient(Astro.cookies, Astro.locals as never);
  profile = await getProfile(Astro.cookies, Astro.locals as never);

  if (detailType === 'wanted') {
    const { data } = await supabase
      .from('wanted_requests')
      .select(PUBLIC_WANTED_SELECT)
      .eq('id', slug)
      .eq('status', 'published')
      .single();
    wanted = data as PublicWanted | null;
    if (wanted) {
      mode = 'wanted';
      if (wanted.reference_image_path && supabaseUrl) {
        wantedImages = [
          {
            url: `${supabaseUrl}/storage/v1/object/public/wanted-images/${wanted.reference_image_path}`,
            alt: wanted.maker && wanted.model ? `${wanted.maker} ${wanted.model}` : wanted.categories?.name ?? '買いたいの参考画像',
          },
        ];
      }
      const { data: listings } = await supabase
        .from('listings')
        .select(PUBLIC_LISTING_SELECT)
        .eq('status', 'published')
        .eq('category_slug', wanted.category_slug)
        .limit(30);
      matchListings = matchListingsForWanted(wanted, (listings ?? []) as unknown as PublicListing[]);
      if (profile) {
        const { data: ownRow } = await supabase
          .from('wanted_requests')
          .select('buyer_org_id')
          .eq('id', slug)
          .single();
        isOwnWanted = ownRow?.buyer_org_id === profile.org_id;
      }
    }
  } else {
    const { data } = await supabase
      .from('listings')
      .select(PUBLIC_LISTING_SELECT)
      .eq('id', slug)
      .eq('status', 'published')
      .single();
    listing = data as PublicListing | null;
    if (listing) {
      mode = 'listing';
      images = (listing.listing_images ?? []).map((img) => ({
        ...img,
        url: supabaseUrl ? `${supabaseUrl}/storage/v1/object/public/listing-images/${img.storage_path}` : null,
      }));
      const { data: wantedList } = await supabase
        .from('wanted_requests')
        .select(PUBLIC_WANTED_SELECT)
        .eq('status', 'published')
        .eq('category_slug', listing.category_slug)
        .limit(30);
      matchWanted = matchWantedForListing(listing, (wantedList ?? []) as unknown as PublicWanted[]);
      if (profile) {
        const { data: ownRow } = await supabase
          .from('listings')
          .select('seller_org_id')
          .eq('id', slug)
          .single();
        isOwnListing = ownRow?.seller_org_id === profile.org_id;
      }
    }
  }
} else if (!isUuid(slug)) {
  const cases = await getCollection('cases');
  staticEntry = cases.find((c) => c.id.replace(/\.mdx?$/, '') === slug) ?? null;
  if (staticEntry) {
    mode = 'static';
    const rendered = await staticEntry.render();
    StaticContent = rendered.Content;
    staticData = staticEntry.data;

    const slugOf = (c: (typeof cases)[number]) => c.id.replace(/\.mdx?$/, '');
    const others = cases.filter((c) => slugOf(c) !== slug);
    const sameCat = others.filter((c) => c.data.category === staticEntry!.data.category);
    const rest = others.filter((c) => c.data.category !== staticEntry!.data.category);
    relatedCases = [...sameCat, ...rest].slice(0, 3).map((c) => ({
      slug: slugOf(c),
      title: c.data.title,
      categoryLabel: c.data.categoryLabel,
      manufacturer: c.data.manufacturer,
      model: c.data.model,
      status: c.data.status,
    }));
  }
}

if (mode === 'redirect') return Astro.redirect('/cases');

function formatDateYMD(ym: string): string {
  if (!ym || ym.length < 6) return ym;
  return `${ym.slice(0, 4)}年${parseInt(ym.slice(5, 7), 10)}月`;
}

const wantedTitle =
  wanted && (wanted.maker && wanted.model ? `${wanted.maker} ${wanted.model}` : (wanted.categories?.name ?? '買いたい'));

let metadata: MetaData = { title: '在庫・取引事例' };
if (mode === 'listing' && listing) {
  metadata = {
    title: `${listing.maker} ${listing.model}（売りたい）`,
    description: `${listing.categories?.name ?? ''}の中古在庫（匿名）。所在地：${formatLocation(listing.location_prefecture, listing.location_city)}。詳細は運営が仲介します。`,
    robots: { index: false, follow: true },
  };
}
if (mode === 'wanted' && wanted) {
  metadata = {
    title: `${wantedTitle}（買いたい）`,
    description: `${wanted.categories?.name ?? ''}の買いたいリクエスト（匿名）。希望エリア・予算の概要を掲載。`,
    robots: { index: false, follow: true },
  };
}
if (mode === 'static' && staticData) {
  const sd = staticData;
  const rawDesc =
    `${sd.categoryLabel}の中古取引事例。${sd.manufacturer} ${sd.model}（${formatDateYMD(sd.manufacturedDate)}製・${sd.status}）。` +
    `保守：${sd.maintenanceContract}／価格帯：${sd.priceRange}。中古美容医療機器の状態・保守・相場の見極めをクリニックマッチが解説します。`;
  metadata = {
    title: sd.title,
    description: rawDesc.length > 158 ? `${rawDesc.slice(0, 157)}…` : rawDesc,
    canonical: String(getCanonical(getPermalink(`cases/${slug}`))),
    openGraph: { type: 'article' },
  };
  productJsonLd = {
    '@context': 'https://schema.org',
    '@type': 'Product',
    name: `${sd.manufacturer} ${sd.model}`,
    category: sd.categoryLabel,
    brand: { '@type': 'Brand', name: sd.manufacturer },
    itemCondition: 'https://schema.org/UsedCondition',
    description: metadata.description,
  };
}

const staticSpecItems = staticData
  ? [
      { label: 'メーカー', value: staticData.manufacturer },
      { label: '型番', value: staticData.model },
      { label: '製造年月', value: formatDateYMD(staticData.manufacturedDate) },
      { label: '保守状態', value: staticData.maintenanceContract },
      { label: '使用状況', value: staticData.usage },
      { label: '取引時期', value: formatDateYMD(staticData.transactionDate) },
      { label: '価格帯', value: staticData.priceRange },
    ]
  : [];
---

{mode === 'wanted' && wanted && (
  <Layout metadata={metadata}>
    <section class="py-12 md:py-16 pb-28 lg:pb-16 bg-cream">
      <div class="max-w-5xl mx-auto px-4 sm:px-6">
        <Breadcrumb
          class="mb-6 text-sm"
          items={[
            { name: 'トップ', url: getHomePermalink() },
            { name: '在庫・取引事例', url: getPermalink('cases') },
            { name: wantedTitle ?? '' },
          ]}
        />
        <div class="mb-6 flex flex-wrap items-center gap-3">
          <span class="cm-tag-buy">買いたい</span>
          <span class="text-sm text-plum-soft">{anonymousOrgLabel(wanted.area_city ?? '')}</span>
        </div>
        <div class="cm-card p-6">
          <div class="mb-5">
            {wantedImages.length > 0 ? (
              <div class="flex gap-3 overflow-x-auto snap-x snap-mandatory pb-2 -mx-1 px-1">
                {wantedImages.map((img) => (
                  <figure class="shrink-0 snap-start w-[88%] sm:w-full rounded-card border border-line bg-ivory overflow-hidden">
                    <img src={img.url} alt={img.alt} class="w-full object-cover aspect-[4/3]" loading="eager" />
                  </figure>
                ))}
              </div>
            ) : (
              <div class="aspect-[4/3] rounded-card bg-ivory border border-line flex items-center justify-center text-plum-soft">
                参考画像なし
              </div>
            )}
          </div>
          <p class="text-sm text-plum-soft">{wanted.categories?.name}</p>
          <h1 class="font-heading text-3xl font-bold text-plum mt-1">{wantedTitle}</h1>
          {wanted.comment_count > 0 && (
            <span class="mt-2 inline-flex items-center gap-1 rounded-pill bg-cream px-3 py-1 text-xs text-plum-soft">
              💬 コメント {wanted.comment_count}件
            </span>
          )}
          <dl class="mt-6 grid sm:grid-cols-2 gap-x-8 gap-y-4 text-sm">
            <div class="rounded-2xl bg-cream p-4">
              <dt class="text-plum-soft text-xs">予算</dt>
              <dd class="text-2xl font-bold text-rose tabular-nums">{formatPriceYen(wanted.budget)}</dd>
            </div>
            <div>
              <dt class="text-plum-soft text-xs">希望時期</dt>
              <dd class="text-plum font-medium">{wanted.desired_timing ?? '—'}</dd>
            </div>
            <div>
              <dt class="text-plum-soft text-xs">希望エリア</dt>
              <dd class="text-plum font-medium">
                {wanted.area_prefecture && wanted.area_city
                  ? formatLocation(wanted.area_prefecture, wanted.area_city)
                  : '—'}
              </dd>
            </div>
            <div>
              <dt class="text-plum-soft text-xs">希望状態</dt>
              <dd class="text-plum font-medium">{wanted.condition_pref ?? '—'}</dd>
            </div>
          </dl>
          {wanted.requirements && (
            <div class="mt-6 rounded-xl bg-cream p-4">
              <p class="font-medium text-plum mb-2">要件・補足</p>
              <p class="text-sm text-plum-soft whitespace-pre-wrap">{wanted.requirements}</p>
            </div>
          )}
        </div>
        <MatchSuggestions title="関連の在庫" matches={matchListings} />
      </div>
    </section>
    <div class="fixed bottom-16 inset-x-0 z-40 border-t border-line bg-ivory/95 backdrop-blur p-4 lg:static lg:border-0 lg:bg-transparent lg:mt-8">
      <div class="max-w-5xl mx-auto flex flex-wrap items-stretch gap-3">
        {profile ? (
          isOwnWanted ? (
            <a href="/account/wanted" class="cm-btn-primary detail-cta-btn flex-1 sm:flex-none">あなたの買いたい — コメントを確認</a>
          ) : (
            <button id="comment-btn" class="cm-btn-primary detail-cta-btn flex-1 sm:flex-none" data-wanted-id={wanted.id}>コメントで取引相談する</button>
          )
        ) : (
          <a href={`/auth/login?redirect=${encodeURIComponent(detailPath)}`} class="cm-btn-primary detail-cta-btn flex-1 sm:flex-none">ログインしてコメントする</a>
        )}
        <ConsultButton
          label="運営に相談する"
          variant="inline"
          relatedWantedId={wanted.id}
          class="detail-cta-btn flex-1 sm:flex-none justify-center !px-5 !text-sm !font-semibold shadow-sm"
        />
      </div>
      <p id="comment-status" class="max-w-5xl mx-auto mt-2 text-sm text-plum-soft hidden"></p>
    </div>
    <script>
      document.getElementById('comment-btn')?.addEventListener('click', async (e) => {
        const btn = e.currentTarget as HTMLButtonElement;
        const status = document.getElementById('comment-status');
        if (!status) return;
        const message = window.prompt('この買いたいへのコメント（該当機器の提案・相談）を入力してください。匿名で運営が仲介します。');
        if (!message?.trim()) return;
        status.textContent = '送信中…';
        status.classList.remove('hidden');
        const res = await fetch('/api/threads', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ wanted_request_id: btn.dataset.wantedId, message: message.trim() }),
        });
        const json = await res.json();
        if (res.ok) {
          window.location.href = `/account/threads/${json.thread_id}`;
        } else {
          status.textContent = json.error ?? '送信に失敗しました';
        }
      });
    </script>
  </Layout>
)}

{mode === 'listing' && listing && (
  <Layout metadata={metadata}>
    <section class="py-12 md:py-16 pb-28 lg:pb-16 bg-cream">
      <div class="max-w-content mx-auto px-4 sm:px-6">
        <Breadcrumb
          class="mb-6 text-sm text-plum-soft"
          items={[
            { name: 'トップ', url: getHomePermalink() },
            { name: '在庫・取引事例', url: getPermalink('cases') },
            { name: `${listing.maker} ${listing.model}` },
          ]}
        />
        <div class="mb-6 flex flex-wrap items-center gap-3">
          <span class="cm-tag-sell">売りたい</span>
          <span class="cm-tag-sage">審査済</span>
          <span class="text-sm text-plum-soft">{anonymousOrgLabel(listing.location_city)}</span>
        </div>

        <div class="grid lg:grid-cols-2 gap-8 lg:gap-10">
          <div class="space-y-3">
            {images.length ? (
              <div class="flex gap-3 overflow-x-auto snap-x snap-mandatory pb-2 -mx-1 px-1">
                {images.map((img, index) =>
                  img.url ? (
                    <figure class="relative shrink-0 snap-start w-[88%] sm:w-full rounded-card border border-line bg-ivory overflow-hidden">
                      <img
                        src={img.url}
                        alt={`${listing.maker} ${listing.model} ${index + 1}枚目`}
                        class="w-full object-cover bg-cream aspect-[4/3]"
                        loading={index === 0 ? 'eager' : 'lazy'}
                      />
                      {img.is_cover && (
                        <span class="absolute left-2 top-2 rounded-pill bg-rose px-2 py-0.5 text-[10px] text-white">
                          表紙
                        </span>
                      )}
                    </figure>
                  ) : null
                )}
              </div>
            ) : (
              <div class="aspect-[4/3] rounded-card bg-ivory border border-line flex items-center justify-center text-plum-soft">画像なし</div>
            )}
          </div>

          <div>
            <p class="text-sm text-plum-soft">{listing.categories?.name}</p>
            <h1 class="cm-heading text-[26px] md:text-[32px] font-semibold text-plum mt-1">{listing.model}</h1>
            <p class="mt-1 text-sm text-plum-soft">{listing.maker}</p>
            {listing.comment_count > 0 && (
              <span class="mt-2 inline-flex items-center gap-1 rounded-pill bg-cream px-3 py-1 text-xs text-plum-soft">
                💬 コメント {listing.comment_count}件
              </span>
            )}
            <p class="mt-3 text-sm text-plum-soft">
              所在地（匿名表示）：{formatLocation(listing.location_prefecture, listing.location_city)}
            </p>
            <div class="mt-4">
              <MaintenanceBadge
                makerMaintenance={listing.maker_maintenance}
                maintenanceTransferable={listing.maintenance_transferable}
                hasAccessories={listing.has_accessories}
              />
            </div>
            <div class="mt-5 rounded-card border border-rose/20 bg-ivory p-5 shadow-soft">
              <p class="text-xs text-plum-soft">希望価格</p>
              <p class="font-heading text-3xl font-semibold text-rose tabular-nums">{formatPriceYen(listing.asking_price)}</p>
            </div>
            <p class="mt-4 text-xs text-plum-soft leading-relaxed">
              匿名でご利用いただけます。連絡先は双方の合意後に開示されます。
            </p>
          </div>
        </div>

        <section class="mt-12">
          <h2 class="cm-heading text-xl md:text-2xl font-semibold text-plum mb-4">スペック</h2>
          <dl class="cm-card grid sm:grid-cols-2 lg:grid-cols-4 gap-4 p-5 text-sm">
            <div>
              <dt class="text-plum-soft text-xs">メーカー</dt>
              <dd class="mt-0.5 font-medium text-plum">{listing.maker}</dd>
            </div>
            <div>
              <dt class="text-plum-soft text-xs">型番</dt>
              <dd class="mt-0.5 font-medium text-plum">{listing.model}</dd>
            </div>
            <div>
              <dt class="text-plum-soft text-xs">年式</dt>
              <dd class="mt-0.5 font-medium tabular-nums">{listing.manufacture_year ? `${listing.manufacture_year}年` : '—'}</dd>
            </div>
            <div>
              <dt class="text-plum-soft text-xs">状態</dt>
              <dd class="mt-0.5 font-medium">{listing.condition ?? '—'}</dd>
            </div>
            <div class="sm:col-span-2">
              <dt class="text-plum-soft text-xs">カテゴリ</dt>
              <dd class="mt-0.5 font-medium">{listing.categories?.name ?? '—'}</dd>
            </div>
            <div class="sm:col-span-2">
              <dt class="text-plum-soft text-xs">所在地</dt>
              <dd class="mt-0.5 font-medium">{formatLocation(listing.location_prefecture, listing.location_city)}</dd>
            </div>
          </dl>
          {listing.description && (
            <p class="mt-4 text-sm text-plum-soft whitespace-pre-wrap leading-relaxed">{listing.description}</p>
          )}
        </section>

        <section class="mt-12">
          <h2 class="cm-heading text-xl md:text-2xl font-semibold text-plum mb-4">保守・付属品</h2>
          <div class="grid md:grid-cols-2 gap-4">
            <dl class="cm-card p-5 text-sm space-y-4">
              <div>
                <dt class="text-plum-soft text-xs">メーカー保守</dt>
                <dd class="mt-0.5 font-medium">{listing.maker_maintenance ? '加入中' : '未加入・不明'}</dd>
              </div>
              <div>
                <dt class="text-plum-soft text-xs">保守譲渡</dt>
                <dd class="mt-0.5 font-medium">{listing.maintenance_transferable ? '可' : '要確認'}</dd>
              </div>
            </dl>
            <dl class="cm-card p-5 text-sm space-y-4">
              <div>
                <dt class="text-plum-soft text-xs">付属品</dt>
                <dd class="mt-0.5 font-medium">{listing.has_accessories ? 'あり' : 'なし・不明'}</dd>
              </div>
              {listing.accessories_detail && (
                <div>
                  <dt class="text-plum-soft text-xs">付属品詳細</dt>
                  <dd class="mt-0.5 text-plum-soft whitespace-pre-wrap">{listing.accessories_detail}</dd>
                </div>
              )}
            </dl>
          </div>
          <p class="mt-4 text-sm text-plum-soft">
            保守・付属品を含む取引相談は、画面下の「コメントで取引相談する」から匿名で開始できます。
          </p>
        </section>

        <section class="mt-12">
          <h2 class="cm-heading text-xl md:text-2xl font-semibold text-plum mb-4">この先の進め方</h2>
          <ol class="grid sm:grid-cols-2 lg:grid-cols-4 gap-4">
            {[
              { step: '1', title: '関心・相談', body: '関心ありまたは運営への相談からスタート' },
              { step: '2', title: '運営が仲介', body: '条件整理・マッチングを匿名でサポート' },
              { step: '3', title: '双方合意', body: '価格・条件が合えば次のステップへ' },
              { step: '4', title: '連絡先開示・契約', body: '合意後に連絡先を開示し、当事者間で契約' },
            ].map((item) => (
              <li class="cm-card p-4">
                <span class="font-heading text-2xl text-rose/40 font-semibold">{item.step}</span>
                <p class="mt-2 font-heading font-semibold text-plum">{item.title}</p>
                <p class="mt-1 text-xs text-plum-soft leading-relaxed">{item.body}</p>
              </li>
            ))}
          </ol>
        </section>

        <MatchSuggestions title="関連の在庫" matches={matchWanted} />
      </div>
    </section>
    <div class="fixed bottom-16 inset-x-0 z-40 border-t border-line bg-ivory/95 backdrop-blur p-4 lg:static lg:border-0 lg:bg-transparent lg:p-0">
      <div class="max-w-5xl mx-auto flex flex-wrap items-stretch gap-3">
        {profile ? (
          isOwnListing ? (
            <a href="/account/listings" class="btn-market-secondary detail-cta-btn flex-1 sm:flex-none">あなたの出品 — コメントを確認</a>
          ) : (
            <>
              <button id="comment-btn" class="btn-market-primary detail-cta-btn flex-1 sm:flex-none" data-listing-id={listing.id}>コメントで取引相談する</button>
              <button id="interest-btn" class="btn-market-secondary detail-cta-btn flex-1 sm:flex-none" data-listing-id={listing.id}>関心あり</button>
            </>
          )
        ) : (
          <a href={`/auth/login?redirect=${encodeURIComponent(detailPath)}`} class="btn-market-primary detail-cta-btn flex-1 sm:flex-none">ログインしてコメントする</a>
        )}
        <ConsultButton
          label="運営に相談する"
          variant="inline"
          relatedListingId={listing.id}
          class="detail-cta-btn flex-1 sm:flex-none justify-center !px-5 !text-sm !font-semibold shadow-sm"
        />
      </div>
      <p id="interest-status" class="max-w-5xl mx-auto mt-2 text-sm text-plum-soft hidden"></p>
      <p id="comment-status" class="max-w-5xl mx-auto mt-1 text-sm text-plum-soft hidden"></p>
    </div>
    <script>
      document.getElementById('comment-btn')?.addEventListener('click', async (e) => {
        const btn = e.currentTarget as HTMLButtonElement;
        const commentStatus = document.getElementById('comment-status');
        const message = window.prompt('この出品へのコメント（取引相談）を入力してください。匿名で運営が仲介します。');
        if (!message?.trim() || !commentStatus) return;
        commentStatus.textContent = '送信中…';
        commentStatus.classList.remove('hidden');
        const res = await fetch('/api/threads', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ listing_id: btn.dataset.listingId, message: message.trim() }),
        });
        const json = await res.json();
        if (res.ok) {
          window.location.href = `/account/threads/${json.thread_id}`;
        } else {
          commentStatus.textContent = json.error ?? '送信に失敗しました';
        }
      });
      document.getElementById('interest-btn')?.addEventListener('click', async (e) => {
        const btn = e.currentTarget as HTMLButtonElement;
        const status = document.getElementById('interest-status');
        if (!status) return;
        status.textContent = '送信中…';
        status.classList.remove('hidden');
        const res = await fetch('/api/approaches', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ kind: 'interest', listing_id: btn.dataset.listingId, message: '関心があります。' }),
        });
        const json = await res.json();
        status.textContent = res.ok ? '関心リクエストを送信しました。' : (json.error ?? '送信に失敗しました');
      });
    </script>
    <style>
      .detail-cta-btn {
        @apply min-h-[46px] !py-3;
      }

      .btn-market-primary {
        @apply inline-flex items-center justify-center rounded-full bg-rose px-5 py-2.5 text-sm font-semibold text-white shadow-sm hover:bg-rose-deep transition;
      }
      .btn-market-secondary {
        @apply inline-flex items-center justify-center rounded-full border border-rose text-rose px-5 py-2.5 text-sm font-semibold hover:bg-cream transition;
      }
    </style>
  </Layout>
)}

{mode === 'static' && staticData && StaticContent && (
  <Layout metadata={metadata}>
    <div class="border-b border-line bg-ivory">
      <div class="max-w-3xl mx-auto px-4 py-3">
        <Breadcrumb
          class="text-xs"
          items={[
            { name: 'トップ', url: getHomePermalink() },
            { name: '在庫・取引事例', url: getPermalink('cases') },
            { name: staticData.title },
          ]}
        />
      </div>
    </div>
    <section class="bg-blush">
      <div class="max-w-content mx-auto px-4 sm:px-6 py-10 md:py-14">
        <div class="flex flex-wrap items-center gap-2 mb-4">
          <span class="cm-tag-done">成約事例</span>
          {staticData.category === 'others' ? (
            <span class="cm-tag-sage">{staticData.categoryLabel}</span>
          ) : (
            <a href={getPermalink(`categories/${staticData.category}`)} class="cm-tag-sage hover:opacity-80 transition">
              {staticData.categoryLabel}
            </a>
          )}
        </div>
        <h1 class="cm-heading text-[26px] md:text-[34px] font-semibold text-plum leading-snug">{staticData.title}</h1>
        <p class="mt-2 text-plum-soft">{staticData.manufacturer}　/　{staticData.model}</p>
        <dl class="mt-7 flex flex-wrap gap-x-10 gap-y-4">
          <div>
            <dt class="text-xs text-muted tracking-wide">製造</dt>
            <dd class="cm-heading text-lg text-plum tabular-nums">{formatDateYMD(staticData.manufacturedDate)}</dd>
          </div>
          <div>
            <dt class="text-xs text-muted tracking-wide">取引時期</dt>
            <dd class="cm-heading text-lg text-plum tabular-nums">{formatDateYMD(staticData.transactionDate)}</dd>
          </div>
          <div>
            <dt class="text-xs text-muted tracking-wide">価格帯</dt>
            <dd class="cm-heading text-lg text-rose">{staticData.priceRange}</dd>
          </div>
        </dl>
      </div>
    </section>

    <section class="py-12 md:py-16 bg-cream">
      <div class="max-w-3xl mx-auto px-4 sm:px-6">
        <h2 class="cm-heading text-xl font-semibold text-plum mb-4">機器の概要</h2>
        <dl class="cm-card grid grid-cols-2 sm:grid-cols-3 gap-4 p-5 text-sm">
          {staticSpecItems.map(({ label, value }) => (
            <div>
              <dt class="text-muted text-xs">{label}</dt>
              <dd class="mt-0.5 font-medium text-plum">{value}</dd>
            </div>
          ))}
        </dl>

        <section class="cases-prose mt-10 mb-12">
          <StaticContent />
        </section>

        {relatedCases.length > 0 && (
          <section class="border-t border-line pt-10">
            <h2 class="cm-heading text-xl font-semibold text-plum mb-4">関連の取引事例</h2>
            <ul class="grid sm:grid-cols-3 gap-4">
              {relatedCases.map((rc) => (
                <li>
                  <a href={getPermalink(`cases/${rc.slug}`)} class="cm-card block p-4 hover:shadow-lift transition h-full">
                    <span class="cm-tag-done text-[10px]">{rc.status}</span>
                    <p class="mt-2 cm-heading font-semibold text-plum text-sm leading-snug">{rc.manufacturer} {rc.model}</p>
                    <p class="mt-1 text-xs text-muted">{rc.categoryLabel}</p>
                  </a>
                </li>
              ))}
            </ul>
          </section>
        )}
      </div>
    </section>
    <section class="py-12 bg-ivory border-t border-line">
      <div class="max-w-3xl mx-auto px-4">
        <h2 class="font-heading text-xl font-bold text-plum mb-3">この機器の購入・売却をご検討の方</h2>
        <p class="text-plum-soft mb-6 text-sm">写真・型番だけでも相談OK。匿名でもご利用いただけます。</p>
        <div class="flex flex-wrap gap-3">
          <Button href={getPermalink('contact/sell')} variant="primary">売却を相談する</Button>
          <Button href={getPermalink('contact/buy')} variant="secondary">購入を相談する</Button>
          <ConsultButton variant="inline" />
        </div>
      </div>
    </section>
    {productJsonLd && <script type="application/ld+json" set:html={JSON.stringify(productJsonLd)} />}
    <style is:global>
      .cases-prose {
        @apply prose lg:prose-lg max-w-none prose-headings:font-heading prose-p:text-plum-soft prose-p:leading-relaxed;
      }
      .cases-prose h2 {
        @apply mt-12 pl-4 border-l-4 border-rose text-xl text-plum;
      }
      .cases-prose strong {
        @apply text-rose;
      }
    </style>
  </Layout>
)}
