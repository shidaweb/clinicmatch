---
import { getCollection } from 'astro:content';
import Layout from '~/layouts/PageLayout.astro';
import WidgetWrapper from '~/components/ui/WidgetWrapper.astro';
import { getPermalink, getHomePermalink } from '~/utils/permalinks';

export const prerender = true;

const categories = await getCollection('categories');
const sorted = categories.sort((a, b) => a.data.title.localeCompare(b.data.title, 'ja'));

const metadata = {
  title: '取扱機器カテゴリ',
  description:
    '美容医療機器の取扱カテゴリ一覧。脱毛機・ピコレーザー・IPL・HIFU・RF・痩身機器など、中古売買の対象機種と確認ポイントをご案内します。',
};
---

<Layout metadata={metadata}>
  <WidgetWrapper containerClass="max-w-5xl mx-auto" bg='<div class="absolute inset-0 bg-cream"></div>'>
    <header class="mb-8 md:mb-12 text-center">
      <p class="cm-eyebrow mb-2">Categories</p>
      <h1 class="cm-heading text-4xl md:text-5xl font-bold">取扱機器カテゴリ</h1>
      <p class="mt-3 text-xl text-plum-soft max-w-2xl mx-auto leading-relaxed">
        中古売買の対象となる機器カテゴリと、主な機種・購入時の確認ポイントをご紹介します。
      </p>
    </header>

    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {sorted.map((entry) => {
        const { data } = entry;
        const slug = entry.id.replace(/\.mdx?$/, '');
        const href = getPermalink(`categories/${slug}`);
        const machineNames = data.machines.map((m) => m.name).join('、');
        return (
          <a href={href} class="cm-card block p-5 hover:shadow-lg transition group">
            <span
              class="inline-block px-2.5 py-0.5 text-xs font-semibold rounded-full text-white"
              style={{ backgroundColor: data.accentColor }}
            >
              {data.title}
            </span>
            <h2 class="mt-2 text-lg font-heading font-bold text-plum group-hover:text-rose">{data.title}の中古売買</h2>
            <p class="mt-2 text-sm text-plum-soft line-clamp-2">{data.description}</p>
            <p class="mt-3 text-sm text-plum-soft">
              <span class="font-medium text-plum">主な機種:</span> {machineNames}
            </p>
            <p class="mt-2 text-sm text-rose font-medium">詳細を見る →</p>
          </a>
        );
      })}
    </div>
  </WidgetWrapper>
</Layout>
