---
export const prerender = true;

import Layout from '~/layouts/PageLayout.astro';
import Image from '~/components/common/Image.astro';
import { Icon } from 'astro-icon/components';
import TrustBadges from '~/components/TrustBadges.astro';
import NewArrivals from '~/components/NewArrivals.astro';
import MembershipBenefits from '~/components/MembershipBenefits.astro';
import BlogLatestPosts from '~/components/widgets/BlogLatestPosts.astro';
import FAQs from '~/components/widgets/FAQs.astro';
import FAQPageJsonLd from '~/components/seo/FAQPageJsonLd.astro';
import { homeFaqs } from '~/data/homeFaq';
import { getPermalink } from '~/utils/permalinks';
import { PREFECTURES } from '~/lib/marketplace';

const metadata = {
  title: 'クリニックマッチ｜美容医療機器の中古売買マーケット',
  ignoreTitleTemplate: true,
};

const categories = [
  { slug: 'hair-removal', label: '脱毛', href: '/categories/hair-removal' },
  { slug: 'pico-laser', label: 'ピコレーザー', href: '/categories/pico-laser' },
  { slug: 'ipl', label: 'IPL', href: '/categories/ipl' },
  { slug: 'hifu', label: 'HIFU', href: '/categories/hifu' },
  { slug: 'rf', label: 'RF', href: '/categories/rf' },
  { slug: 'body', label: '痩身', href: '/categories/body' },
  { slug: 'consumables', label: '消耗品（チップ・カートリッジ等）', href: '/cases?view=active&listingKind=consumable' },
];
const searchCategories = categories.filter((item) => item.slug !== 'consumables');

const flowSteps = [
  { num: '01', title: '相談・登録', desc: '匿名OK。分かる範囲で入力' },
  { num: '02', title: '条件整理', desc: '運営が仲介して論点を揃える' },
  { num: '03', title: 'マッチング', desc: '合意後に連絡先を開示' },
];

const totalDeals = 38;
const avgMatchDays = 14;
---

<Layout metadata={metadata}>
  <section class="bg-cream pt-12 md:pt-16 pb-4">
    <div class="max-w-content mx-auto px-4 sm:px-6">
      <div class="grid md:grid-cols-2 gap-10 md:gap-14 items-center">
        <div>
          <h1 class="cm-heading text-[26px] md:text-[32px] font-semibold">
            美容医療機器の、次の場所を見つける
          </h1>
          <p class="mt-4 text-plum-soft leading-[1.8] text-[15px] md:text-base">
            匿名で探せて、運営が仲介。中古の脱毛機・ピコ・HIFU・RF・痩身機器から、チップ・カートリッジなどの消耗品まで。連絡先は合意後に開示されます。
          </p>
          <div class="mt-8 flex flex-wrap gap-3">
            <a href="/cases?view=active&type=listing" class="cm-btn-primary">機器をさがす</a>
            <a href={getPermalink('contact')} class="cm-btn-secondary">出品・購入を相談する</a>
          </div>
          <div class="cm-stat-band mt-10 justify-start">
            <div>
              <p class="cm-stat-value">{totalDeals}</p>
              <p class="cm-stat-label">累計成約</p>
            </div>
            <div>
              <p class="cm-stat-value">{avgMatchDays}<span class="text-lg">日</span></p>
              <p class="cm-stat-label">平均マッチング</p>
            </div>
            <div>
              <p class="cm-stat-value">100<span class="text-lg">%</span></p>
              <p class="cm-stat-label">運営仲介</p>
            </div>
          </div>
        </div>

        <div class="relative">
          <div class="rounded-card border border-line bg-ivory p-4 shadow-soft">
            <div class="rounded-card overflow-hidden relative" style="box-shadow: inset 0 0 0 16px transparent; padding: 16px;">
              <div class="rounded-card overflow-hidden relative border border-white/60">
                <Image
                  src="~/assets/images/about-hero.png"
                  alt="美容医療機器の売買相談"
                  class="w-full h-auto object-cover"
                  width={540}
                  height={360}
                  loading="eager"
                />
              </div>
            </div>
          </div>
          <a
            href="/cases?view=active&type=listing"
            class="absolute -bottom-3 -left-2 sm:-left-6 rounded-card border border-line bg-ivory p-4 shadow-float max-w-[190px] hidden sm:block hover:-translate-y-1 transition-transform"
          >
            <p class="cm-kicker mb-2">新着</p>
            <p class="font-heading text-sm font-semibold text-plum leading-snug">在庫を随時更新</p>
            <p class="text-xs text-rose mt-2">一覧へ →</p>
          </a>
        </div>
      </div>

      <form action="/cases" method="get" class="cm-search-float mt-8 max-w-4xl mx-auto">
        <input type="hidden" name="view" value="active" />
        <input type="hidden" name="type" value="listing" />
        <input type="hidden" name="listingKind" id="hero-listing-kind" value="" />
        <div class="mb-3 inline-flex rounded-pill border border-line bg-ivory p-1">
          <button type="button" data-hero-kind="" class="hero-kind-btn rounded-pill px-4 py-1.5 text-xs font-medium bg-rose text-white">すべて</button>
          <button type="button" data-hero-kind="device" class="hero-kind-btn rounded-pill px-4 py-1.5 text-xs font-medium text-plum-soft">機器本体</button>
          <button type="button" data-hero-kind="consumable" class="hero-kind-btn rounded-pill px-4 py-1.5 text-xs font-medium text-plum-soft">消耗品</button>
        </div>
        <div class="flex flex-col sm:flex-row gap-2">
          <select name="category" class="rounded-pill border border-line px-4 py-2.5 text-sm bg-ivory sm:w-36">
            <option value="">カテゴリ</option>
            {searchCategories.map(({ slug, label }) => (
              <option value={slug}>{label}</option>
            ))}
          </select>
          <input
            type="search"
            name="q"
            placeholder="メーカー・型番"
            class="flex-1 rounded-pill border border-line px-4 py-2.5 text-sm bg-ivory min-w-0"
          />
          <select name="prefecture" class="rounded-pill border border-line px-4 py-2.5 text-sm bg-ivory sm:w-32">
            <option value="">エリア</option>
            {PREFECTURES.map((pref) => (
              <option value={pref}>{pref}</option>
            ))}
          </select>
          <button type="submit" class="cm-btn-dark px-8 shrink-0">検索</button>
        </div>
      </form>
    </div>
  </section>

  <MembershipBenefits totalDeals={totalDeals} avgMatchDays={avgMatchDays} />

  <section class="py-12 md:py-16 bg-ivory border-y border-line">
    <div class="max-w-content mx-auto px-4 sm:px-6">
      <p class="cm-kicker-center mb-2">新着</p>
      <h2 class="cm-heading text-xl md:text-2xl font-semibold text-plum mb-6">新着の在庫</h2>
      <NewArrivals />
    </div>
  </section>

  <section class="py-12 md:py-16 bg-cream">
    <div class="max-w-content mx-auto px-4 sm:px-6">
      <p class="cm-kicker-center mb-2">ご利用の流れ</p>
      <h2 class="cm-heading text-xl md:text-2xl font-semibold text-plum mb-8">取引の進め方</h2>
      <div class="grid md:grid-cols-3 gap-10">
        {flowSteps.map(({ num, title, desc }) => (
          <div>
            <p class="font-heading text-3xl text-gold tabular-nums">{num}</p>
            <h3 class="mt-2 font-heading text-lg font-semibold text-plum">{title}</h3>
            <p class="mt-2 text-sm text-plum-soft leading-relaxed">{desc}</p>
          </div>
        ))}
      </div>
      <div class="mt-10">
        <TrustBadges />
      </div>
    </div>
  </section>

  <section class="py-12 md:py-16 bg-blush border-y border-line">
    <div class="max-w-content mx-auto px-4 sm:px-6">
      <h2 class="cm-heading text-xl md:text-2xl font-semibold text-plum mb-6">カテゴリから探す</h2>
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4">
        {categories.map(({ label, href }) => (
          <a href={href} class="cm-card-interactive flex items-center justify-between p-5 group">
            <span class="font-heading font-semibold text-plum group-hover:text-rose-deep">{label}</span>
            <span class="text-sm text-rose">→</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <BlogLatestPosts
    title="読み物"
    information="中古美容医療機器の見極め・注意点・相場感を、実務目線で整理します。"
  />

  <FAQPageJsonLd faqs={[...homeFaqs]} />
  <FAQs
    id="faq"
    title="よくある質問"
    subtitle="検討の初期段階で気になりやすい点をまとめました。"
    bg='<div class="absolute inset-0 bg-ivory"></div>'
    items={homeFaqs.map((faq) => ({ title: faq.q, description: faq.a }))}
  />

</Layout>

<script>
  const kindInput = document.getElementById('hero-listing-kind') as HTMLInputElement | null;
  const buttons = Array.from(document.querySelectorAll('.hero-kind-btn')) as HTMLButtonElement[];
  const updateKind = (kind: string) => {
    if (kindInput) kindInput.value = kind;
    buttons.forEach((button) => {
      const selected = button.dataset.heroKind === kind;
      button.classList.toggle('bg-rose', selected);
      button.classList.toggle('text-white', selected);
      button.classList.toggle('text-plum-soft', !selected);
    });
  };
  buttons.forEach((button) => {
    button.addEventListener('click', () => updateKind(button.dataset.heroKind ?? ''));
  });
</script>
