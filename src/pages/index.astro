---
export const prerender = true;

import Layout from '~/layouts/PageLayout.astro';
import { Icon } from 'astro-icon/components';
import ConsultButton from '~/components/ConsultButton.astro';
import TrustBadges from '~/components/TrustBadges.astro';
import NewArrivals from '~/components/NewArrivals.astro';
import Features from '~/components/widgets/Features.astro';
import Features2 from '~/components/widgets/Features2.astro';
import Steps from '~/components/widgets/Steps.astro';
import Content from '~/components/widgets/Content.astro';
import BlogLatestPosts from '~/components/widgets/BlogLatestPosts.astro';
import FAQs from '~/components/widgets/FAQs.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';
import FAQPageJsonLd from '~/components/seo/FAQPageJsonLd.astro';
import { homeFaqs } from '~/data/homeFaq';
import { getPermalink } from '~/utils/permalinks';

const metadata = {
  title: 'クリニックマッチ｜美容医療機器の売買を もっと 安心・透明に',
  ignoreTitleTemplate: true,
};

const categories = [
  { slug: 'hair-removal', label: '脱毛', icon: 'tabler:scissors' },
  { slug: 'pico-laser', label: 'ピコ', icon: 'tabler:focus-2' },
  { slug: 'ipl', label: 'IPL', icon: 'tabler:sun' },
  { slug: 'hifu', label: 'HIFU', icon: 'tabler:wave-saw-tool' },
  { slug: 'rf', label: 'RF', icon: 'tabler:radio' },
  { slug: 'body', label: '痩身', icon: 'tabler:user-circle' },
];
---

<Layout metadata={metadata}>
  <section class="py-16 md:py-20 bg-surface-muted">
    <div class="max-w-7xl mx-auto px-4 sm:px-6">
      <div class="text-center max-w-3xl mx-auto">
        <h1 class="text-4xl md:text-5xl font-bold text-text leading-tight">
          美容医療機器の<br class="sm:hidden" />売りたい・買いたいをつなぐ
        </h1>
        <p class="mt-4 text-lg text-text-muted leading-relaxed">
          匿名で探せて、運営が仲介。中古の脱毛機・ピコ・HIFU・RF・痩身機器のマッチングプラットフォーム。
        </p>
        <div class="mt-6 flex justify-center">
          <TrustBadges compact />
        </div>
      </div>

      <div class="mt-10 grid sm:grid-cols-3 gap-4 max-w-4xl mx-auto">
        <a href="/cases?view=active" class="rounded-xl border border-border bg-surface p-6 text-center shadow-sm hover:shadow-md transition group">
          <Icon name="tabler:search" class="w-8 h-8 mx-auto text-brand-600" />
          <p class="mt-3 font-semibold text-text group-hover:text-brand-600">在庫をさがす</p>
          <p class="mt-1 text-xs text-text-muted">募集中の売りたい・買いたい</p>
        </a>
        <a href={getPermalink('contact')} class="rounded-xl border border-border bg-surface p-6 text-center shadow-sm hover:shadow-md transition group">
          <Icon name="tabler:tag" class="w-8 h-8 mx-auto text-sell" />
          <p class="mt-3 font-semibold text-text">売りたい・買いたいを出す</p>
          <p class="mt-1 text-xs text-text-muted">会員登録または相談フォーム</p>
        </a>
        <a href={getPermalink('contact')} class="rounded-xl border-2 border-brand-600 bg-brand-600 p-6 text-center shadow-sm hover:opacity-95 transition text-white">
          <Icon name="tabler:message-circle" class="w-8 h-8 mx-auto" />
          <p class="mt-3 font-semibold">出品・購入を相談する</p>
          <p class="mt-1 text-xs text-white/80">匿名OK・約2分</p>
        </a>
      </div>

      <form action="/cases" method="get" class="mt-10 max-w-2xl mx-auto">
        <input type="hidden" name="view" value="active" />
        <div class="flex flex-col sm:flex-row gap-2">
          <select name="category" class="rounded-xl border border-border px-4 py-3 text-sm bg-surface sm:w-40">
            <option value="">すべてのカテゴリ</option>
            {categories.map(({ slug, label }) => (
              <option value={slug}>{label}</option>
            ))}
          </select>
          <input
            type="search"
            name="q"
            placeholder="メーカー・型番で検索"
            class="flex-1 rounded-xl border border-border px-4 py-3 text-sm bg-surface"
          />
          <button type="submit" class="rounded-xl bg-brand-600 px-6 py-3 text-sm font-semibold text-white hover:opacity-90">さがす</button>
        </div>
      </form>

      <NewArrivals />

      <div class="mt-10 flex flex-wrap justify-center gap-2">
        {categories.map(({ slug, label, icon }) => (
          <a
            href={`/cases?view=active&category=${slug}`}
            class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full text-sm font-medium bg-surface border border-border text-text hover:border-brand-600 hover:text-brand-600 transition"
          >
            <Icon name={icon} class="w-4 h-4 shrink-0" />
            {label}
          </a>
        ))}
      </div>
    </div>
  </section>

  <Features
    id="features"
    tagline="強み"
    title="クリニックマッチでできること"
    subtitle="「相場が分かりにくい」「比較が大変」な中古機器取引を、分かりやすく整流化します。"
    items={[
      { title: '条件整理と要件定義', description: 'メーカー/型番/年式/状態/付属品/希望価格など、取引の前提を揃えます。', icon: 'tabler:clipboard-check' },
      { title: '候補提示と比較検討', description: '目的・予算・運用に合わせて候補を整理し、比較しやすい形で提示します。', icon: 'tabler:arrows-exchange' },
      { title: 'スピード感あるマッチング', description: '在庫情報を必要条件に沿って素早く絞り込み、意思決定を前に進めます。', icon: 'tabler:bolt' },
      { title: '取引実務の段取り', description: '検品・搬出入・保守/修理の論点を整理してスムーズな実行を支援します。', icon: 'tabler:truck-delivery' },
      { title: '情報管理と守秘', description: '検討段階の情報が拡散しないよう配慮し、必要な範囲で取り扱います。', icon: 'tabler:lock' },
      { title: '市場理解の発信（ブログ）', description: '中古機器の見極め、注意点、相場感を記事として整理します。', icon: 'tabler:book' },
    ]}
  />

  <Content
    id="torihiki"
    isReversed
    tagline="取引の考え方"
    title="意思決定を早め<br />リスクを減らす"
    items={[
      { title: '論点を先に揃える', description: '価格だけでなく、状態・保証・搬入条件など後から揉めやすい論点を先に揃えます。' },
      { title: '比較できる形に整える', description: '候補ごとに見比べやすい整理を行い、意思決定を前に進めます。' },
      { title: '段取りで事故を減らす', description: '検品/引渡し/設置などの実務を先回りして整理します。' },
    ]}
    image={{ src: '~/assets/images/torihiki-joken.png', alt: '取引条件が明確だと、判断が速い' }}
  >
    <Fragment slot="content">
      <h3 class="text-2xl font-bold tracking-tight mb-2">取引条件が明確だと、判断が速い</h3>
      クリニックの運用を止めずに、必要な機器を適切に調達・入替できる状態を目指します。
    </Fragment>
  </Content>

  <Steps
    id="flow"
    title="取引の進め方"
    items={[
      { title: 'Step 1: <span class="font-medium">相談・登録</span>', description: 'フォームまたは会員登録で、分かる範囲の情報を入力（匿名OK）。', icon: 'tabler:forms' },
      { title: 'Step 2: <span class="font-medium">条件整理</span>', description: '運営が仲介し、候補提示や売却条件の整備に向けて論点を揃えます。', icon: 'tabler:filter' },
      { title: 'Step 3: <span class="font-medium">マッチング</span>', description: '候補の比較・条件調整を進め、段取りを整理します。', icon: 'tabler:truck' },
      { title: '完了: <span class="font-medium">取引成立</span>', icon: 'tabler:check' },
    ]}
    image={{ src: '~/assets/images/torihiki-nagare.png', alt: '取引の流れ' }}
  />

  <Features2
    id="sodanrei"
    title="よくある相談テーマ"
    subtitle="まずはこの辺りの整理から入ると、判断が早くなります。"
    tagline="相談例"
    items={[
      { title: '価格の相場感', description: '同型番でも状態や付属品で価格が大きく変わります。', icon: 'tabler:exchange' },
      { title: '状態・リスクの見極め', description: '点検履歴、消耗部品、修理可否などの論点を整理します。', icon: 'tabler:clipboard-check' },
      { title: '搬出入・設置', description: 'サイズ/重量/搬入経路など、現場で詰まりやすい点を先に確認します。', icon: 'tabler:truck-delivery' },
      { title: '保証・保守', description: 'メーカー保守、第三者保守など前提を揃えます。', icon: 'tabler:headset' },
    ]}
  />

  <BlogLatestPosts
    title="ブログ：美容医療の中古市場を整備する人"
    information="中古美容医療機器の「見極め」「注意点」「相場感」を、実務目線で整理します。"
  />

  <FAQPageJsonLd faqs={[...homeFaqs]} />
  <FAQs
    id="faq"
    title="よくある質問"
    subtitle="検討の初期段階で気になりやすい点をまとめました。"
    tagline="FAQ"
    items={homeFaqs.map((faq) => ({ title: faq.q, description: faq.a }))}
  />

  <CallToAction
    actions={[
      { variant: 'primary', text: '在庫をさがす', href: '/cases?view=active' },
      { variant: 'secondary', text: '出品・購入を相談する', href: getPermalink('contact') },
    ]}
  >
    <Fragment slot="title">写真・型番だけでも相談OK</Fragment>
    <Fragment slot="subtitle">匿名相談からでも始められます。まずはお気軽にご連絡ください。</Fragment>
  </CallToAction>
</Layout>
