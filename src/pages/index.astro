---
export const prerender = true;

import { getCollection } from 'astro:content';
import Layout from '~/layouts/PageLayout.astro';
import MembershipBenefits from '~/components/MembershipBenefits.astro';
import { formatTransactionMonth } from '~/lib/home-page';
import MarketNow from '~/components/MarketNow.astro';
import BlogLatestPosts from '~/components/widgets/BlogLatestPosts.astro';
import HomeFaqs from '~/components/HomeFaqs.astro';
import FAQPageJsonLd from '~/components/seo/FAQPageJsonLd.astro';
import { homeFaqs } from '~/data/homeFaq';
import { getPermalink } from '~/utils/permalinks';
import { PREFECTURES } from '~/lib/marketplace';
import { countDoneCasesWithPrice, selectRecentDoneCases } from '~/lib/home-page';
import { MARKET_CATEGORIES } from '~/lib/categories';

const metadata = {
  title: 'クリニックマッチ｜美容医療機器の中古売買マーケット',
  ignoreTitleTemplate: true,
};

const allCases = await getCollection('cases');
const recentDoneCases = selectRecentDoneCases(allCases, 3);
const doneCaseCount = countDoneCasesWithPrice(allCases);

const categories: { slug: string; label: string; href: string; isNew?: boolean }[] = [
  ...MARKET_CATEGORIES.map((c) => ({
    slug: c.slug,
    label: c.shortLabel,
    href: `/categories/${c.slug}`,
  })),
  {
    slug: 'consumables',
    label: '消耗品（チップ・カートリッジ等）',
    href: '/cases?view=active&listingKind=consumable',
    isNew: true,
  },
];
const searchCategories = categories.filter((item) => item.slug !== 'consumables');

const flowSteps = [
  {
    num: '1',
    title: '機器や希望条件を登録',
    desc: '売りたい機器、または探している機種・予算をお知らせください。相談から始めることもできます。',
  },
  { num: '2', title: '運営と条件を確認', desc: '価格、保守、付属品、引き渡し時期などを、運営が双方に確認します。' },
  { num: '3', title: '合意後に契約へ', desc: '双方の合意を確認して連絡先を開示し、契約の手続きを進めます。' },
];
---

<Layout metadata={metadata}>
  <div class="customer-home">
    <section class="home-intro">
      <div class="max-w-content mx-auto px-4 sm:px-6">
        <div class="home-intro-grid">
          <div class="home-intro-copy">
            <p class="home-service">美容医療機器の中古売買 · クリニックマッチ</p>
            <h1 class="cm-heading home-title"><span>導入したい一台も、</span><span>手放したい一台も。</span></h1>
            <p class="home-description">
              機器の買い替え、新規導入、使わなくなった機器の売却。<br
                class="hidden sm:block"
              />売り手と買い手の間に入り、運営が取引を仲介します。
            </p>
            <a href={getPermalink('contact/sell')} class="home-sell-link"
              >機器の売却を相談する <span aria-hidden="true">↗</span></a
            >
            <p class="home-privacy">組織名・連絡先は非公開。双方の合意後に開示します。</p>
          </div>
          <form action="/cases" method="get" class="home-search" aria-labelledby="home-search-heading">
            <h2 id="home-search-heading">条件から機器を探す</h2>
            <p class="home-search-description">メーカー・機種名やエリアで絞り込めます。</p>
            <input type="hidden" name="view" value="active" />
            <input type="hidden" name="type" value="listing" />
            <input type="hidden" name="listingKind" id="hero-listing-kind" value="" />
            <div class="home-search-kinds" role="group" aria-label="検索する出品種別">
              <button
                type="button"
                data-hero-kind=""
                class="hero-kind-btn rounded-pill px-4 py-1.5 text-xs font-medium bg-rose text-white"
                aria-pressed="true">すべて</button
              >
              <button
                type="button"
                data-hero-kind="device"
                class="hero-kind-btn rounded-pill px-4 py-1.5 text-xs font-medium text-plum-soft"
                aria-pressed="false">機器本体</button
              >
              <button
                type="button"
                data-hero-kind="consumable"
                class="hero-kind-btn rounded-pill px-4 py-1.5 text-xs font-medium text-plum-soft"
                aria-pressed="false">消耗品</button
              >
            </div>
            <div class="home-search-fields">
              <label class="home-search-query"
                ><span>メーカー・機種名</span><input
                  type="search"
                  name="q"
                  placeholder="例：POTENZA、キャンデラ"
                  class="cm-input"
                /></label
              >
              <label
                ><span>カテゴリ</span><select name="category" class="w-full min-w-0"
                  ><option value="">すべて</option>{
                    searchCategories.map(({ slug, label }) => <option value={slug}>{label}</option>)
                  }</select
                ></label
              >
              <label
                ><span>エリア</span><select name="prefecture" class="w-full min-w-0"
                  ><option value="">全国</option>{
                    PREFECTURES.map((pref) => <option value={pref}>{pref}</option>)
                  }</select
                ></label
              >
              <button type="submit" class="cm-btn-dark home-search-submit"
                >販売中の機器を探す <span aria-hidden="true">→</span></button
              >
              <a class="home-search-all" href="/cases?view=active&type=listing">条件を指定せず一覧を見る</a>
            </div>
          </form>
        </div>
      </div>
    </section>

    <section class="home-deals" aria-labelledby="home-deals-heading">
      <div class="max-w-content mx-auto px-4 sm:px-6">
        <header>
          <div>
            <h2 id="home-deals-heading" class="cm-heading">成約した機器と価格帯</h2><p>
              実際の取引事例を、機器選びや売却時の参考に。
            </p>
          </div><a href="/cases?view=done">成約事例を見る <span aria-hidden="true">→</span></a>
        </header>
        <ul>
          {
            recentDoneCases.map((item) => (
              <li>
                <a href={`/cases/${item.slug}`}>
                  <>
                    <span class="home-deal-category">{item.categoryLabel}</span>
                    <span class="home-deal-machine">
                      <>
                        <strong>{item.model}</strong>
                        <span>{item.manufacturer}</span>
                      </>
                    </span>
                    <span class="home-deal-price">{item.priceRange}</span>
                    <span class="home-deal-date">{formatTransactionMonth(item.transactionDate)}</span>
                    <span class="home-deal-arrow" aria-hidden="true">
                      ↗
                    </span>
                  </>
                </a>
              </li>
            ))
          }
        </ul>
        <p class="home-deals-note">
          価格帯は守秘のため幅で表示しています。{doneCaseCount > 0 && `成約事例を${doneCaseCount}件掲載しています。`}
        </p>
      </div>
    </section>

    <MarketNow recentDoneCases={recentDoneCases} />

    <MembershipBenefits />

    <section class="py-[52px] md:py-[72px] bg-cream">
      <div class="max-w-content mx-auto px-4 sm:px-6">
        <h2 class="cm-heading text-xl md:text-2xl font-semibold text-plum mb-8">取引の進め方</h2>
        <ol class="home-flow">
          {
            flowSteps.map(({ num, title, desc }) => (
              <li>
                <p class="home-step">{num}</p>
                <h3 class="mt-2 font-heading text-lg font-semibold text-plum">{title}</h3>
                <p class="mt-2 text-sm text-plum-soft leading-relaxed">{desc}</p>
              </li>
            ))
          }
        </ol>
      </div>
    </section>

    <section class="py-[52px] md:py-[72px] bg-blush border-y border-line">
      <div class="max-w-content mx-auto px-4 sm:px-6">
        <h2 class="cm-heading text-xl md:text-2xl font-semibold text-plum mb-6">カテゴリから探す</h2>
        <div class="home-categories">
          {
            categories.map(({ label, href }) => (
              <a href={href} class="home-category group">
                <span class="font-heading font-semibold text-plum group-hover:text-rose-deep">{label}</span>
                <span class="text-sm text-rose">→</span>
              </a>
            ))
          }
        </div>
      </div>
    </section>

    <BlogLatestPosts
      animate={false}
      title="読み物"
      information="中古美容医療機器の見極め・注意点・相場感を、実務目線で整理します。"
    />

    <FAQPageJsonLd faqs={[...homeFaqs]} />
    <HomeFaqs items={[...homeFaqs]} />
  </div>
</Layout>

<style>
  .home-intro {
    background: var(--cream);
    padding: 56px 0 64px;
  }
  .home-intro-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr);
    gap: 48px;
    align-items: center;
  }
  .home-service {
    font-size: 13px;
    color: var(--plum-soft);
    margin-bottom: 24px;
  }
  .home-title {
    font-size: clamp(30px, 3.5vw, 44px);
    font-weight: 500;
    line-height: 1.65;
    letter-spacing: 0.025em;
  }
  .home-title span {
    display: block;
  }
  .home-description {
    margin-top: 24px;
    font-size: 15px;
    line-height: 2;
    color: var(--plum-soft);
  }
  .home-sell-link {
    display: inline-flex;
    gap: 32px;
    align-items: center;
    border-bottom: 1px solid var(--rose-deep);
    padding: 12px 0;
    margin-top: 24px;
    font-size: 16px;
    font-weight: 600;
    color: var(--plum);
  }
  .home-sell-link:hover {
    color: var(--rose-deep);
  }
  .home-privacy {
    margin-top: 20px;
    font-size: 12px;
    line-height: 1.8;
    color: var(--plum-soft);
  }
  .home-search {
    background: var(--ivory);
    border: 1px solid var(--line);
    padding: 28px;
    border-radius: 8px;
    min-width: 0;
  }
  .home-search h2 {
    font-size: 19px;
    font-weight: 600;
  }
  .home-search-description {
    font-size: 13px;
    color: var(--plum-soft);
    margin: 8px 0 20px;
  }
  .home-search-kinds {
    display: flex;
    gap: 4px;
    border-bottom: 1px solid var(--line);
    padding-bottom: 16px;
    margin-bottom: 20px;
  }
  .home-search-kinds button {
    border-radius: 4px;
    font-size: 13px;
    min-height: 40px;
    flex: 1;
    padding: 8px;
  }
  .home-search-fields {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 16px 12px;
  }
  .home-search-fields label {
    min-width: 0;
  }
  .home-search-fields label > span {
    display: block;
    font-size: 12px;
    margin-bottom: 8px;
  }
  .home-search-fields select {
    font-size: 14px;
    padding-left: 12px;
  }
  .home-search-query,
  .home-search-submit,
  .home-search-all {
    grid-column: 1 / -1;
  }
  .home-search-submit {
    display: flex;
    justify-content: space-between;
    padding: 14px 20px;
    margin-top: 4px;
  }
  .home-search-all {
    text-align: center;
    font-size: 12px;
    text-decoration: underline;
    text-underline-offset: 4px;
    color: var(--plum-soft);
  }
  .home-deals {
    padding: 52px 0 56px;
    background: var(--ivory);
    border-top: 1px solid var(--line);
  }
  .home-deals header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    margin-bottom: 28px;
  }
  .home-deals h2 {
    font-size: 24px;
    font-weight: 500;
  }
  .home-deals header p {
    font-size: 14px;
    color: var(--plum-soft);
    margin-top: 10px;
  }
  .home-deals header > a {
    color: var(--rose-deep);
    font-size: 14px;
    white-space: nowrap;
  }
  .home-deals li {
    border-top: 1px solid var(--line);
  }
  .home-deals li:last-child {
    border-bottom: 1px solid var(--line);
  }
  .home-deals li a {
    display: grid;
    grid-template-columns: 130px minmax(0, 1fr) 170px 120px 16px;
    gap: 20px;
    align-items: center;
    padding: 22px 0;
  }
  .home-deals li a:hover .home-deal-machine strong {
    text-decoration: underline;
    text-underline-offset: 5px;
  }
  .home-deal-category,
  .home-deal-date {
    font-size: 12px;
    color: var(--plum-soft);
  }
  .home-deal-machine {
    display: grid;
    gap: 6px;
  }
  .home-deal-machine strong {
    font-size: 18px;
    font-weight: 500;
  }
  .home-deal-machine > span {
    font-size: 12px;
    color: var(--plum-soft);
  }
  .home-deal-price {
    font-size: 18px;
    color: var(--rose-deep);
    text-align: right;
  }
  .home-deal-date {
    text-align: right;
  }
  .home-deals-note {
    font-size: 12px;
    color: var(--plum-soft);
    margin-top: 16px;
  }
  @media (max-width: 1023px) {
    .home-intro-grid {
      gap: 28px;
      grid-template-columns: 1fr 1fr;
    }
    .home-title {
      font-size: 32px;
    }
    .home-search {
      padding: 20px;
    }
    .home-deals li a {
      grid-template-columns: 100px minmax(0, 1fr) 150px 16px;
    }
    .home-deal-date {
      display: none;
    }
  }
  @media (max-width: 767px) {
    .home-intro {
      padding: 32px 0 40px;
    }
    .home-intro-grid {
      grid-template-columns: 1fr;
      gap: 32px;
    }
    .home-service {
      font-size: 12px;
      margin-bottom: 18px;
    }
    .home-title {
      font-size: clamp(27px, 7.8vw, 36px);
      line-height: 1.65;
    }
    .home-description {
      font-size: 14px;
      margin-top: 18px;
    }
    .home-sell-link {
      margin-top: 16px;
      font-size: 15px;
    }
    .home-privacy {
      margin-top: 14px;
    }
    .home-search {
      padding: 20px 16px;
    }
    .home-search-fields select {
      font-size: 16px;
    }
    .home-search-fields {
      grid-template-columns: 1fr;
    }
    .home-deals {
      padding: 40px 0;
    }
    .home-deals header {
      align-items: flex-start;
      flex-direction: column;
      gap: 14px;
    }
    .home-deals h2 {
      font-size: 22px;
    }
    .home-deals li a {
      grid-template-columns: minmax(0, 1fr) auto 16px;
      gap: 10px 12px;
      padding: 18px 0;
    }
    .home-deal-category {
      grid-column: 1 / -1;
    }
    .home-deal-machine strong {
      font-size: 16px;
    }
    .home-deal-price {
      font-size: 15px;
    }
    .home-deal-date {
      display: block;
      grid-column: 1 / -1;
      text-align: left;
    }
    .home-deal-arrow {
      grid-column: 3;
      grid-row: 2;
    }
  }
  .home-flow {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 32px;
  }
  .home-flow li {
    border-top: 1px solid var(--line);
    padding-top: 20px;
  }
  .home-step {
    font-size: 14px;
    color: var(--plum-soft);
  }
  .home-categories {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    column-gap: 32px;
  }
  .home-category {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    min-height: 64px;
    padding: 16px 0;
    border-bottom: 1px solid var(--line);
  }
  .home-category:hover {
    color: var(--rose-deep);
  }
  .home-category span {
    font-family: inherit;
    font-size: 14px;
  }
  @media (max-width: 639px) {
    .home-flow {
      grid-template-columns: 1fr;
      gap: 20px;
    }
    .home-categories {
      grid-template-columns: 1fr 1fr;
      gap: 0 20px;
    }
  }
</style>
<script>
  function initHeroKindToggle() {
    const kindInput = document.getElementById('hero-listing-kind') as HTMLInputElement | null;
    const buttons = Array.from(document.querySelectorAll('.hero-kind-btn')) as HTMLButtonElement[];
    if (!buttons.length) return;

    const updateKind = (kind: string) => {
      if (kindInput) kindInput.value = kind;
      buttons.forEach((button) => {
        const selected = button.dataset.heroKind === kind;
        button.classList.toggle('bg-rose', selected);
        button.classList.toggle('text-white', selected);
        button.classList.toggle('text-plum-soft', !selected);
        button.setAttribute('aria-pressed', selected ? 'true' : 'false');
      });
    };

    buttons.forEach((button) => {
      button.addEventListener('click', () => updateKind(button.dataset.heroKind ?? ''));
    });
  }

  initHeroKindToggle();
  document.addEventListener('astro:page-load', initHeroKindToggle);
</script>
