---
export const prerender = true;

import Layout from '~/layouts/PageLayout.astro';
import ConsultForm from '~/components/ConsultForm.astro';
import TrustBadges from '~/components/TrustBadges.astro';
import Breadcrumb from '~/components/seo/Breadcrumb.astro';
import { getHomePermalink } from '~/utils/permalinks';

const relatedListingId = Astro.url.searchParams.get('listing') ?? undefined;
const relatedWantedId = Astro.url.searchParams.get('wanted') ?? undefined;
const defaultTopic = relatedListingId ? 'sell' : relatedWantedId ? 'buy' : undefined;

const metadata = {
  title: '出品・購入を相談する',
  description: '売りたい・買いたいのご相談は匿名でもOK。運営が仲介します。',
};
---

<Layout metadata={metadata}>
  <section class="py-12 md:py-16 bg-cream">
    <div class="max-w-content mx-auto px-4 sm:px-6">
      <Breadcrumb
        class="mb-6 text-sm text-plum-soft"
        items={[
          { name: 'トップ', url: getHomePermalink() },
          { name: '出品・購入を相談する' },
        ]}
      />

      <h1 class="cm-heading text-[26px] md:text-[32px] font-semibold mb-3">出品・購入を相談する</h1>
      <p class="text-plum-soft mb-4 leading-relaxed">
        売り手・買い手どちらからでもご相談いただけます。<strong class="text-plum">匿名OK・約2分</strong>。運営があいだに入ります。
      </p>
      <TrustBadges />

      {!relatedListingId && !relatedWantedId && (
        <div class="mt-8 grid sm:grid-cols-3 gap-4">
          <a href="/contact/sell" class="cm-card-interactive p-5 border-rose/20 group">
            <span class="cm-tag-sell">売りたい</span>
            <p class="mt-3 font-heading font-semibold text-plum group-hover:text-rose-deep">出品・売却を相談</p>
            <p class="mt-1 text-xs text-plum-soft">3ステップ・約2分</p>
          </a>
          <a href="/contact/buy" class="cm-card-interactive p-5 border-sage/30 group">
            <span class="cm-tag-sage">買いたい</span>
            <p class="mt-3 font-heading font-semibold text-plum group-hover:text-sage">購入を相談</p>
            <p class="mt-1 text-xs text-plum-soft">3ステップ・約2分</p>
          </a>
          <div class="cm-card p-5 border-gold/30">
            <span class="inline-flex rounded-pill px-2.5 py-0.5 text-[11px] font-semibold text-gold" style="background-color: rgb(194 163 107 / 0.15);">その他</span>
            <p class="mt-3 font-heading font-semibold text-plum">下のフォームから</p>
            <p class="mt-1 text-xs text-plum-soft">写真・型番だけでもOK</p>
          </div>
        </div>
      )}

      <div class="mt-8 cm-card p-6">
        <h2 class="font-heading text-lg font-semibold text-plum mb-4">相談フォーム</h2>
        <ConsultForm
          relatedListingId={relatedListingId}
          relatedWantedId={relatedWantedId}
          defaultTopic={(defaultTopic ?? 'sell') as 'sell' | 'buy' | 'other'}
        />
      </div>

      <div class="mt-8 cm-card p-5 text-center">
        <p class="text-sm font-medium text-plum">LINEでもご相談いただけます</p>
        <a
          href="https://lin.ee/vepVhWc"
          target="_blank"
          rel="noopener noreferrer"
          class="mt-3 inline-flex rounded-pill bg-[#06C755] px-5 py-2.5 text-sm font-semibold text-white"
        >
          LINEで相談する
        </a>
      </div>
    </div>
  </section>
</Layout>
