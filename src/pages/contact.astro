---
export const prerender = true;

import Layout from '~/layouts/PageLayout.astro';
import ConsultForm from '~/components/ConsultForm.astro';
import TrustBadges from '~/components/TrustBadges.astro';
import Breadcrumb from '~/components/seo/Breadcrumb.astro';
import { getHomePermalink } from '~/utils/permalinks';

const relatedListingId = Astro.url.searchParams.get('listing') ?? undefined;
const relatedWantedId = Astro.url.searchParams.get('wanted') ?? undefined;
const defaultTopic = relatedListingId ? 'sell' : relatedWantedId ? 'buy' : undefined;

const metadata = {
  title: '出品・購入を相談する',
  description: '売りたい・買いたいのご相談は匿名でもOK。運営が仲介します。',
};
---

<Layout metadata={metadata}>
  <section class="py-12 md:py-16 bg-surface-muted">
    <div class="max-w-4xl mx-auto px-4 sm:px-6">
      <Breadcrumb
        class="mb-6 text-sm"
        items={[
          { name: 'トップ', url: getHomePermalink() },
          { name: '出品・購入を相談する' },
        ]}
      />

      <h1 class="text-3xl md:text-4xl font-bold text-text mb-3">出品・購入を相談する</h1>
      <p class="text-text-muted mb-4 leading-relaxed">
        売り手・買い手どちらからでもご相談いただけます。<strong class="text-text">匿名OK・約2分</strong>で完了します。
      </p>
      <TrustBadges />

      {!relatedListingId && !relatedWantedId && (
        <div class="mt-8 grid sm:grid-cols-3 gap-4">
          <a href="/contact/sell" class="rounded-xl border border-border bg-surface p-5 hover:shadow-sm transition group">
            <span class="inline-flex rounded-full bg-sell px-2.5 py-0.5 text-xs font-semibold text-white">売りたい</span>
            <p class="mt-3 font-semibold text-text group-hover:text-brand-600">出品・売却を相談</p>
            <p class="mt-1 text-xs text-text-muted">3ステップ・約2分</p>
          </a>
          <a href="/contact/buy" class="rounded-xl border border-border bg-surface p-5 hover:shadow-sm transition group">
            <span class="inline-flex rounded-full bg-buy px-2.5 py-0.5 text-xs font-semibold text-white">買いたい</span>
            <p class="mt-3 font-semibold text-text group-hover:text-brand-600">購入を相談</p>
            <p class="mt-1 text-xs text-text-muted">3ステップ・約2分</p>
          </a>
          <div class="rounded-xl border border-border bg-surface p-5">
            <span class="inline-flex rounded-full bg-brand-600 px-2.5 py-0.5 text-xs font-semibold text-white">その他</span>
            <p class="mt-3 font-semibold text-text">下のフォームから</p>
            <p class="mt-1 text-xs text-text-muted">写真・型番だけでもOK</p>
          </div>
        </div>
      )}

      <div class="mt-8 rounded-xl border border-border bg-surface p-6 shadow-sm">
        <h2 class="text-lg font-semibold text-text mb-4">相談フォーム</h2>
        <ConsultForm
          relatedListingId={relatedListingId}
          relatedWantedId={relatedWantedId}
          defaultTopic={(defaultTopic ?? 'sell') as 'sell' | 'buy' | 'other'}
        />
      </div>

      <div class="mt-8 rounded-xl border border-border bg-surface p-5 text-center">
        <p class="text-sm font-medium text-text">LINEでもご相談いただけます</p>
        <a
          href="https://lin.ee/vepVhWc"
          target="_blank"
          rel="noopener noreferrer"
          class="mt-3 inline-flex rounded-xl bg-[#06C755] px-5 py-2.5 text-sm font-semibold text-white"
        >
          LINEで相談する
        </a>
      </div>
    </div>
  </section>
</Layout>
