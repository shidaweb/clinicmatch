---
export const prerender = false;

import AccountLayout from '~/layouts/AccountLayout.astro';
import { getProfile } from '~/lib/auth';
import { createSupabaseServerClient } from '~/lib/supabase/server';
import {
  MEDIATION_STATUS_LABELS,
  DEAL_STATUS_LABELS,
  INVOICE_STATUS_LABELS,
  calcCommission,
} from '~/lib/deals';

const profile = await getProfile(Astro.cookies, Astro.locals as never);
if (!profile) return Astro.redirect('/auth/login');

const supabase = createSupabaseServerClient(Astro.cookies, Astro.locals as never);

const [{ data: mediations }, { data: deals }, { data: invoices }] = await Promise.all([
  supabase
    .from('mediation_agreements')
    .select('id, status, commission_rate, signed_at, created_at')
    .eq('seller_org_id', profile.org_id)
    .order('created_at', { ascending: false }),
  supabase
    .from('deals')
    .select('id, agreed_price, commission_amount, status, concluded_at, created_at, buyer_org_id, seller_org_id')
    .or(`buyer_org_id.eq.${profile.org_id},seller_org_id.eq.${profile.org_id}`)
    .order('created_at', { ascending: false }),
  supabase
    .from('commission_invoices')
    .select('id, deal_id, amount, status, issued_at, due_date, paid_at')
    .order('issued_at', { ascending: false }),
]);

const metadata = { title: '契約・請求' };
---

<AccountLayout metadata={metadata} title="契約・請求" maxWidth="4xl">
  <div class="space-y-10">
    <div>
      <h2 class="text-lg font-semibold text-plum mb-4">仲介契約（売り手 ⇔ 運営）</h2>
      <ul class="space-y-3">
        {
          (mediations ?? []).length ? mediations!.map((m) => (
            <li class="cm-list-item flex justify-between text-sm">
              <span class="text-plum">手数料率 {(Number(m.commission_rate) * 100).toFixed(1)}%</span>
              <span class="text-plum-soft">{MEDIATION_STATUS_LABELS[m.status] ?? m.status}</span>
            </li>
          )) : (
            <li class="text-sm text-plum-soft">仲介契約はありません</li>
          )
        }
      </ul>
    </div>

    <div>
      <h2 class="text-lg font-semibold text-plum mb-4">売買契約</h2>
      <ul class="space-y-3">
        {
          (deals ?? []).length ? deals!.map((d) => (
            <li class="cm-list-item">
              <div class="flex justify-between text-sm mb-2">
                <span class="font-semibold text-plum">{d.agreed_price?.toLocaleString()}円</span>
                <span class="text-plum-soft">{DEAL_STATUS_LABELS[d.status] ?? d.status}</span>
              </div>
              {
                d.commission_amount != null && profile.org_id === d.seller_org_id && (
                  <p class="text-xs text-plum-soft">
                    仲介手数料（7.5%）: {d.commission_amount.toLocaleString()}円
                    {d.agreed_price && ` （${calcCommission(d.agreed_price).toLocaleString()}円）`}
                  </p>
                )
              }
            </li>
          )) : (
            <li class="text-sm text-plum-soft">売買契約はありません</li>
          )
        }
      </ul>
    </div>

    {
      profile.org_id && (invoices ?? []).length > 0 && (
        <div>
          <h2 class="text-lg font-semibold text-plum mb-4">手数料請求（売り手向け）</h2>
          <ul class="space-y-3">
            {invoices!.map((inv) => (
              <li class="cm-list-item flex justify-between text-sm">
                <span class="text-plum">{inv.amount?.toLocaleString()}円</span>
                <span class="text-plum-soft">{INVOICE_STATUS_LABELS[inv.status] ?? inv.status}</span>
              </li>
            ))}
          </ul>
        </div>
      )
    }
  </div>
</AccountLayout>
