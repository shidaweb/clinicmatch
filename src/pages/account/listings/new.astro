---
export const prerender = false;

import AccountLayout from '~/layouts/AccountLayout.astro';
import { getProfile } from '~/lib/auth';
import { PREFECTURES } from '~/lib/marketplace';
import { MARKET_CATEGORIES } from '~/lib/categories';

const profile = await getProfile(Astro.cookies, Astro.locals as never);
if (!profile) return Astro.redirect('/auth/login');

const org = profile.organizations as { prefecture?: string; city?: string } | null;
const metadata = { title: '売りたいを出す' };
---

<AccountLayout metadata={metadata} title="売りたい機器を登録・相談する" maxWidth="2xl">
  <form id="listing-form" class="cm-card p-6 space-y-5">
    <section>
      <p class="cm-label">写真</p>
      <input id="listing-image-input" type="file" accept="image/jpeg,image/png,image/webp" multiple hidden />
      <div id="listing-image-grid" class="mt-2 grid grid-cols-3 gap-2 sm:gap-3"></div>
      <p class="mt-2 text-xs text-plum-soft">最大10枚／1枚目が表紙／「表紙にする」「←」「→」で並び替えできます。</p>
      <p class="mt-1 text-xs text-danger">院名・連絡先・人物が写らない写真をご利用ください。</p>
      <p id="listing-image-error" class="mt-1 text-xs text-danger hidden"></p>
    </section>
    <div>
      <label class="cm-label">カテゴリ</label>
      <select name="category_slug" required class="cm-input">
        {MARKET_CATEGORIES.map((c) => <option value={c.slug}>{c.name}</option>)}
      </select>
    </div>
    <div class="grid sm:grid-cols-2 gap-4">
      <div>
        <label class="cm-label">メーカー</label>
        <input name="maker" required class="cm-input" />
      </div>
      <div>
        <label class="cm-label">機種名</label>
        <input name="model" required class="cm-input" />
      </div>
    </div>
    <div>
      <label class="cm-label">出品種別</label>
      <select id="listing-kind" name="listing_kind" class="cm-input">
        <option value="device">機器本体</option>
        <option value="consumable_valid">消耗品（期限内）</option>
        <option value="consumable_expired">消耗品（期限切れ・研修用）</option>
      </select>
      <p class="mt-1 text-xs text-plum-soft">消耗品を選択すると、品目マスタに応じて必須項目が自動で切り替わります。</p>
    </div>
    <section id="consumable-fields" class="hidden rounded-card border border-line bg-cream p-4 space-y-4">
      <div>
        <label class="cm-label">消耗品マスタ</label>
        <select id="consumable-master-id" name="consumable_master_id" class="cm-input">
          <option value="">メーカー・機種名に紐づく品目を選択</option>
        </select>
      </div>
      <div class="grid sm:grid-cols-2 gap-4">
        <div>
          <label class="cm-label">数量</label>
          <input name="quantity" type="number" min="1" value="1" class="cm-input" />
        </div>
        <div>
          <label class="cm-label">開封状態</label>
          <select id="open-state" name="open_state" class="cm-input">
            <option value="sealed">未開封</option>
            <option value="opened">開封済み</option>
            <option value="used">使用済み</option>
          </select>
        </div>
      </div>
      <div class="grid sm:grid-cols-2 gap-4">
        <div>
          <label class="cm-label">有効期限</label>
          <input id="expiry-date" name="expiry_date" type="date" class="cm-input" />
        </div>
        <div>
          <label class="cm-label">残ショット数</label>
          <input id="remaining-shots" name="remaining_shots" type="number" min="0" class="cm-input" />
        </div>
      </div>
      <div class="grid sm:grid-cols-2 gap-4">
        <div>
          <label class="cm-label">残寿命（任意）</label>
          <input name="remaining_life" class="cm-input" placeholder="例: 残200ショット / 残40時間" />
        </div>
        <div>
          <label class="cm-label">ロット番号（任意）</label>
          <input name="lot_number" class="cm-input" />
        </div>
      </div>
      <div>
        <label class="cm-label">状態補足</label>
        <textarea name="condition_note" rows="2" class="cm-input"></textarea>
      </div>
      <label class="inline-flex items-center gap-2 text-sm">
        <input type="checkbox" name="negotiable" value="true" />
        価格は応相談
      </label>
      <label id="reuse-attestation-wrap" class="hidden inline-flex items-center gap-2 text-sm">
        <input type="checkbox" id="reuse-attestation" name="reuse_attestation" value="true" />
        再利用・改造品ではないことを確認しました
      </label>
      <p id="consumable-preview" class="rounded-lg bg-ivory px-3 py-2 text-xs text-plum-soft"></p>
      <p id="consumable-warning" class="hidden text-xs text-danger"></p>
    </section>
    <div class="grid sm:grid-cols-2 gap-4">
      <div>
        <label class="cm-label">希望価格（円）</label>
        <input name="asking_price" type="number" class="cm-input" />
      </div>
      <div>
        <label class="cm-label">年式</label>
        <input name="manufacture_year" type="number" class="cm-input" />
      </div>
    </div>
    <div class="grid sm:grid-cols-2 gap-4">
      <div>
        <label class="cm-label">都道府県</label>
        <select name="location_prefecture" required class="cm-input">
          {
            PREFECTURES.map((pref) => (
              <option value={pref} selected={pref === org?.prefecture}>
                {pref}
              </option>
            ))
          }
        </select>
      </div>
      <div>
        <label class="cm-label">市区町村</label>
        <input name="location_city" required value={org?.city ?? ''} class="cm-input" />
      </div>
    </div>
    <div class="grid sm:grid-cols-2 gap-4">
      <div>
        <label class="cm-label">メーカー保守</label>
        <select name="maker_maintenance" class="cm-input">
          <option value="unknown">不明</option>
          <option value="yes">あり</option>
          <option value="no">なし</option>
        </select>
      </div>
      <div>
        <label class="cm-label">保守引継ぎ</label>
        <select name="maintenance_transferable" class="cm-input">
          <option value="unknown">不明</option>
          <option value="yes">可</option>
          <option value="no">不可</option>
        </select>
      </div>
    </div>
    <div>
      <label class="inline-flex items-center gap-2 text-sm">
        <input type="checkbox" name="has_accessories" value="true" />
        付属品あり
      </label>
    </div>
    <div>
      <label class="cm-label">付属品詳細</label>
      <textarea name="accessories_detail" rows="2" class="cm-input"></textarea>
    </div>
    <div>
      <label class="cm-label">説明</label>
      <textarea name="description" rows="4" class="cm-input"></textarea>
    </div>
    <div class="sticky bottom-0 -mx-6 px-6 py-4 bg-ivory border-t border-line">
      <div class="flex gap-3">
        <button type="submit" name="action" value="draft" class="cm-btn-secondary text-sm">下書き保存</button>
        <button type="submit" name="action" value="submit" class="cm-btn-primary text-sm">審査に提出</button>
      </div>
      <p id="listing-status" class="mt-2 text-sm text-plum-soft hidden"></p>
      <a id="saved-draft" class="cm-link text-sm hidden">保存済みの下書きで画像・提出状態を確認する</a>
    </div>
  </form>
</AccountLayout>

<script>
  type PickerImage = {
    id: string;
    file: File;
    previewUrl: string;
    uploaded: boolean;
  };
  type ConsumableMaster = {
    id: string;
    category_slug: string;
    maker: string;
    model: string;
    name: string;
    is_sterile_sud: boolean;
    is_shot_controlled: boolean;
    has_expiry: boolean;
    prohibit_reuse: boolean;
    shipping_flags: string[] | null;
  };

  const form = document.getElementById('listing-form') as HTMLFormElement | null;
  const status = document.getElementById('listing-status') as HTMLParagraphElement | null;
  const imageError = document.getElementById('listing-image-error') as HTMLParagraphElement | null;
  const imageGrid = document.getElementById('listing-image-grid') as HTMLDivElement | null;
  const imageInput = document.getElementById('listing-image-input') as HTMLInputElement | null;
  const listingKindSelect = document.getElementById('listing-kind') as HTMLSelectElement | null;
  const consumableFields = document.getElementById('consumable-fields') as HTMLElement | null;
  const masterSelect = document.getElementById('consumable-master-id') as HTMLSelectElement | null;
  const openStateSelect = document.getElementById('open-state') as HTMLSelectElement | null;
  const expiryInput = document.getElementById('expiry-date') as HTMLInputElement | null;
  const shotsInput = document.getElementById('remaining-shots') as HTMLInputElement | null;
  const reuseWrap = document.getElementById('reuse-attestation-wrap') as HTMLLabelElement | null;
  const reuseInput = document.getElementById('reuse-attestation') as HTMLInputElement | null;
  const consumablePreview = document.getElementById('consumable-preview') as HTMLParagraphElement | null;
  const consumableWarning = document.getElementById('consumable-warning') as HTMLParagraphElement | null;
  const categorySelect = form?.querySelector('select[name="category_slug"]') as HTMLSelectElement | null;
  const makerInput = form?.querySelector('input[name="maker"]') as HTMLInputElement | null;
  const modelInput = form?.querySelector('input[name="model"]') as HTMLInputElement | null;

  const allowedTypes = new Set(['image/jpeg', 'image/png', 'image/webp']);
  const maxSize = 8 * 1024 * 1024;
  let pickerImages: PickerImage[] = [];
  let createdListingId = '';
  let consumableMasters: ConsumableMaster[] = [];

  const showImageError = (message: string) => {
    if (!imageError) return;
    imageError.classList.remove('hidden');
    imageError.textContent = message;
  };

  const clearImageError = () => {
    if (!imageError) return;
    imageError.classList.add('hidden');
    imageError.textContent = '';
  };

  const moveToCover = (id: string) => {
    const index = pickerImages.findIndex((item) => item.id === id);
    if (index <= 0) return;
    const [item] = pickerImages.splice(index, 1);
    pickerImages.unshift(item);
    renderImageGrid();
  };

  const moveImage = (id: string, direction: -1 | 1) => {
    const index = pickerImages.findIndex((item) => item.id === id);
    const target = index + direction;
    if (index < 0 || target < 0 || target >= pickerImages.length) return;
    [pickerImages[index], pickerImages[target]] = [pickerImages[target], pickerImages[index]];
    renderImageGrid();
  };

  const removeImage = (id: string) => {
    const item = pickerImages.find((image) => image.id === id);
    if (item) URL.revokeObjectURL(item.previewUrl);
    pickerImages = pickerImages.filter((image) => image.id !== id);
    renderImageGrid();
  };

  const addFiles = (files: FileList | null) => {
    if (saving || createdListingId) {
      showImageError('保存開始後の画像編集は、保存済みの下書きから行ってください。');
      return;
    }
    if (!files) return;
    clearImageError();
    const remaining = 10 - pickerImages.length;
    if (remaining <= 0) {
      showImageError('画像は最大10枚までです。');
      return;
    }

    const nextFiles = Array.from(files).slice(0, remaining);
    for (const file of nextFiles) {
      if (!allowedTypes.has(file.type)) {
        showImageError('JPEG / PNG / WebP のみ登録できます。');
        continue;
      }
      if (file.size > maxSize) {
        showImageError('1枚あたり8MB以下の画像を選択してください。');
        continue;
      }
      pickerImages.push({
        id: crypto.randomUUID(),
        file,
        previewUrl: URL.createObjectURL(file),
        uploaded: false,
      });
    }
    renderImageGrid();
  };

  const renderImageGrid = () => {
    if (!imageGrid) return;
    imageGrid.innerHTML = '';

    pickerImages.forEach((item, index) => {
      const tile = document.createElement('div');
      tile.className = 'relative rounded-xl border border-line bg-cream overflow-hidden aspect-square';
      tile.innerHTML = `
        <img src="${item.previewUrl}" alt="選択中の出品画像 ${index + 1}" class="h-full w-full object-cover" />
        ${
          index === 0
            ? '<span class="absolute left-1.5 top-1.5 rounded-pill bg-rose px-2 py-0.5 text-[10px] text-white">表紙</span>'
            : ''
        }
        <button type="button" data-role="remove" data-id="${item.id}" class="absolute right-1.5 top-1.5 rounded-full bg-plum/80 px-1.5 py-0.5 text-[10px] text-white">×</button>
        <div class="absolute inset-x-0 bottom-0 flex gap-1 bg-plum/75 p-1 text-[10px] text-white">
          <button type="button" data-role="cover" data-id="${item.id}" class="rounded bg-white/20 px-1.5 py-0.5">表紙にする</button>
          <button type="button" data-role="left" data-id="${item.id}" class="rounded bg-white/20 px-1.5 py-0.5">←</button>
          <button type="button" data-role="right" data-id="${item.id}" class="rounded bg-white/20 px-1.5 py-0.5">→</button>
        </div>
      `;
      imageGrid.appendChild(tile);
    });

    const addTile = document.createElement('button');
    addTile.type = 'button';
    addTile.className =
      'aspect-square rounded-xl border border-dashed border-line text-plum-soft text-xs bg-ivory hover:bg-cream transition-colors';
    addTile.textContent = '＋ 写真を追加';
    addTile.addEventListener('click', () => imageInput?.click());
    imageGrid.appendChild(addTile);
  };

  const selectedMaster = () => {
    const id = masterSelect?.value ?? '';
    return consumableMasters.find((item) => item.id === id) ?? null;
  };

  const isConsumableKind = () => (listingKindSelect?.value ?? 'device') !== 'device';

  const classifyPreview = () => {
    if (!consumablePreview || !consumableWarning) return;
    if (!isConsumableKind()) {
      consumablePreview.textContent = '機器本体として登録されます。';
      consumableWarning.classList.add('hidden');
      consumableWarning.textContent = '';
      return;
    }
    const master = selectedMaster();
    if (!master) {
      consumablePreview.textContent = '消耗品マスタを選択してください。';
      consumableWarning.classList.add('hidden');
      consumableWarning.textContent = '';
      return;
    }

    const listingKind = listingKindSelect?.value ?? 'consumable_valid';
    const expiry = expiryInput?.value ? new Date(`${expiryInput.value}T00:00:00+09:00`) : null;
    const now = new Date();
    const today = new Date(Date.UTC(now.getUTCFullYear(), now.getUTCMonth(), now.getUTCDate()));
    const shots = shotsInput?.value ? Number(shotsInput.value) : null;
    const openState = openStateSelect?.value ?? 'sealed';
    const expired = Boolean(master.has_expiry && expiry && expiry < today);
    const shotEmpty = Boolean(master.is_shot_controlled && (shots ?? 0) <= 0);
    const openedSensitive = Boolean(
      (master.is_sterile_sud || master.is_shot_controlled) && (openState === 'opened' || openState === 'used')
    );
    const training = listingKind === 'consumable_expired' || expired || shotEmpty || openedSensitive;
    const normalizedKind = training ? 'consumable_expired' : listingKind;
    const kindLabel = normalizedKind === 'consumable_valid' ? '消耗品（期限内）' : '消耗品（期限切れ・研修用）';
    const clinicalLabel = training ? '患者施術不可（研修・デモ用）' : '患者施術可';
    consumablePreview.textContent = `公開カテゴリ: ${kindLabel} / 判定: ${clinicalLabel}`;

    const reasons: string[] = [];
    if (expired) reasons.push('有効期限切れ');
    if (shotEmpty) reasons.push('残ショット0');
    if (openedSensitive) reasons.push('開封済み/使用済み');
    if (reasons.length > 0) {
      consumableWarning.classList.remove('hidden');
      consumableWarning.textContent = `自動補正理由: ${reasons.join('・')}`;
    } else {
      consumableWarning.classList.add('hidden');
      consumableWarning.textContent = '';
    }
  };

  const renderMasterOptions = () => {
    if (!masterSelect) return;
    const selected = masterSelect.value;
    masterSelect.innerHTML = '<option value="">メーカー・機種名に紐づく品目を選択</option>';
    for (const item of consumableMasters) {
      const option = document.createElement('option');
      option.value = item.id;
      option.textContent = item.name;
      option.selected = item.id === selected;
      masterSelect.appendChild(option);
    }
  };

  const applyMasterRules = () => {
    const master = selectedMaster();
    if (!master) {
      if (expiryInput) expiryInput.required = false;
      if (shotsInput) shotsInput.required = false;
      if (reuseWrap) reuseWrap.classList.add('hidden');
      if (reuseInput) {
        reuseInput.required = false;
        reuseInput.checked = false;
      }
      classifyPreview();
      return;
    }

    if (expiryInput) expiryInput.required = master.has_expiry;
    if (shotsInput) shotsInput.required = master.is_shot_controlled;
    if (reuseWrap) reuseWrap.classList.toggle('hidden', !master.prohibit_reuse);
    if (reuseInput) reuseInput.required = master.prohibit_reuse;
    classifyPreview();
  };

  const syncConsumableVisibility = () => {
    const consumable = isConsumableKind();
    consumableFields?.classList.toggle('hidden', !consumable);
    if (masterSelect) masterSelect.required = consumable;
    if (!consumable) {
      if (masterSelect) masterSelect.value = '';
      if (expiryInput) expiryInput.value = '';
      if (shotsInput) shotsInput.value = '';
      if (openStateSelect) openStateSelect.value = 'sealed';
      if (reuseWrap) reuseWrap.classList.add('hidden');
      if (reuseInput) {
        reuseInput.checked = false;
        reuseInput.required = false;
      }
    }
    classifyPreview();
  };

  const loadConsumableMaster = async () => {
    if (!isConsumableKind()) return;
    const params = new URLSearchParams();
    if (categorySelect?.value) params.set('category', categorySelect.value);
    if (makerInput?.value.trim()) params.set('maker', makerInput.value.trim());
    if (modelInput?.value.trim()) params.set('model', modelInput.value.trim());
    const res = await fetch(`/api/consumables/master?${params.toString()}`);
    const json = (await res.json().catch(() => ({ items: [] }))) as { items?: ConsumableMaster[] };
    consumableMasters = json.items ?? [];
    renderMasterOptions();
    applyMasterRules();
  };

  imageGrid?.addEventListener('click', (event) => {
    if (saving || createdListingId) {
      showImageError('保存開始後の画像編集は、保存済みの下書きから行ってください。');
      return;
    }
    const button = (event.target as HTMLElement).closest('button');
    if (!button) return;
    const id = button.getAttribute('data-id');
    if (!id) return;
    const role = button.getAttribute('data-role');
    if (role === 'remove') removeImage(id);
    if (role === 'cover') moveToCover(id);
    if (role === 'left') moveImage(id, -1);
    if (role === 'right') moveImage(id, 1);
  });

  imageInput?.addEventListener('change', () => {
    addFiles(imageInput.files);
    imageInput.value = '';
  });
  listingKindSelect?.addEventListener('change', async () => {
    syncConsumableVisibility();
    await loadConsumableMaster();
  });
  categorySelect?.addEventListener('change', loadConsumableMaster);
  makerInput?.addEventListener('change', loadConsumableMaster);
  modelInput?.addEventListener('change', loadConsumableMaster);
  masterSelect?.addEventListener('change', applyMasterRules);
  openStateSelect?.addEventListener('change', classifyPreview);
  expiryInput?.addEventListener('change', classifyPreview);
  shotsInput?.addEventListener('input', classifyPreview);
  reuseInput?.addEventListener('change', classifyPreview);

  const toPayload = () => {
    if (!form) return {};
    const fd = new FormData(form);
    const raw: Record<string, unknown> = Object.fromEntries(fd);
    raw.has_accessories = fd.has('has_accessories');
    raw.negotiable = fd.has('negotiable');
    raw.reuse_attestation = fd.has('reuse_attestation');
    return raw;
  };

  const requestJson = async (res: Response) => {
    return (await res.json().catch(() => ({}))) as { error?: string; id?: string };
  };

  let creationKey = crypto.randomUUID();
  let creationBody: string | null = null;
  const ensureDraft = async (payload: Record<string, unknown>) => {
    if (!createdListingId) {
      creationBody ??= JSON.stringify({ ...payload, submit: false });
      const createRes = await fetch('/api/listings', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'Idempotency-Key': creationKey },
        body: creationBody,
      });
      const createJson = await requestJson(createRes);
      if (!createRes.ok || !createJson.id) {
        if (createRes.status === 400) {
          creationBody = null;
          creationKey = crypto.randomUUID();
        }
        throw new Error(createJson.error ?? '出品の作成に失敗しました');
      }
      createdListingId = createJson.id;
    }
    // Resolve the original receipt before applying any edits made during a failed retry.
    const patchRes = await fetch(`/api/listings/${createdListingId}`, {
      method: 'PATCH',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ ...payload, submit: false }),
    });
    const patchJson = await requestJson(patchRes);
    if (!patchRes.ok) throw new Error(patchJson.error ?? '下書き保存に失敗しました');
    return createdListingId;
  };

  const uploadPendingImages = async (listingId: string) => {
    const pending = pickerImages.filter((item) => !item.uploaded);
    for (let index = 0; index < pending.length; index += 1) {
      const item = pending[index];
      if (status) status.textContent = `画像をアップロード中… ${index + 1}/${pending.length}枚`;
      const fd = new FormData();
      fd.append('file', item.file);
      const uploadRes = await fetch(`/api/listings/${listingId}`, {
        method: 'POST',
        headers: { 'Idempotency-Key': item.id },
        body: fd,
      });
      const uploadJson = await requestJson(uploadRes);
      if (!uploadRes.ok) {
        throw new Error(uploadJson.error ?? '画像アップロードに失敗しました');
      }
      item.uploaded = true;
    }
  };

  let saving = false;
  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    if (!status || saving) return;
    saving = true;
    const submitter = (event.submitter as HTMLButtonElement | null)?.value ?? 'draft';
    const submit = submitter === 'submit';

    status.classList.remove('hidden', 'text-danger');
    status.textContent = submit ? '申請を準備中…' : '下書きを保存中…';

    try {
      const payload = toPayload();
      const listingId = await ensureDraft(payload);
      await uploadPendingImages(listingId);

      if (submit) {
        const patchRes = await fetch(`/api/listings/${listingId}`, {
          method: 'PATCH',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ ...payload, submit: true }),
        });
        const patchJson = await requestJson(patchRes);
        if (!patchRes.ok) throw new Error(patchJson.error ?? '審査提出に失敗しました');
      }

      window.location.href = submit ? '/account/listings/thanks' : '/account/listings?draft=1';
    } catch (error) {
      status.classList.add('text-danger');
      status.textContent = error instanceof Error ? error.message : '保存に失敗しました';
      if (createdListingId) {
        const link = document.getElementById('saved-draft') as HTMLAnchorElement;
        link.href = `/account/listings/${createdListingId}/edit`;
        link.classList.remove('hidden');
      }
    } finally {
      saving = false;
    }
  });

  renderImageGrid();
  syncConsumableVisibility();
  loadConsumableMaster().catch(() => {
    if (!consumableWarning) return;
    consumableWarning.classList.remove('hidden');
    consumableWarning.textContent = '消耗品マスタの取得に失敗しました。時間をおいて再度お試しください。';
  });
</script>
