---
export const prerender = false;

import AccountLayout from '~/layouts/AccountLayout.astro';
import { getProfile } from '~/lib/auth';
import { createSupabaseServerClient } from '~/lib/supabase/server';
import { PREFECTURES, POST_STATUS_LABELS } from '~/lib/marketplace';

const profile = await getProfile(Astro.cookies, Astro.locals as never);
if (!profile) return Astro.redirect('/auth/login');

const { id } = Astro.params;
if (!id) return Astro.redirect('/account/listings');

const supabase = createSupabaseServerClient(Astro.cookies, Astro.locals as never);
const { data: listing } = await supabase
  .from('listings')
  .select('*, listing_images(id, storage_path, is_cover, sort_order)')
  .eq('id', id)
  .eq('seller_org_id', profile.org_id)
  .single();

if (!listing) return Astro.redirect('/account/listings');

const supabaseUrl = import.meta.env.PUBLIC_SUPABASE_URL ?? '';
const metadata = { title: '出品を編集' };
---

<AccountLayout
  metadata={metadata}
  title="出品を編集"
  subtitle={`ステータス: ${POST_STATUS_LABELS[listing.status] ?? listing.status}`}
  maxWidth="2xl"
>
  <a href="/account/listings" class="cm-link text-sm mb-6 inline-block">← 売りたい一覧</a>

  <form id="listing-form" class="cm-card p-6 space-y-4">
    <input type="hidden" name="id" value={listing.id} />
    <div>
      <label class="cm-label">カテゴリ</label>
      <select name="category_slug" required class="cm-input">
        {['hair-removal','pico-laser','ipl','hifu','rf','body'].map((slug) => (
          <option value={slug} selected={listing.category_slug === slug}>{slug}</option>
        ))}
      </select>
    </div>
    <div class="grid sm:grid-cols-2 gap-4">
      <div>
        <label class="cm-label">メーカー</label>
        <input name="maker" required value={listing.maker} class="cm-input" />
      </div>
      <div>
        <label class="cm-label">型番</label>
        <input name="model" required value={listing.model} class="cm-input" />
      </div>
    </div>
    <div class="grid sm:grid-cols-2 gap-4">
      <div>
        <label class="cm-label">希望価格（円）</label>
        <input name="asking_price" type="number" value={listing.asking_price ?? ''} class="cm-input" />
      </div>
      <div>
        <label class="cm-label">年式</label>
        <input name="manufacture_year" type="number" value={listing.manufacture_year ?? ''} class="cm-input" />
      </div>
    </div>
    <div class="grid sm:grid-cols-2 gap-4">
      <div>
        <label class="cm-label">都道府県</label>
        <select name="location_prefecture" required class="cm-input">
          {PREFECTURES.map((pref) => (
            <option value={pref} selected={pref === listing.location_prefecture}>{pref}</option>
          ))}
        </select>
      </div>
      <div>
        <label class="cm-label">市区町村</label>
        <input name="location_city" required value={listing.location_city} class="cm-input" />
      </div>
    </div>
    <div>
      <label class="cm-label">説明</label>
      <textarea name="description" rows="4" class="cm-input">{listing.description ?? ''}</textarea>
    </div>
    <div class="flex gap-3">
      <button type="submit" name="action" value="draft" class="rounded-xl border border-line px-5 py-2.5 text-sm text-plum">保存</button>
      <button type="submit" name="action" value="submit" class="cm-btn-primary">審査に提出</button>
    </div>
    <p id="listing-status" class="text-sm text-plum-soft hidden"></p>
  </form>

  <div class="mt-8 cm-card p-6">
    <h2 class="font-heading font-semibold text-plum mb-4">画像</h2>
    <div id="existing-images" class="grid grid-cols-3 gap-3 mb-4">
      {(listing.listing_images ?? []).map((img: { id: string; storage_path: string; is_cover: boolean }) => (
        supabaseUrl && (
          <div class="relative rounded-2xl overflow-hidden border border-line bg-cream">
            <img
              src={`${supabaseUrl}/storage/v1/object/public/listing-images/${img.storage_path}`}
              alt=""
              class="h-24 w-full object-cover"
            />
            {img.is_cover && (
              <span class="absolute left-1 top-1 rounded-pill bg-rose px-2 py-0.5 text-[10px] text-white">表紙</span>
            )}
            <div class="absolute inset-x-0 bottom-0 flex gap-1 bg-plum/75 p-1 text-[10px] text-white">
              <button type="button" data-role="cover" data-id={img.id} class="rounded bg-white/20 px-1.5 py-0.5">表紙</button>
              <button type="button" data-role="left" data-id={img.id} class="rounded bg-white/20 px-1.5 py-0.5">←</button>
              <button type="button" data-role="right" data-id={img.id} class="rounded bg-white/20 px-1.5 py-0.5">→</button>
              <button type="button" data-role="delete" data-id={img.id} class="rounded bg-white/20 px-1.5 py-0.5">削除</button>
            </div>
          </div>
        )
      ))}
    </div>
    <form id="image-form" class="flex gap-3 items-end">
      <input type="file" name="file" accept="image/jpeg,image/png,image/webp" required class="text-sm text-plum" />
      <button type="submit" class="cm-btn-primary text-sm !px-4 !py-2">アップロード</button>
    </form>
    <p id="image-status" class="text-sm text-plum-soft mt-2 hidden"></p>
  </div>
</AccountLayout>

<script define:vars={{ listingId: listing.id }}>
  const form = document.getElementById('listing-form');
  const status = document.getElementById('listing-status');
  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const submitter = e.submitter?.value ?? 'draft';
    const data = Object.fromEntries(new FormData(form));
    data.submit = submitter === 'submit';
    status.classList.remove('hidden');
    status.textContent = '保存中…';
    const res = await fetch(`/api/listings/${listingId}`, {
      method: 'PATCH',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(data),
    });
    const json = await res.json();
    status.textContent = res.ok ? '保存しました' : (json.error ?? '失敗しました');
    if (res.ok && submitter === 'submit') window.location.href = '/account/listings';
  });

  const imageForm = document.getElementById('image-form');
  const imageStatus = document.getElementById('image-status');
  const imageGrid = document.getElementById('existing-images');
  const imageOrder = Array.from(imageGrid?.querySelectorAll('button[data-id]') ?? [])
    .map((button) => button.getAttribute('data-id'))
    .filter((id) => !!id);

  const updateOrder = async () => {
    await fetch(`/api/listings/${listingId}/images`, {
      method: 'PATCH',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ order: imageOrder }),
    });
  };

  const requestImageAction = async (path, options = {}) => {
    const res = await fetch(path, options);
    const json = await res.json().catch(() => ({}));
    if (!res.ok) throw new Error(json.error ?? '画像操作に失敗しました');
    return json;
  };

  imageGrid?.addEventListener('click', async (e) => {
    const button = e.target.closest('button[data-role][data-id]');
    if (!button) return;
    const imageId = button.getAttribute('data-id');
    const role = button.getAttribute('data-role');
    if (!imageId || !role) return;

    try {
      imageStatus.classList.remove('hidden');
      imageStatus.textContent = '更新中…';

      if (role === 'delete') {
        await requestImageAction(`/api/listings/${listingId}/images/${imageId}`, { method: 'DELETE' });
        window.location.reload();
        return;
      }
      if (role === 'cover') {
        await requestImageAction(`/api/listings/${listingId}/images`, {
          method: 'PATCH',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ coverId: imageId }),
        });
        window.location.reload();
        return;
      }

      const index = imageOrder.indexOf(imageId);
      if (index < 0) return;
      const target = role === 'left' ? index - 1 : index + 1;
      if (target < 0 || target >= imageOrder.length) return;
      [imageOrder[index], imageOrder[target]] = [imageOrder[target], imageOrder[index]];
      await updateOrder();
      window.location.reload();
    } catch (error) {
      imageStatus.textContent = error instanceof Error ? error.message : '失敗しました';
    }
  });

  imageForm?.addEventListener('submit', async (e) => {
    e.preventDefault();
    imageStatus.classList.remove('hidden');
    imageStatus.textContent = 'アップロード中…';
    const fd = new FormData(imageForm);
    const res = await fetch(`/api/listings/${listingId}`, { method: 'POST', body: fd });
    const json = await res.json();
    if (res.ok) window.location.reload();
    else imageStatus.textContent = json.error ?? '失敗しました';
  });
</script>
