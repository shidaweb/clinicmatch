---
export const prerender = false;

import AccountLayout from '~/layouts/AccountLayout.astro';
import { getProfile } from '~/lib/auth';
import { createSupabaseServerClient } from '~/lib/supabase/server';
import { POST_STATUS_LABELS } from '~/lib/marketplace';

const profile = await getProfile(Astro.cookies, Astro.locals as never);
if (!profile) return Astro.redirect('/auth/login');

const supabase = createSupabaseServerClient(Astro.cookies, Astro.locals as never);
const showArchived = Astro.url.searchParams.get('archived') === '1';
const { data: listings } = await supabase
  .from('listings')
  .select('id, maker, model, status, created_at')
  .eq('seller_org_id', profile.org_id)
  .filter('archived_at', showArchived ? 'not.is' : 'is', 'null')
  .order('created_at', { ascending: false });

const { data: reviews } = await supabase
  .from('post_review_events')
  .select('listing_id,reason,created_at')
  .eq('decision', 'rejected')
  .order('created_at', { ascending: false });

const metadata = { title: '売りたい一覧' };
const draftSaved = Astro.url.searchParams.has('draft');
---

<AccountLayout metadata={metadata} title="売りたい一覧" maxWidth="4xl">
  {
    draftSaved && (
      <p class="mb-4 rounded-xl border border-sage/30 bg-sage/10 px-4 py-3 text-sm text-plum">
        下書きを保存しました。内容を確認のうえ、審査に提出できます。
      </p>
    )
  }
  <a href="/account/listings/new" slot="actions" class="cm-btn-primary text-sm !px-4 !py-2">+ 新規出品</a>
  <p id="listing-delete-status" class="mb-3 hidden text-sm"></p>
  <a class="cm-link block mb-4" href={showArchived ? '/account/listings' : '/account/listings?archived=1'}
    >{showArchived ? '通常の一覧へ' : '保管した投稿を見る'}</a
  >
  <ul class="space-y-3">
    {
      (listings ?? []).map((item) => (
        <li class="cm-list-item flex justify-between items-center gap-3" data-listing-id={item.id}>
          <span class="text-plum">
            {item.maker} {item.model}
          </span>
          {item.status === 'rejected' && (
            <p class="text-sm text-danger">
              差し戻し理由：{reviews?.find((r) => r.listing_id === item.id)?.reason || '運営へご確認ください'}
            </p>
          )}
          <div class="flex items-center gap-3">
            {showArchived && (
              <button type="button" class="cm-link" data-restore-id={item.id}>
                一覧に戻す
              </button>
            )}
            <span class="text-sm text-plum-soft">{POST_STATUS_LABELS[item.status] ?? item.status}</span>
            {!showArchived && ['draft', 'rejected'].includes(item.status) && (
              <>
                <a href={`/account/listings/${item.id}/edit`} class="cm-link">
                  編集
                </a>
                <button type="button" class="cm-link text-danger" data-delete-listing={item.id}>
                  保管
                </button>
              </>
            )}
          </div>
        </li>
      ))
    }
  </ul>
</AccountLayout>

<script>
  const status = document.getElementById('listing-delete-status');

  const showStatus = (message, isError = false) => {
    if (!status) return;
    status.classList.remove('hidden', 'text-danger', 'text-plum-soft');
    status.classList.add(isError ? 'text-danger' : 'text-plum-soft');
    status.textContent = message;
  };

  document.addEventListener('click', async (event) => {
    const button = (event.target instanceof Element ? event.target : null)?.closest('button[data-delete-listing]');
    if (!button) return;

    const listingId = button.getAttribute('data-delete-listing');
    if (!listingId) return;

    const ok = window.confirm('この売りたい投稿を一覧から保管しますか？データと画像は残ります。');
    if (!ok) return;

    showStatus('保管中…');
    const res = await fetch(`/api/listings/${listingId}`, { method: 'DELETE' });
    const json = await res.json().catch(() => ({}));
    if (!res.ok) {
      showStatus(json.error ?? '保管に失敗しました', true);
      return;
    }

    const row = document.querySelector(`[data-listing-id="${listingId}"]`);
    row?.remove();
    showStatus('保管しました');
  });
</script>

<script>
  document.querySelectorAll<HTMLButtonElement>('[data-restore-id]').forEach((button) =>
    button.addEventListener('click', async () => {
      button.disabled = true;
      try {
        const res = await fetch(`/api/listings/${button.dataset.restoreId}`, {
          method: 'PATCH',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ restore: true }),
        });
        if (res.ok) window.location.reload();
        else alert('復元できませんでした');
      } finally {
        button.disabled = false;
      }
    })
  );
</script>
