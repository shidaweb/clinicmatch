---
export const prerender = false;

import AccountLayout from '~/layouts/AccountLayout.astro';
import { getProfile } from '~/lib/auth';
import { createSupabaseServerClient } from '~/lib/supabase/server';
import { POST_STATUS_LABELS } from '~/lib/marketplace';

const profile = await getProfile(Astro.cookies, Astro.locals as never);
if (!profile) return Astro.redirect('/auth/login');

const supabase = createSupabaseServerClient(Astro.cookies, Astro.locals as never);
const { data: listings } = await supabase
  .from('listings')
  .select('id, maker, model, status, created_at')
  .eq('seller_org_id', profile.org_id)
  .order('created_at', { ascending: false });

const metadata = { title: '売りたい一覧' };
const draftSaved = Astro.url.searchParams.has('draft');
---

<AccountLayout metadata={metadata} title="売りたい一覧" maxWidth="4xl">
  {draftSaved && (
    <p class="mb-4 rounded-xl border border-sage/30 bg-sage/10 px-4 py-3 text-sm text-plum">
      下書きを保存しました。内容を確認のうえ、審査に提出できます。
    </p>
  )}
  <a href="/account/listings/new" slot="actions" class="cm-btn-primary text-sm !px-4 !py-2">+ 新規出品</a>
  <ul class="space-y-3">
    {(listings ?? []).map((item) => (
      <li class="cm-list-item flex justify-between items-center gap-3">
        <span class="text-plum">{item.maker} {item.model}</span>
        <div class="flex items-center gap-3">
          <span class="text-sm text-plum-soft">{POST_STATUS_LABELS[item.status] ?? item.status}</span>
          {item.status !== 'published' && (
            <a href={`/account/listings/${item.id}/edit`} class="cm-link">編集</a>
          )}
        </div>
      </li>
    ))}
  </ul>
</AccountLayout>
