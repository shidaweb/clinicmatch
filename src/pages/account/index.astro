---
export const prerender = false;

import AccountLayout from '~/layouts/AccountLayout.astro';
import { getProfile } from '~/lib/auth';
import { createSupabaseServerClient } from '~/lib/supabase/server';
import { POST_STATUS_LABELS } from '~/lib/marketplace';
import { hasSupabaseConfig } from '~/lib/env';

const profile = await getProfile(Astro.cookies, Astro.locals as never);
if (!profile) return Astro.redirect('/auth/login');

let listings: Array<{ id: string; maker: string; model: string; status: string }> = [];
let wanted: Array<{ id: string; category_slug: string; status: string }> = [];
let approachesCount = 0;
let threadsCount = 0;

if (hasSupabaseConfig(Astro.locals as never)) {
  const supabase = createSupabaseServerClient(Astro.cookies, Astro.locals as never);
  const [{ data: myListings }, { data: myWanted }, { count: approachCount }, { count: threadCount }] = await Promise.all([
    supabase.from('listings').select('id, maker, model, status').eq('seller_org_id', profile.org_id).order('created_at', { ascending: false }).limit(5),
    supabase.from('wanted_requests').select('id, category_slug, status').eq('buyer_org_id', profile.org_id).order('created_at', { ascending: false }).limit(5),
    supabase.from('approaches').select('*', { count: 'exact', head: true }).or(`from_org_id.eq.${profile.org_id}`),
    supabase.from('threads').select('*', { count: 'exact', head: true }).or(`buyer_org_id.eq.${profile.org_id},seller_org_id.eq.${profile.org_id}`),
  ]);
  listings = myListings ?? [];
  wanted = myWanted ?? [];
  approachesCount = approachCount ?? 0;
  threadsCount = threadCount ?? 0;
}

const metadata = { title: 'マイページ' };
const org = profile.organizations as { prefecture?: string; city?: string } | null;
---

<AccountLayout metadata={metadata} showNav={true}>
  <header class="mb-8">
    <p class="cm-eyebrow mb-2">My Page</p>
    <h1 class="cm-heading text-3xl font-bold">マイページ</h1>
    <p class="mt-2 text-plum-soft">{org?.prefecture}{org?.city} — {profile.full_name ?? '担当者'}</p>
  </header>

  <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-4">
    <a href="/account/listings/new" class="cm-card p-5 hover:shadow-lg transition border-rose/25">
      <p class="text-sm font-semibold text-rose">売りたいを出す</p>
    </a>
    <a href="/account/wanted/new" class="cm-card p-5 hover:shadow-lg transition border-gold/30">
      <p class="text-sm font-semibold text-gold">買いたいを出す</p>
    </a>
    <a href="/account/threads" class="cm-card p-5 hover:shadow-lg transition">
      <p class="text-sm font-semibold text-plum">メッセージ</p>
      <p class="text-2xl font-heading font-bold text-rose mt-1 tabular-nums">{threadsCount}</p>
    </a>
    <a href="/account/deals" class="cm-card p-5 hover:shadow-lg transition">
      <p class="text-sm font-semibold text-plum">契約・請求</p>
    </a>
  </div>

  <div class="mt-4">
    <a href="/account/approaches" class="cm-link">アプローチ一覧（{approachesCount}件）</a>
  </div>

  <div class="mt-10 grid lg:grid-cols-2 gap-8">
    <div>
      <div class="flex items-center justify-between mb-4">
        <h2 class="font-heading text-lg font-semibold text-plum">売りたい</h2>
        <a href="/account/listings" class="cm-link">すべて</a>
      </div>
      <ul class="space-y-3">
        {
          listings.length ? listings.map((item) => (
            <li class="cm-list-item flex justify-between gap-3">
              <span class="text-sm text-plum">{item.maker} {item.model}</span>
              <span class="text-xs text-plum-soft">{POST_STATUS_LABELS[item.status] ?? item.status}</span>
            </li>
          )) : (
            <li class="text-sm text-plum-soft">まだ出品がありません</li>
          )
        }
      </ul>
    </div>

    <div>
      <div class="flex items-center justify-between mb-4">
        <h2 class="font-heading text-lg font-semibold text-plum">買いたい</h2>
        <a href="/account/wanted" class="cm-link">すべて</a>
      </div>
      <ul class="space-y-3">
        {
          wanted.length ? wanted.map((item) => (
            <li class="cm-list-item flex justify-between gap-3">
              <span class="text-sm text-plum">{item.category_slug}</span>
              <span class="text-xs text-plum-soft">{POST_STATUS_LABELS[item.status] ?? item.status}</span>
            </li>
          )) : (
            <li class="text-sm text-plum-soft">まだ買いたいがありません</li>
          )
        }
      </ul>
    </div>
  </div>

  {
    profile.role === 'admin' && (
      <div class="mt-10">
        <a href="/admin" class="cm-link font-medium">運営管理画面へ →</a>
      </div>
    )
  }
</AccountLayout>
