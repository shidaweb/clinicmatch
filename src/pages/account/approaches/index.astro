---
export const prerender = false;

import AccountLayout from '~/layouts/AccountLayout.astro';
import { getProfile } from '~/lib/auth';
import { createSupabaseServerClient } from '~/lib/supabase/server';

const profile = await getProfile(Astro.cookies, Astro.locals as never);
if (!profile) return Astro.redirect('/auth/login');

const supabase = createSupabaseServerClient(Astro.cookies, Astro.locals as never);
const { data: approaches } = await supabase
  .from('approaches')
  .select('id, kind, status, message, created_at, listing_id, wanted_request_id')
  .order('created_at', { ascending: false })
  .limit(50);

const metadata = { title: 'アプローチ' };
---

<AccountLayout metadata={metadata} title="アプローチ" maxWidth="4xl">
  <ul class="space-y-3">
    {(approaches ?? []).map((item) => (
      <li class="cm-list-item">
        <div class="flex justify-between text-sm">
          <span class="font-medium text-plum">{item.kind === 'interest' ? '関心（買い手→出品）' : '提案（売り手→買いたい）'}</span>
          <span class="text-plum-soft">{item.status}</span>
        </div>
        {item.message && <p class="mt-2 text-sm text-plum-soft">{item.message}</p>}
      </li>
    ))}
  </ul>
</AccountLayout>
