---
export const prerender = false;

import AccountLayout from '~/layouts/AccountLayout.astro';
import { getProfile } from '~/lib/auth';
import { createSupabaseServerClient } from '~/lib/supabase/server';

const profile = await getProfile(Astro.cookies, Astro.locals as never);
if (!profile) return Astro.redirect('/auth/login');

const supabase = createSupabaseServerClient(Astro.cookies, Astro.locals as never);
const { data: threads } = await supabase
  .from('threads')
  .select('id, kind, subject_type, contact_disclosed, status, created_at, listing_id, wanted_request_id')
  .or(`buyer_org_id.eq.${profile.org_id},seller_org_id.eq.${profile.org_id}`)
  .order('created_at', { ascending: false });

const metadata = { title: 'メッセージ' };
---

<AccountLayout metadata={metadata} title="メッセージ" maxWidth="3xl">
  <ul class="space-y-3">
    {
      (threads ?? []).length ? (
        threads!.map((t) => (
          <li>
            <a href={`/account/threads/${t.id}`} class="block cm-list-item hover:shadow-sm transition">
              <div class="flex justify-between items-start gap-3">
                <div>
                  <span class:list={[
                    'inline-flex rounded-full px-2 py-0.5 text-xs font-semibold text-white',
                    t.kind === 'qa' ? 'bg-rose' : 'bg-gold',
                  ]}>
                    {t.kind === 'qa' ? 'コメント' : '仲介'}
                  </span>
                  <p class="mt-2 text-sm text-plum">
                    {t.subject_type === 'listing' ? '売りたい出品' : '買いたいリクエスト'} に関するスレッド
                  </p>
                </div>
                <div class="text-right text-xs text-plum-soft">
                  <p>{t.status === 'open' ? '進行中' : '終了'}</p>
                  {t.contact_disclosed && <p class="text-rose mt-1">連絡先開示済</p>}
                </div>
              </div>
            </a>
          </li>
        ))
      ) : (
        <li class="text-sm text-plum-soft">進行中のスレッドはありません</li>
      )
    }
  </ul>
</AccountLayout>
