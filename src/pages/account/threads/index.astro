---
export const prerender = false;

import Layout from '~/layouts/PageLayout.astro';
import { getProfile } from '~/lib/auth';
import { createSupabaseServerClient } from '~/lib/supabase/server';

const profile = await getProfile(Astro.cookies, Astro.locals as never);
if (!profile) return Astro.redirect('/auth/login');

const supabase = createSupabaseServerClient(Astro.cookies, Astro.locals as never);
const { data: threads } = await supabase
  .from('threads')
  .select('id, kind, subject_type, contact_disclosed, status, created_at, listing_id, wanted_request_id')
  .or(`buyer_org_id.eq.${profile.org_id},seller_org_id.eq.${profile.org_id}`)
  .order('created_at', { ascending: false });

const metadata = { title: 'メッセージ' };
---

<Layout metadata={metadata}>
  <section class="py-12 md:py-16">
    <div class="max-w-3xl mx-auto px-4 sm:px-6">
      <h1 class="text-2xl font-bold text-text mb-6">メッセージ</h1>
      <ul class="space-y-3">
        {
          (threads ?? []).length ? (
            threads!.map((t) => (
              <li>
                <a href={`/account/threads/${t.id}`} class="block rounded-xl border border-border p-4 hover:shadow-sm transition">
                  <div class="flex justify-between items-start gap-3">
                    <div>
                      <span class:list={[
                        'inline-flex rounded-full px-2 py-0.5 text-xs font-semibold text-white',
                        t.kind === 'qa' ? 'bg-brand-600' : 'bg-accent-market',
                      ]}>
                        {t.kind === 'qa' ? 'Q&A' : '仲介'}
                      </span>
                      <p class="mt-2 text-sm text-text">
                        {t.subject_type === 'listing' ? '売りたい出品' : '買いたいリクエスト'} に関するスレッド
                      </p>
                    </div>
                    <div class="text-right text-xs text-text-muted">
                      <p>{t.status === 'open' ? '進行中' : '終了'}</p>
                      {t.contact_disclosed && <p class="text-accent-market mt-1">連絡先開示済</p>}
                    </div>
                  </div>
                </a>
              </li>
            ))
          ) : (
            <li class="text-sm text-text-muted">進行中のスレッドはありません</li>
          )
        }
      </ul>
    </div>
  </section>
</Layout>
