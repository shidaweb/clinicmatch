---
export const prerender = false;

import AccountLayout from '~/layouts/AccountLayout.astro';
import MessageThread from '~/components/MessageThread';
import ContactCard from '~/components/ContactCard.astro';
import { getProfile } from '~/lib/auth';
import { createSupabaseServerClient, createSupabaseAdminClient } from '~/lib/supabase/server';
import type { MessageRow } from '~/lib/threads';

const profile = await getProfile(Astro.cookies, Astro.locals as never);
if (!profile) return Astro.redirect('/auth/login');

const { id } = Astro.params;
if (!id) return Astro.redirect('/account/threads');

const supabase = createSupabaseServerClient(Astro.cookies, Astro.locals as never);
const { data: thread } = await supabase
  .from('threads')
  .select('*')
  .eq('id', id)
  .single();

if (!thread) return Astro.redirect('/account/threads');

const isParticipant =
  thread.buyer_org_id === profile.org_id || thread.seller_org_id === profile.org_id;
const isAdmin = profile.role === 'admin';
if (!isParticipant && !isAdmin) return Astro.redirect('/account/threads');

const { data: messages } = await supabase
  .from('messages')
  .select('id, thread_id, sender_type, sender_user_id, body, visible_to, created_at')
  .eq('thread_id', id)
  .order('created_at', { ascending: true });

let counterpart: {
  name: string;
  full_name?: string | null;
  phone?: string | null;
  contact_email?: string | null;
  prefecture?: string;
  city?: string;
} | null = null;
let participants: {
  buyer?: { displayName: string; avatarUrl: string | null };
  seller?: { displayName: string; avatarUrl: string | null };
} = {};

const supabaseUrl = import.meta.env.PUBLIC_SUPABASE_URL ?? '';
const admin = createSupabaseAdminClient(Astro.locals as never);

const [{ data: buyerProfile }, { data: sellerProfile }] = await Promise.all([
  admin
    .from('profiles')
    .select('display_name, avatar_path')
    .eq('org_id', thread.buyer_org_id)
    .limit(1)
    .maybeSingle(),
  admin
    .from('profiles')
    .select('display_name, avatar_path')
    .eq('org_id', thread.seller_org_id)
    .limit(1)
    .maybeSingle(),
]);

participants = {
  buyer: {
    displayName: buyerProfile?.display_name ?? '買い手',
    avatarUrl:
      buyerProfile?.avatar_path && supabaseUrl
        ? `${supabaseUrl}/storage/v1/object/public/avatars/${buyerProfile.avatar_path}`
        : null,
  },
  seller: {
    displayName: sellerProfile?.display_name ?? '売り手',
    avatarUrl:
      sellerProfile?.avatar_path && supabaseUrl
        ? `${supabaseUrl}/storage/v1/object/public/avatars/${sellerProfile.avatar_path}`
        : null,
  },
};

if (thread.contact_disclosed && isParticipant) {
  const counterpartOrgId =
    profile.org_id === thread.buyer_org_id ? thread.seller_org_id : thread.buyer_org_id;

  const { data: org } = await admin
    .from('organizations')
    .select('name, phone, contact_email, prefecture, city')
    .eq('id', counterpartOrgId)
    .single();

  const { data: counterpartProfile } = await admin
    .from('profiles')
    .select('full_name')
    .eq('org_id', counterpartOrgId)
    .limit(1)
    .maybeSingle();

  if (org) {
    counterpart = {
      name: org.name,
      full_name: counterpartProfile?.full_name,
      phone: org.phone,
      contact_email: org.contact_email,
      prefecture: org.prefecture,
      city: org.city,
    };
  }
}

const threadTitle = thread.kind === 'qa' ? 'コメント（取引相談）' : '仲介メッセージ';
const threadSubtitle = thread.kind === 'mediation' ? '運営が仲介中です。匿名のままやり取りできます。' : undefined;
const metadata = { title: thread.kind === 'qa' ? 'コメント（取引相談）' : '仲介メッセージ' };
---

<AccountLayout metadata={metadata} title={threadTitle} subtitle={threadSubtitle} maxWidth="3xl">
  <a href="/account/threads" class="cm-link text-sm mb-6 inline-block">← メッセージ一覧</a>

  {
    thread.contact_disclosed && (
      <div class="mb-6">
        <ContactCard disclosed={true} counterpart={counterpart} />
      </div>
    )
  }

  <MessageThread
    client:load
    threadId={id}
    initialMessages={(messages ?? []) as MessageRow[]}
    viewerOrgId={profile.org_id}
    buyerOrgId={thread.buyer_org_id}
    sellerOrgId={thread.seller_org_id}
    isAdmin={isAdmin}
    threadClosed={thread.status === 'closed'}
    participants={participants}
  />
</AccountLayout>
