---
export const prerender = false;

import AccountLayout from '~/layouts/AccountLayout.astro';
import { getProfile } from '~/lib/auth';
import { createSupabaseServerClient } from '~/lib/supabase/server';
import { PREFECTURES, POST_STATUS_LABELS } from '~/lib/marketplace';

const profile = await getProfile(Astro.cookies, Astro.locals as never);
if (!profile) return Astro.redirect('/auth/login');

const { id } = Astro.params;
if (!id) return Astro.redirect('/account/wanted');

const supabase = createSupabaseServerClient(Astro.cookies, Astro.locals as never);
const { data: wanted } = await supabase
  .from('wanted_requests')
  .select('*')
  .eq('id', id)
  .eq('buyer_org_id', profile.org_id)
  .single();

if (!wanted) return Astro.redirect('/account/wanted');

const org = profile.organizations as { prefecture?: string; city?: string } | null;
const metadata = { title: '買いたいを編集' };
---

<AccountLayout
  metadata={metadata}
  title="買いたいを編集"
  subtitle={`ステータス: ${POST_STATUS_LABELS[wanted.status] ?? wanted.status}`}
  maxWidth="2xl"
>
  <a href="/account/wanted" class="cm-link text-sm mb-6 inline-block">← 買いたい一覧</a>

  <form id="wanted-form" class="cm-card p-6 space-y-4">
    <div>
      <label class="cm-label">カテゴリ</label>
      <select name="category_slug" required class="cm-input">
        {['hair-removal','pico-laser','ipl','hifu','rf','body'].map((slug) => (
          <option value={slug} selected={wanted.category_slug === slug}>{slug}</option>
        ))}
      </select>
    </div>
    <div class="grid sm:grid-cols-2 gap-4">
      <div>
        <label class="cm-label">メーカー</label>
        <input name="maker" value={wanted.maker ?? ''} class="cm-input" />
      </div>
      <div>
        <label class="cm-label">型番</label>
        <input name="model" value={wanted.model ?? ''} class="cm-input" />
      </div>
    </div>
    <div class="grid sm:grid-cols-2 gap-4">
      <div>
        <label class="cm-label">予算（円）</label>
        <input name="budget" type="number" value={wanted.budget ?? ''} class="cm-input" />
      </div>
      <div>
        <label class="cm-label">希望時期</label>
        <input name="desired_timing" value={wanted.desired_timing ?? ''} class="cm-input" />
      </div>
    </div>
    <div class="grid sm:grid-cols-2 gap-4">
      <div>
        <label class="cm-label">希望エリア（都道府県）</label>
        <select name="area_prefecture" class="cm-input">
          {PREFECTURES.map((pref) => (
            <option value={pref} selected={pref === (wanted.area_prefecture ?? org?.prefecture)}>{pref}</option>
          ))}
        </select>
      </div>
      <div>
        <label class="cm-label">市区町村</label>
        <input name="area_city" value={wanted.area_city ?? org?.city ?? ''} class="cm-input" />
      </div>
    </div>
    <div>
      <label class="cm-label">要件</label>
      <textarea name="requirements" rows="4" class="cm-input">{wanted.requirements ?? ''}</textarea>
    </div>
    <div class="flex gap-3">
      <button type="submit" name="action" value="draft" class="rounded-xl border border-line px-5 py-2.5 text-sm text-plum">保存</button>
      <button type="submit" name="action" value="submit" class="cm-btn-primary">審査に提出</button>
    </div>
    <p id="wanted-status" class="text-sm text-plum-soft hidden"></p>
  </form>
</AccountLayout>

<script define:vars={{ wantedId: wanted.id }}>
  const form = document.getElementById('wanted-form');
  const status = document.getElementById('wanted-status');
  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const submitter = e.submitter?.value ?? 'draft';
    const data = Object.fromEntries(new FormData(form));
    data.submit = submitter === 'submit';
    status.classList.remove('hidden');
    status.textContent = '保存中…';
    const res = await fetch(`/api/wanted/${wantedId}`, {
      method: 'PATCH',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(data),
    });
    const json = await res.json();
    status.textContent = res.ok ? '保存しました' : (json.error ?? '失敗しました');
    if (res.ok && submitter === 'submit') window.location.href = '/account/wanted';
  });
</script>
