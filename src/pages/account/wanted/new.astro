---
export const prerender = false;

import AccountLayout from '~/layouts/AccountLayout.astro';
import { getProfile } from '~/lib/auth';
import { PREFECTURES } from '~/lib/marketplace';
import { MARKET_CATEGORIES } from '~/lib/categories';

const profile = await getProfile(Astro.cookies, Astro.locals as never);
if (!profile) return Astro.redirect('/auth/login');

const org = profile.organizations as { prefecture?: string; city?: string } | null;
const metadata = { title: '買いたいを出す' };
---

<AccountLayout metadata={metadata} title="買いたいを出す" maxWidth="2xl">
  <form id="wanted-form" class="cm-card p-6 space-y-4">
    <section>
      <p class="cm-label">参考画像（任意）</p>
      <input id="wanted-image-input" type="file" accept="image/jpeg,image/png,image/webp" hidden />
      <button
        id="wanted-image-trigger"
        type="button"
        class="mt-2 w-full rounded-xl border border-dashed border-line bg-ivory px-4 py-6 text-sm text-plum-soft hover:bg-cream"
      >
        欲しい機種のカタログ画像などを追加
      </button>
      <div id="wanted-image-preview" class="mt-3 hidden">
        <div class="relative w-32 overflow-hidden rounded-xl border border-line bg-cream">
          <img id="wanted-image-preview-img" src="" alt="参考画像プレビュー" class="h-24 w-full object-cover" />
          <button
            id="wanted-image-remove"
            type="button"
            class="absolute right-1 top-1 rounded-full bg-plum/80 px-1.5 py-0.5 text-[10px] text-white"
          >
            ×
          </button>
        </div>
      </div>
      <p class="mt-2 text-xs text-plum-soft">JPEG / PNG / WebP（8MB以下）</p>
      <p id="wanted-image-error" class="mt-1 text-xs text-danger hidden"></p>
    </section>
    <div>
      <label class="cm-label">カテゴリ（必須）</label>
      <select name="category_slug" required class="cm-input">
        {MARKET_CATEGORIES.map((c) => (
          <option value={c.slug}>{c.name}</option>
        ))}
      </select>
    </div>
    <div class="grid sm:grid-cols-2 gap-4">
      <div>
        <label class="cm-label">メーカー（任意）</label>
        <input id="wanted-maker" name="maker" class="cm-input" />
      </div>
      <div>
        <label class="cm-label">機種名（任意）</label>
        <input id="wanted-model" name="model" class="cm-input" />
      </div>
    </div>
    <div>
      <label class="cm-label">希望する出品種別</label>
      <select id="wanted-listing-kind" name="listing_kind_pref" class="cm-input">
        <option value="device">機器本体</option>
        <option value="consumable_valid">消耗品（期限内）</option>
        <option value="consumable_expired">消耗品（期限切れ・研修用）</option>
      </select>
    </div>
    <section id="wanted-consumable-fields" class="hidden rounded-card border border-line bg-cream p-4 space-y-4">
      <div>
        <label class="cm-label">希望消耗品</label>
        <select id="wanted-consumable-master-id" name="consumable_master_id" class="cm-input">
          <option value="">メーカー・機種名に紐づく品目を選択</option>
        </select>
      </div>
      <div class="grid sm:grid-cols-2 gap-4">
        <label class="inline-flex items-center gap-2 text-sm">
          <input type="checkbox" name="only_unexpired" value="true" />
          期限内のみ希望
        </label>
        <div>
          <label class="cm-label">最低残ショット数（任意）</label>
          <input name="min_remaining_shots" type="number" min="0" class="cm-input" />
        </div>
      </div>
      <div>
        <label class="cm-label">開封状態の希望</label>
        <select name="open_state_pref" class="cm-input">
          <option value="">指定なし</option>
          <option value="sealed_only">未開封のみ</option>
          <option value="opened_allowed">開封済み可（使用済み不可）</option>
          <option value="used_allowed">使用済み可</option>
        </select>
      </div>
    </section>
    <div class="grid sm:grid-cols-2 gap-4">
      <div>
        <label class="cm-label">予算（円）</label>
        <input name="budget" type="number" class="cm-input" />
      </div>
      <div>
        <label class="cm-label">希望時期</label>
        <input name="desired_timing" placeholder="例：3ヶ月以内" class="cm-input" />
      </div>
    </div>
    <div class="grid sm:grid-cols-2 gap-4">
      <div>
        <label class="cm-label">希望エリア（都道府県）</label>
        <select name="area_prefecture" class="cm-input">
          {PREFECTURES.map((pref) => (
            <option value={pref} selected={pref === org?.prefecture}>{pref}</option>
          ))}
        </select>
      </div>
      <div>
        <label class="cm-label">市区町村</label>
        <input name="area_city" value={org?.city ?? ''} class="cm-input" />
      </div>
    </div>
    <div>
      <label class="cm-label">要件・補足</label>
      <textarea name="requirements" rows="4" class="cm-input"></textarea>
    </div>
    <div class="flex gap-3">
      <button type="submit" name="action" value="draft" class="rounded-xl border border-line px-5 py-2.5 text-sm text-plum">下書き保存</button>
      <button type="submit" name="action" value="submit" class="cm-btn-primary">審査に提出</button>
    </div>
    <p id="wanted-status" class="text-sm text-plum-soft hidden"></p>
  </form>
</AccountLayout>

<script>
  type ConsumableMaster = { id: string; name: string };
  const form = document.getElementById('wanted-form') as HTMLFormElement;
  const status = document.getElementById('wanted-status');
  const imageInput = document.getElementById('wanted-image-input') as HTMLInputElement;
  const imageTrigger = document.getElementById('wanted-image-trigger');
  const imagePreview = document.getElementById('wanted-image-preview');
  const imagePreviewImg = document.getElementById('wanted-image-preview-img') as HTMLImageElement;
  const imageRemove = document.getElementById('wanted-image-remove');
  const imageError = document.getElementById('wanted-image-error');
  const categorySelect = form?.querySelector('select[name="category_slug"]') as HTMLSelectElement | null;
  const makerInput = document.getElementById('wanted-maker') as HTMLInputElement | null;
  const modelInput = document.getElementById('wanted-model') as HTMLInputElement | null;
  const listingKindSelect = document.getElementById('wanted-listing-kind') as HTMLSelectElement | null;
  const consumableSection = document.getElementById('wanted-consumable-fields') as HTMLElement | null;
  const masterSelect = document.getElementById('wanted-consumable-master-id') as HTMLSelectElement | null;

  let wantedId = '';
  let referenceImage: File | null = null;
  let imagePreviewUrl = '';
  let masterItems: ConsumableMaster[] = [];

  const showImageError = (message: string) => {
    imageError?.classList.remove('hidden');
    if (imageError) imageError.textContent = message;
  };
  const clearImageError = () => {
    imageError?.classList.add('hidden');
    if (imageError) imageError.textContent = '';
  };

  imageTrigger?.addEventListener('click', () => imageInput?.click());
  imageInput?.addEventListener('change', () => {
    clearImageError();
    const file = imageInput.files?.[0];
    if (!file) return;
    if (!['image/jpeg', 'image/png', 'image/webp'].includes(file.type)) {
      showImageError('JPEG / PNG / WebP のみ登録できます。');
      return;
    }
    if (file.size > 8 * 1024 * 1024) {
      showImageError('画像サイズは8MB以下にしてください。');
      return;
    }
    referenceImage = file;
    if (imagePreviewUrl) URL.revokeObjectURL(imagePreviewUrl);
    imagePreviewUrl = URL.createObjectURL(file);
    imagePreviewImg.src = imagePreviewUrl;
    imagePreview?.classList.remove('hidden');
    imageInput.value = '';
  });

  imageRemove?.addEventListener('click', () => {
    referenceImage = null;
    if (imagePreviewUrl) URL.revokeObjectURL(imagePreviewUrl);
    imagePreviewUrl = '';
    imagePreview?.classList.add('hidden');
    imagePreviewImg.src = '';
  });

  const isConsumable = () => (listingKindSelect?.value ?? 'device') !== 'device';
  const syncConsumableVisibility = () => {
    const visible = isConsumable();
    consumableSection?.classList.toggle('hidden', !visible);
    if (masterSelect) masterSelect.required = visible;
  };
  const renderMasterOptions = () => {
    if (!masterSelect) return;
    masterSelect.innerHTML = '<option value="">メーカー・機種名に紐づく品目を選択</option>';
    for (const item of masterItems) {
      const option = document.createElement('option');
      option.value = item.id;
      option.textContent = item.name;
      masterSelect.appendChild(option);
    }
  };
  const loadMasterOptions = async () => {
    if (!isConsumable()) return;
    const params = new URLSearchParams();
    if (categorySelect?.value) params.set('category', categorySelect.value);
    if (makerInput?.value.trim()) params.set('maker', makerInput.value.trim());
    if (modelInput?.value.trim()) params.set('model', modelInput.value.trim());
    const res = await fetch(`/api/consumables/master?${params.toString()}`);
    const json = (await res.json().catch(() => ({ items: [] }))) as { items?: ConsumableMaster[] };
    masterItems = json.items ?? [];
    renderMasterOptions();
  };
  listingKindSelect?.addEventListener('change', async () => {
    syncConsumableVisibility();
    await loadMasterOptions();
  });
  categorySelect?.addEventListener('change', loadMasterOptions);
  makerInput?.addEventListener('change', loadMasterOptions);
  modelInput?.addEventListener('change', loadMasterOptions);

  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    if (!status) return;
    const submitter = (event.submitter as HTMLButtonElement | null)?.value ?? 'draft';
    const submit = submitter === 'submit';
    const fd = new FormData(form);
    const data = Object.fromEntries(fd);
    data.only_unexpired = fd.has('only_unexpired');
    data.submit = false;

    status.classList.remove('hidden');
    status.classList.remove('text-danger');
    status.textContent = submit ? '申請を準備中…' : '下書き保存中…';

    try {
      if (!wantedId) {
        const createRes = await fetch('/api/wanted', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(data),
        });
        const createJson = await createRes.json();
        if (!createRes.ok) throw new Error(createJson.error ?? '保存に失敗しました');
        wantedId = createJson.id;
      } else {
        const patchRes = await fetch(`/api/wanted/${wantedId}`, {
          method: 'PATCH',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(data),
        });
        const patchJson = await patchRes.json();
        if (!patchRes.ok) throw new Error(patchJson.error ?? '保存に失敗しました');
      }

      if (referenceImage) {
        status.textContent = '参考画像をアップロード中…';
        const fd = new FormData();
        fd.append('file', referenceImage);
        const imageRes = await fetch(`/api/wanted/${wantedId}`, { method: 'POST', body: fd });
        const imageJson = await imageRes.json();
        if (!imageRes.ok) throw new Error(imageJson.error ?? '画像アップロードに失敗しました');
        referenceImage = null;
      }

      if (submit) {
        const submitRes = await fetch(`/api/wanted/${wantedId}`, {
          method: 'PATCH',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ ...data, submit: true }),
        });
        const submitJson = await submitRes.json();
        if (!submitRes.ok) throw new Error(submitJson.error ?? '審査提出に失敗しました');
      }

      window.location.href = submit ? '/account/wanted/thanks' : '/account/wanted?draft=1';
    } catch (error) {
      status.textContent = error instanceof Error ? error.message : '保存に失敗しました';
      status.classList.add('text-danger');
    }
  });

  syncConsumableVisibility();
  loadMasterOptions();
</script>
