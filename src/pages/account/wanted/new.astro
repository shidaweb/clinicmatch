---
export const prerender = false;

import Layout from '~/layouts/PageLayout.astro';
import { getProfile } from '~/lib/auth';
import { PREFECTURES } from '~/lib/marketplace';

const profile = await getProfile(Astro.cookies, Astro.locals as never);
if (!profile) return Astro.redirect('/auth/login');

const org = profile.organizations as { prefecture?: string; city?: string } | null;
const metadata = { title: '買いたいを出す' };
---

<Layout metadata={metadata}>
  <section class="py-12 md:py-16">
    <div class="max-w-2xl mx-auto px-4 sm:px-6">
      <h1 class="text-3xl font-bold text-buy mb-6">買いたいを出す</h1>

      <form id="wanted-form" class="rounded-xl border border-border bg-surface p-6 space-y-4">
        <div>
          <label class="block text-sm font-medium mb-1">カテゴリ（必須）</label>
          <select name="category_slug" required class="w-full rounded-xl border border-border px-3 py-2 text-sm">
            <option value="hair-removal">脱毛</option>
            <option value="pico-laser">ピコレーザー</option>
            <option value="ipl">IPL・光治療</option>
            <option value="hifu">HIFU</option>
            <option value="rf">RF・高周波</option>
            <option value="body">痩身・ボディ</option>
          </select>
        </div>
        <div class="grid sm:grid-cols-2 gap-4">
          <div>
            <label class="block text-sm font-medium mb-1">メーカー（任意）</label>
            <input name="maker" class="w-full rounded-xl border border-border px-3 py-2 text-sm" />
          </div>
          <div>
            <label class="block text-sm font-medium mb-1">型番（任意）</label>
            <input name="model" class="w-full rounded-xl border border-border px-3 py-2 text-sm" />
          </div>
        </div>
        <div class="grid sm:grid-cols-2 gap-4">
          <div>
            <label class="block text-sm font-medium mb-1">予算（円）</label>
            <input name="budget" type="number" class="w-full rounded-xl border border-border px-3 py-2 text-sm" />
          </div>
          <div>
            <label class="block text-sm font-medium mb-1">希望時期</label>
            <input name="desired_timing" placeholder="例：3ヶ月以内" class="w-full rounded-xl border border-border px-3 py-2 text-sm" />
          </div>
        </div>
        <div class="grid sm:grid-cols-2 gap-4">
          <div>
            <label class="block text-sm font-medium mb-1">希望エリア（都道府県）</label>
            <select name="area_prefecture" class="w-full rounded-xl border border-border px-3 py-2 text-sm">
              {PREFECTURES.map((pref) => (
                <option value={pref} selected={pref === org?.prefecture}>{pref}</option>
              ))}
            </select>
          </div>
          <div>
            <label class="block text-sm font-medium mb-1">市区町村</label>
            <input name="area_city" value={org?.city ?? ''} class="w-full rounded-xl border border-border px-3 py-2 text-sm" />
          </div>
        </div>
        <div>
          <label class="block text-sm font-medium mb-1">要件・補足</label>
          <textarea name="requirements" rows="4" class="w-full rounded-xl border border-border px-3 py-2 text-sm"></textarea>
        </div>
        <div class="flex gap-3">
          <button type="submit" name="action" value="draft" class="rounded-xl border border-border px-5 py-2.5 text-sm">下書き保存</button>
          <button type="submit" name="action" value="submit" class="btn-market-buy px-5 py-2.5 text-sm">審査に提出</button>
        </div>
        <p id="wanted-status" class="text-sm text-text-muted hidden"></p>
      </form>
    </div>
  </section>
</Layout>

<script>
  const form = document.getElementById('wanted-form') as HTMLFormElement;
  const status = document.getElementById('wanted-status');

  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    if (!status) return;
    const submitter = (event.submitter as HTMLButtonElement | null)?.value ?? 'draft';
    const data = Object.fromEntries(new FormData(form));
    data.submit = submitter === 'submit';

    status.classList.remove('hidden');
    status.textContent = '保存中…';

    const res = await fetch('/api/wanted', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(data),
    });
    const json = await res.json();
    status.textContent = res.ok ? '保存しました。' : (json.error ?? '保存に失敗しました');
    if (res.ok) window.location.href = '/account';
  });
</script>

<style>
  .btn-market-buy {
    @apply inline-flex items-center justify-center rounded-xl bg-buy font-semibold text-white hover:opacity-90 transition;
  }
</style>
