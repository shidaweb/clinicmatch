---
export const prerender = false;

import Layout from '~/layouts/PageLayout.astro';
import ConsultForm from '~/components/ConsultForm.astro';

const relatedListingId = Astro.url.searchParams.get('listing') ?? undefined;
const relatedWantedId = Astro.url.searchParams.get('wanted') ?? undefined;
const defaultTopic = relatedListingId ? 'sell' : relatedWantedId ? 'buy' : 'sell';

const metadata = {
  title: '出品・購入を相談する',
  description: '売りたい・買いたいのご相談は匿名でもOK。運営が仲介します。',
};
---

<Layout metadata={metadata}>
  <section class="py-12 md:py-16 bg-surface-muted">
    <div class="max-w-3xl mx-auto px-4 sm:px-6">
      <h1 class="text-3xl font-bold text-text mb-3">出品・購入を相談する</h1>
      <p class="text-text-muted mb-8 leading-relaxed">
        売り手・買い手どちらからでもご相談いただけます。お名前や連絡先は任意です（匿名相談OK）。
        自己登録が難しい場合も、こちらから運営がサポートします。
      </p>
      <div class="rounded-xl border border-border bg-surface p-6 shadow-sm">
        <ConsultForm
          relatedListingId={relatedListingId}
          relatedWantedId={relatedWantedId}
          defaultTopic={defaultTopic as 'sell' | 'buy' | 'other'}
        />
      </div>
    </div>
  </section>
</Layout>
