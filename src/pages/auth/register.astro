---
export const prerender = false;

import Layout from '~/layouts/PageLayout.astro';
import { createSupabaseServerClient } from '~/lib/supabase/server';
import { hasSupabaseConfig } from '~/lib/env';
import { PREFECTURES } from '~/lib/marketplace';

const sessionUser = hasSupabaseConfig(Astro.locals as never)
  ? (await createSupabaseServerClient(Astro.cookies, Astro.locals as never).auth.getUser()).data.user
  : null;
const resuming = Boolean(sessionUser && Astro.url.searchParams.has('complete'));
const metadata = { title: '会員登録' };
const initialTradeSide = ['sell', 'buy', 'both'].includes(Astro.url.searchParams.get('trade_side') ?? '')
  ? (Astro.url.searchParams.get('trade_side') as 'sell' | 'buy' | 'both')
  : 'both';
---

<Layout metadata={metadata}>
  <section class="py-12 md:py-16 bg-cream">
    <div class="max-w-lg mx-auto px-4 sm:px-6">
      <h1 class="cm-heading text-3xl font-bold mb-2">{resuming ? '会員情報の登録を再開' : '会員登録'}</h1>
      <p class="text-plum-soft mb-2">
        登録すると、機器の出品・購入希望の投稿と、相手との<strong>コメント（取引相談）</strong>ができます。
      </p>
      <p class="text-plum-soft mb-8 text-sm">
        登録後、運営が投稿内容と取引条件を確認し、売り手・買い手の間を仲介します。法人番号の入力だけでは法人確認は完了しません。
      </p>

      <form data-resuming={resuming} id="register-form" class="cm-card p-6 space-y-4" novalidate>
        <div>
          <label class="cm-label" for="email">メールアドレス</label>
          <input
            id="email"
            name="email"
            type="email"
            value={resuming ? sessionUser?.email : undefined}
            readonly={resuming}
            required
            autocomplete="email"
            class="cm-input"
          />
        </div>
        {
          !resuming && (
            <div>
              <label class="cm-label" for="password">
                パスワード
              </label>
              <input
                id="password"
                name="password"
                type="password"
                required
                minlength="8"
                maxlength="64"
                autocomplete="new-password"
                class="cm-input"
                aria-describedby="password-rules"
              />
              <ul id="password-rules" class="mt-2 text-xs text-plum-soft space-y-0.5 list-none">
                <li>・8文字以上64文字以内</li>
                <li>・英大文字（A–Z）を1文字以上</li>
                <li>・英小文字（a–z）を1文字以上</li>
                <li>・数字（0–9）を1文字以上</li>
              </ul>
            </div>
          )
        }
        <div>
          <label class="cm-label" for="corporate_number">法人番号（13桁）</label>
          <input
            id="corporate_number"
            name="corporate_number"
            type="text"
            required
            inputmode="numeric"
            maxlength="17"
            autocomplete="off"
            placeholder="例：8040001139883"
            class="cm-input font-mono"
            aria-describedby="corporate-number-hint"
          />
          <p id="corporate-number-hint" class="mt-1 text-xs text-plum-soft">
            13桁の数字（ハイフン・空白は自動で除去されます）。国税庁の法人番号を入力してください。
          </p>
        </div>
        <div>
          <label class="cm-label" for="name">組織名（非公開）</label>
          <input id="name" name="name" required class="cm-input" />
        </div>
        <div>
          <label class="cm-label" for="full_name">担当者名</label>
          <input id="full_name" name="full_name" required autocomplete="name" class="cm-input" />
        </div>
        <div>
          <label class="cm-label" for="prefecture">都道府県</label>
          <select id="prefecture" name="prefecture" required class="cm-input">
            <option value="">選択してください</option>
            {PREFECTURES.map((pref) => <option value={pref}>{pref}</option>)}
          </select>
        </div>
        <div>
          <label class="cm-label" for="city">市区町村</label>
          <input id="city" name="city" required placeholder="例：渋谷区" class="cm-input" />
        </div>
        <div>
          <label class="cm-label" for="display_name">表示名</label>
          <input id="display_name" name="display_name" required class="cm-input" placeholder="例：東京の機器担当" />
          <p class="mt-1 text-xs text-plum-soft">
            投稿・コメントで相手に表示される名前です。組織名・実名・電話番号を含まない名前にしてください。
          </p>
        </div>
        <fieldset>
          <legend class="cm-label">取引区分</legend>
          <div class="flex gap-4 text-sm">
            <label class="inline-flex items-center gap-1">
              <input type="radio" name="trade_side" value="sell" required checked={initialTradeSide === 'sell'} />
              売りたい
            </label>
            <label class="inline-flex items-center gap-1">
              <input type="radio" name="trade_side" value="buy" checked={initialTradeSide === 'buy'} />
              買いたい
            </label>
            <label class="inline-flex items-center gap-1">
              <input type="radio" name="trade_side" value="both" checked={initialTradeSide === 'both'} />
              両方
            </label>
          </div>
        </fieldset>
        <button type="submit" class="cm-btn-primary w-full">登録する</button>
        <p id="register-status" class="text-sm text-plum-soft hidden" role="alert"></p>
      </form>

      <p class="mt-6 text-sm text-plum-soft text-center">
        すでにアカウントをお持ちの方は <a href="/auth/login" class="text-rose hover:underline">ログイン</a>
      </p>
    </div>
  </section>
</Layout>

<script>
  const form = document.getElementById('register-form') as HTMLFormElement;
  const status = document.getElementById('register-status');

  function normalizeCorporateNumber(value: string) {
    return value.replace(/[\s\u3000-]/g, '');
  }

  function isValidPassword(password: string) {
    if (password.length < 8 || password.length > 64) return false;
    if (!/[a-z]/.test(password)) return false;
    if (!/[A-Z]/.test(password)) return false;
    if (!/\d/.test(password)) return false;
    return true;
  }

  function showError(message: string) {
    if (!status) return;
    status.textContent = message;
    status.classList.remove('hidden');
    status.classList.add('text-danger');
    status.classList.remove('text-plum-soft');
  }

  let submitting = false;
  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    if (!status || submitting) return;
    status.classList.add('hidden');
    status.classList.remove('text-danger');

    const raw = new FormData(form);
    const email = String(raw.get('email') ?? '').trim();
    const password = String(raw.get('password') ?? '');
    const corporateNumber = normalizeCorporateNumber(String(raw.get('corporate_number') ?? ''));
    const name = String(raw.get('name') ?? '').trim();
    const fullName = String(raw.get('full_name') ?? '').trim();
    const prefecture = String(raw.get('prefecture') ?? '').trim();
    const city = String(raw.get('city') ?? '').trim();
    const displayName = String(raw.get('display_name') ?? '').trim();
    const tradeSide = String(raw.get('trade_side') ?? '').trim();

    if (!email) {
      showError('メールアドレスを入力してください');
      return;
    }
    if (form.dataset.resuming !== 'true' && !password) {
      showError('パスワードを入力してください');
      return;
    }
    if (form.dataset.resuming !== 'true' && !isValidPassword(password)) {
      showError('パスワードは8文字以上64文字以内で、英大文字・英小文字・数字をそれぞれ1文字以上含めてください');
      return;
    }
    if (!corporateNumber) {
      showError('法人番号を入力してください');
      return;
    }
    if (!/^\d{13}$/.test(corporateNumber)) {
      showError('法人番号は13桁の数字で入力してください（ハイフンは除いて数えます）');
      return;
    }
    if (!name) {
      showError('組織名を入力してください');
      return;
    }
    if (!fullName) {
      showError('担当者名を入力してください');
      return;
    }
    if (!prefecture) {
      showError('都道府県を選択してください');
      return;
    }
    if (!city) {
      showError('市区町村を入力してください');
      return;
    }
    if (!displayName) {
      showError('表示名を入力してください');
      return;
    }
    if (!['sell', 'buy', 'both'].includes(tradeSide)) {
      showError('取引区分を選択してください');
      return;
    }

    status.textContent = '登録中…';
    status.classList.remove('hidden', 'text-danger');
    status.classList.add('text-plum-soft');

    const payload = Object.fromEntries(raw);
    payload.corporate_number = corporateNumber;
    submitting = true;
    try {
      const res = await fetch('/api/auth/register', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload),
      });
      const json = await res.json();
      if (res.ok) {
        if (json.confirmationRequired) {
          window.location.href = '/auth/register/thanks';
        } else {
          window.location.href = '/auth/login?registered=1';
        }
        return;
      }
      showError(json.error ?? '登録に失敗しました');
    } catch {
      showError('通信に失敗しました。入力を残したまま、もう一度お試しください。');
    } finally {
      submitting = false;
    }
  });
</script>
