---
export const prerender = false;

import Layout from '~/layouts/PageLayout.astro';

const redirect = Astro.url.searchParams.get('redirect') ?? '/account';
const registered = Astro.url.searchParams.has('registered');
const confirmed = Astro.url.searchParams.has('confirmed');
const resent = Astro.url.searchParams.has('resent');
const error = Astro.url.searchParams.get('error');
const confirmExpired = error === 'confirm';

const metadata = { title: 'ログイン' };
---

<Layout metadata={metadata}>
  <section class="py-12 md:py-16 bg-cream">
    <div class="max-w-md mx-auto px-4 sm:px-6">
      <h1 class="cm-heading text-3xl font-bold mb-2">ログイン</h1>

      {confirmed && <p class="text-sage mb-4 text-sm">メールアドレスの確認が完了しました。ログインしてください。</p>}
      {registered && !confirmed && <p class="text-sage mb-4 text-sm">登録が完了しました。ログインしてください。</p>}
      {
        resent && (
          <p class="text-sage mb-4 text-sm">
            確認メールを再送しました。メール内のリンクをクリックしてからログインしてください。
          </p>
        )
      }
      {
        confirmExpired && (
          <div class="mb-4 p-4 rounded-xl border border-rose/30 bg-rose/5 text-sm">
            <p class="font-medium text-plum mb-1">メール確認が完了していません</p>
            <p class="text-plum-soft leading-relaxed">
              確認リンクの有効期限（24時間程度）が切れたか、すでに使用されています。
              登録時のメールアドレスを入力し、「確認メールを再送する」から新しいリンクを受け取ってください。
            </p>
          </div>
        )
      }

      <form id="login-form" class="cm-card p-6 space-y-4">
        <input type="hidden" name="redirect" value={redirect} />
        <div>
          <label class="cm-label" for="email">メールアドレス</label>
          <input id="email" name="email" type="email" required autocomplete="email" class="cm-input" />
        </div>
        <div>
          <label class="cm-label" for="password">パスワード</label>
          <input
            id="password"
            name="password"
            type="password"
            required
            autocomplete="current-password"
            class="cm-input"
          />
        </div>
        <button type="submit" class="cm-btn-primary w-full">ログイン</button>
        <p id="login-status" class="text-sm text-danger hidden" role="alert" aria-live="polite"></p>

        <div id="resend-panel" class:list={['space-y-2 pt-4 border-t border-border', !confirmExpired && 'hidden']}>
          <p class="text-xs text-plum-soft">メール確認が届かない・期限切れの場合</p>
          <button type="button" id="resend-btn" class="cm-btn-secondary w-full"> 確認メールを再送する </button>
        </div>
      </form>

      <p class="mt-6 text-sm text-plum-soft text-center">
        初めての方は <a href="/auth/register" class="text-rose hover:underline">会員登録</a>
      </p>
    </div>
  </section>
</Layout>

<script>
  const form = document.getElementById('login-form') as HTMLFormElement;
  const status = document.getElementById('login-status');
  const resendPanel = document.getElementById('resend-panel');
  const resendBtn = document.getElementById('resend-btn');

  function showResendPanel() {
    resendPanel?.classList.remove('hidden');
  }

  function showStatus(message: string, isError: boolean) {
    if (!status) return;
    status.textContent = message;
    status.classList.remove('hidden');
    status.classList.toggle('text-danger', isError);
    status.classList.toggle('text-plum-soft', !isError);
    status.classList.toggle('text-sage', !isError && message.includes('再送しました'));
  }

  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    status?.classList.add('hidden');
    showStatus('ログイン中…', false);

    const data = Object.fromEntries(new FormData(form));
    const res = await fetch('/api/auth/login', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ email: data.email, password: data.password }),
    });
    const json = await res.json();
    if (res.ok) {
      const target = String(data.redirect || '/account');
      window.location.href = json.onboardingRequired
        ? '/auth/register?complete=1'
        : target.startsWith('/') && !target.startsWith('//') && !target.includes('\\')
          ? target
          : '/account';
      return;
    }
    showStatus(json.error ?? 'ログインに失敗しました。しばらくしてから再度お試しください。', true);
    if (json.code === 'email_not_confirmed') {
      showResendPanel();
    }
  });

  resendBtn?.addEventListener('click', async () => {
    const email = (document.getElementById('email') as HTMLInputElement)?.value?.trim();
    if (!email) {
      showStatus('再送するにはメールアドレスを入力してください', true);
      return;
    }

    showStatus('確認メールを再送中…', false);
    resendBtn.setAttribute('disabled', 'true');

    const res = await fetch('/api/auth/resend-confirmation', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ email }),
    });
    const json = await res.json();
    resendBtn.removeAttribute('disabled');

    if (res.ok) {
      const params = new URLSearchParams(window.location.search);
      params.delete('error');
      params.set('resent', '1');
      window.location.href = `/auth/login?${params.toString()}`;
      return;
    }

    showStatus(json.error ?? '再送に失敗しました', true);
    showResendPanel();
  });
</script>
