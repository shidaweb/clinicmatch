---
export const prerender = false;

import Layout from '~/layouts/PageLayout.astro';
import { getProfile } from '~/lib/auth';
import { createSupabaseAdminClient } from '~/lib/supabase/server';
import { DEAL_STATUS_LABELS, INVOICE_STATUS_LABELS, CONTRACT_TEMPLATES } from '~/lib/deals';

const profile = await getProfile(Astro.cookies, Astro.locals as never);
if (!profile || profile.role !== 'admin') return Astro.redirect('/account');

const admin = createSupabaseAdminClient(Astro.locals as never);
const [{ data: deals }, { data: signedMediations }] = await Promise.all([
  admin.from('deals').select('*').order('created_at', { ascending: false }),
  admin.from('mediation_agreements').select('id, seller_org_id, status').eq('status', 'signed'),
]);

const dealIds = (deals ?? []).map((d) => d.id);
const { data: invoices } = dealIds.length
  ? await admin.from('commission_invoices').select('*').in('deal_id', dealIds)
  : { data: [] };

const invoiceByDeal = new Map((invoices ?? []).map((i) => [i.deal_id, i]));

const metadata = { title: '売買契約・請求管理' };
---

<Layout metadata={metadata}>
  <section class="py-12 md:py-16">
    <div class="max-w-5xl mx-auto px-4 sm:px-6">
      <a href="/admin" class="text-sm text-brand-600 hover:underline">← 管理画面</a>
      <h1 class="text-2xl font-bold text-text mt-4 mb-2">売買契約・請求管理</h1>
      <p class="text-sm text-text-muted mb-6">
        成約処理で手数料7.5%の請求が自動発行されます。中古通知の運営チェックリストは成約前に確認してください。
      </p>

      <details class="rounded-xl border border-border bg-surface-muted p-4 mb-8">
        <summary class="font-semibold text-text cursor-pointer">運営チェックリスト（薬機法・中古通知）</summary>
        <ul class="mt-3 text-sm text-text-muted space-y-1 list-disc pl-5">
          <li>売り手の販売業許可・営業所管理者の確認</li>
          <li>製造販売業者への中古通知（売り手へのリマインド）</li>
          <li>特定保守管理医療機器に該当する場合の追加確認</li>
        </ul>
      </details>

      <form id="deal-form" class="rounded-xl border border-border bg-surface p-5 mb-8 space-y-3">
        <h2 class="font-semibold text-text">売買契約作成（仲介契約 signed 必須）</h2>
        <select name="mediation_agreement_id" required class="w-full rounded-xl border border-border px-3 py-2 text-sm">
          <option value="">仲介契約を選択</option>
          {(signedMediations ?? []).map((m) => (
            <option value={m.id}>{m.id.slice(0, 8)}… / 売り手 {m.seller_org_id.slice(0, 8)}…</option>
          ))}
        </select>
        <input name="buyer_org_id" placeholder="買い手 org UUID" required class="w-full rounded-xl border border-border px-3 py-2 text-sm" />
        <input name="seller_org_id" placeholder="売り手 org UUID" required class="w-full rounded-xl border border-border px-3 py-2 text-sm" />
        <input name="agreed_price" type="number" placeholder="成約額（円）" required class="w-full rounded-xl border border-border px-3 py-2 text-sm" />
        <select name="contract_template_key" class="w-full rounded-xl border border-border px-3 py-2 text-sm">
          {CONTRACT_TEMPLATES.map((t) => (
            <option value={t.key}>{t.label}</option>
          ))}
        </select>
        <button type="submit" class="rounded-xl bg-brand-600 px-4 py-2 text-sm text-white">売買契約を作成</button>
      </form>

      <ul class="space-y-4">
        {(deals ?? []).map((d) => {
          const inv = invoiceByDeal.get(d.id);
          return (
            <li class="rounded-xl border border-border p-4">
              <div class="flex flex-wrap justify-between gap-3 mb-2">
                <span class="font-semibold">{d.agreed_price?.toLocaleString()}円</span>
                <span class="text-sm text-text-muted">{DEAL_STATUS_LABELS[d.status] ?? d.status}</span>
              </div>
              {inv && (
                <div class="text-sm text-text-muted space-y-2">
                  <p>
                    請求: {inv.amount?.toLocaleString()}円（{INVOICE_STATUS_LABELS[inv.status] ?? inv.status}）
                  </p>
                  {inv.status === 'issued' && (
                    <button class="paid-btn rounded-xl border border-border px-3 py-1 text-xs" data-invoice-id={inv.id}>
                      入金消込
                    </button>
                  )}
                </div>
              )}
              <div class="mt-3 flex flex-wrap gap-2">
                <button class="preview-btn rounded-xl border border-border px-3 py-1 text-xs" data-deal-id={d.id}>
                  契約ひな形プレビュー
                </button>
                {
                  d.status === 'negotiating' && (
                    <button class="conclude-btn rounded-xl bg-accent-market px-4 py-2 text-sm text-white" data-id={d.id}>
                      成約処理（請求自動発行）
                    </button>
                  )
                }
              </div>
              <pre class="preview-text hidden mt-3 text-xs whitespace-pre-wrap rounded-xl bg-surface-muted p-3 max-h-64 overflow-y-auto"></pre>
            </li>
          );
        })}
      </ul>
    </div>
  </section>
</Layout>

<script>
  document.getElementById('deal-form')?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const data = Object.fromEntries(new FormData(e.target as HTMLFormElement));
    const res = await fetch('/api/admin/deals', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(data),
    });
    if (res.ok) window.location.reload();
    else alert((await res.json()).error ?? '作成に失敗しました');
  });

  document.querySelectorAll('.conclude-btn').forEach((btn) => {
    btn.addEventListener('click', async () => {
      if (!confirm('成約処理を実行します。手数料請求が自動発行されます。')) return;
      const id = btn.getAttribute('data-id');
      const res = await fetch(`/api/admin/deals/${id}/conclude`, { method: 'POST' });
      const json = await res.json();
      if (res.ok) {
        alert(`成約しました。請求額: ${json.invoice?.amount?.toLocaleString() ?? json.deal?.commission_amount?.toLocaleString()}円`);
        window.location.reload();
      } else alert(json.error ?? '失敗しました');
    });
  });

  document.querySelectorAll('.paid-btn').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const invoiceId = btn.getAttribute('data-invoice-id');
      const res = await fetch(`/api/admin/invoices/${invoiceId}/paid`, { method: 'POST' });
      if (res.ok) window.location.reload();
      else alert('消込に失敗しました');
    });
  });

  document.querySelectorAll('.preview-btn').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const dealId = btn.getAttribute('data-deal-id');
      const pre = btn.closest('li')?.querySelector('.preview-text');
      if (!pre) return;
      pre.classList.remove('hidden');
      pre.textContent = '読み込み中…';
      const res = await fetch('/api/admin/contracts/preview', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ deal_id: dealId }),
      });
      const json = await res.json();
      pre.textContent = res.ok ? json.preview : (json.error ?? '取得失敗');
    });
  });
</script>
