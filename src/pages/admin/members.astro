---
export const prerender = false;

import AdminLayout from '~/layouts/AdminLayout.astro';
import { getProfile } from '~/lib/auth';
import { createSupabaseAdminClient } from '~/lib/supabase/server';

const profile = await getProfile(Astro.cookies, Astro.locals as never);
if (!profile || profile.role !== 'admin') return Astro.redirect('/account');

const admin = createSupabaseAdminClient(Astro.locals as never);
const { data: orgs } = await admin
  .from('organizations')
  .select('id, corporate_number, name, prefecture, city, verified_at, created_at')
  .order('created_at', { ascending: false });

const metadata = { title: '会員管理' };
---

<AdminLayout
  metadata={metadata}
  title="会員・組織管理"
  subtitle="※ この画面は運営のみ。公開ページには組織名・連絡先は表示されません。"
  maxWidth="5xl"
>
  <div class="overflow-x-auto">
    <table class="w-full text-sm border-collapse">
      <thead>
        <tr class="border-b border-line text-left text-plum-soft">
          <th class="py-2 pr-4">組織名</th>
          <th class="py-2 pr-4">法人番号</th>
          <th class="py-2 pr-4">所在地</th>
          <th class="py-2">登録日</th>
        </tr>
      </thead>
      <tbody>
        {(orgs ?? []).map((o) => (
          <tr class="border-b border-line">
            <td class="py-3 pr-4 text-plum">{o.name}</td>
            <td class="py-3 pr-4 font-mono text-xs text-plum">{o.corporate_number}</td>
            <td class="py-3 pr-4 text-plum">{o.prefecture}{o.city}</td>
            <td class="py-3 text-plum-soft">{new Date(o.created_at).toLocaleDateString('ja-JP')}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
</AdminLayout>
