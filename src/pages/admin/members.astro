---
export const prerender = false;

import Layout from '~/layouts/PageLayout.astro';
import { getProfile } from '~/lib/auth';
import { createSupabaseAdminClient } from '~/lib/supabase/server';

const profile = await getProfile(Astro.cookies, Astro.locals as never);
if (!profile || profile.role !== 'admin') return Astro.redirect('/account');

const admin = createSupabaseAdminClient(Astro.locals as never);
const { data: orgs } = await admin
  .from('organizations')
  .select('id, corporate_number, name, prefecture, city, verified_at, created_at')
  .order('created_at', { ascending: false });

const metadata = { title: '会員管理' };
---

<Layout metadata={metadata}>
  <section class="py-12 md:py-16">
    <div class="max-w-5xl mx-auto px-4 sm:px-6">
      <a href="/admin" class="text-sm text-brand-600 hover:underline">← 管理画面</a>
      <h1 class="text-2xl font-bold text-text mt-4 mb-6">会員・組織管理</h1>
      <p class="text-sm text-text-muted mb-4">※ この画面は運営のみ。公開ページには組織名・連絡先は表示されません。</p>
      <div class="overflow-x-auto">
        <table class="w-full text-sm border-collapse">
          <thead>
            <tr class="border-b border-border text-left text-text-muted">
              <th class="py-2 pr-4">組織名</th>
              <th class="py-2 pr-4">法人番号</th>
              <th class="py-2 pr-4">所在地</th>
              <th class="py-2">登録日</th>
            </tr>
          </thead>
          <tbody>
            {(orgs ?? []).map((o) => (
              <tr class="border-b border-border">
                <td class="py-3 pr-4">{o.name}</td>
                <td class="py-3 pr-4 font-mono text-xs">{o.corporate_number}</td>
                <td class="py-3 pr-4">{o.prefecture}{o.city}</td>
                <td class="py-3 text-text-muted">{new Date(o.created_at).toLocaleDateString('ja-JP')}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>
</Layout>
