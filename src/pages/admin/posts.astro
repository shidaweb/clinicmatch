---
export const prerender = false;

import Layout from '~/layouts/PageLayout.astro';
import { getProfile } from '~/lib/auth';
import { createSupabaseAdminClient } from '~/lib/supabase/server';

const profile = await getProfile(Astro.cookies, Astro.locals as never);
if (!profile || profile.role !== 'admin') return Astro.redirect('/account');

const admin = createSupabaseAdminClient(Astro.locals as never);
const [{ data: listings }, { data: wanted }] = await Promise.all([
  admin.from('listings').select('id, maker, model, status, created_at').eq('status', 'pending_review').order('created_at', { ascending: false }),
  admin.from('wanted_requests').select('id, category_slug, maker, model, status, created_at').eq('status', 'pending_review').order('created_at', { ascending: false }),
]);

const metadata = { title: '投稿審査' };
---

<Layout metadata={metadata}>
  <section class="py-12 md:py-16">
    <div class="max-w-5xl mx-auto px-4 sm:px-6">
      <h1 class="text-2xl font-bold text-text mb-8">投稿審査</h1>

      <h2 class="text-lg font-semibold text-sell mb-4">売りたい（審査待ち）</h2>
      <ul class="space-y-3 mb-10">
        {(listings ?? []).map((item) => (
          <li class="rounded-xl border border-border p-4 flex items-center justify-between gap-4">
            <span>{item.maker} {item.model}</span>
            <button
              class="publish-btn rounded-xl bg-brand-600 px-4 py-2 text-sm text-white"
              data-type="listings"
              data-id={item.id}
            >
              公開する
            </button>
          </li>
        ))}
      </ul>

      <h2 class="text-lg font-semibold text-buy mb-4">買いたい（審査待ち）</h2>
      <ul class="space-y-3">
        {(wanted ?? []).map((item) => (
          <li class="rounded-xl border border-border p-4 flex items-center justify-between gap-4">
            <span>{item.maker && item.model ? `${item.maker} ${item.model}` : item.category_slug}</span>
            <button
              class="publish-btn rounded-xl bg-brand-600 px-4 py-2 text-sm text-white"
              data-type="wanted"
              data-id={item.id}
            >
              公開する
            </button>
          </li>
        ))}
      </ul>
    </div>
  </section>
</Layout>

<script>
  document.querySelectorAll('.publish-btn').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const type = btn.getAttribute('data-type');
      const id = btn.getAttribute('data-id');
      const res = await fetch(`/api/admin/posts/${type}/${id}/publish`, { method: 'POST' });
      if (res.ok) window.location.reload();
      else alert('公開に失敗しました');
    });
  });
</script>
