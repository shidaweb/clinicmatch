---
export const prerender = false;

import AdminLayout from '~/layouts/AdminLayout.astro';
import { getProfile } from '~/lib/auth';
import { createSupabaseAdminClient } from '~/lib/supabase/server';
import { CLINICAL_USE_LABELS, LISTING_KIND_LABELS } from '~/lib/marketplace';

const profile = await getProfile(Astro.cookies, Astro.locals as never);
if (!profile || profile.role !== 'admin') return Astro.redirect('/account');

const admin = createSupabaseAdminClient(Astro.locals as never);
const [{ data: listings, error: listingsError }, { data: wanted, error: wantedError }] = await Promise.all([
  admin
    .from('listings')
    .select('id, maker, model, status, created_at, listing_kind, clinical_use, compliance_note')
    .eq('status', 'pending_review')
    .order('created_at', { ascending: false }),
  admin
    .from('wanted_requests')
    .select('id, category_slug, maker, model, status, created_at, listing_kind_pref, only_unexpired')
    .eq('status', 'pending_review')
    .order('created_at', { ascending: false }),
]);

const metadata = { title: '投稿審査' };
---

<AdminLayout metadata={metadata} title="投稿審査" maxWidth="5xl">
  <p class="mb-5"><a class="cm-link" href="/admin/crm">全案件・連絡先・対応予定を見る →</a></p>
  {
    (listingsError || wantedError) && (
      <p role="alert" class="text-danger">
        投稿を取得できませんでした。空一覧ではありません。DBの状態を確認してください。
      </p>
    )
  }
  <h2 class="text-lg font-semibold text-rose mb-4">売りたい（審査待ち）</h2>
  <ul class="space-y-3 mb-10">
    {
      (listings ?? []).map((item) => (
        <li class="cm-list-item flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
          <div>
            <a class="cm-link" href={`/admin/crm/listings/${item.id}`}>
              {item.maker} {item.model} · 内容と連絡先を確認
            </a>
            <p class="text-xs text-plum-soft mt-1">
              {LISTING_KIND_LABELS[item.listing_kind] ?? '機器本体'} /{' '}
              {CLINICAL_USE_LABELS[item.clinical_use] ?? '患者施術可'}
            </p>
            {item.compliance_note && <p class="mt-1 text-xs text-rose">{item.compliance_note}</p>}
          </div>
          <div class="flex gap-2">
            <button class="publish-btn cm-btn-primary text-sm !px-4 !py-2" data-type="listings" data-id={item.id}>
              公開する
            </button>
            <button class="reject-btn cm-btn-secondary text-sm !px-4 !py-2" data-type="listings" data-id={item.id}>
              差し戻し
            </button>
          </div>
        </li>
      ))
    }
  </ul>

  <h2 class="text-lg font-semibold text-gold mb-4">買いたい（審査待ち）</h2>
  <ul class="space-y-3">
    {
      (wanted ?? []).map((item) => (
        <li class="cm-list-item flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
          <div>
            <a class="cm-link" href={`/admin/crm/wanted_requests/${item.id}`}>
              {item.maker && item.model ? `${item.maker} ${item.model}` : item.category_slug} · 内容と連絡先を確認
            </a>
            <p class="text-xs text-plum-soft mt-1">
              希望: {LISTING_KIND_LABELS[item.listing_kind_pref] ?? '機器本体'}
              {item.only_unexpired ? ' / 期限内のみ' : ''}
            </p>
          </div>
          <div class="flex gap-2">
            <button class="publish-btn cm-btn-primary text-sm !px-4 !py-2" data-type="wanted" data-id={item.id}>
              公開する
            </button>
            <button class="reject-btn cm-btn-secondary text-sm !px-4 !py-2" data-type="wanted" data-id={item.id}>
              差し戻し
            </button>
          </div>
        </li>
      ))
    }
  </ul>
</AdminLayout>

<script>
  document.querySelectorAll('.publish-btn').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const type = btn.getAttribute('data-type');
      const id = btn.getAttribute('data-id');
      const res = await fetch(`/api/admin/posts/${type}/${id}/publish`, { method: 'POST' });
      if (res.ok) window.location.reload();
      else alert('公開に失敗しました');
    });
  });
  document.querySelectorAll('.reject-btn').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const type = btn.getAttribute('data-type');
      const id = btn.getAttribute('data-id');
      const reason = window.prompt('差し戻し理由を入力してください');
      if (!reason?.trim()) return;
      const res = await fetch(`/api/admin/posts/${type}/${id}/reject`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ reason: reason.trim() }),
      });
      const data = await res.json();
      if (res.ok) {
        if (data.notificationFailed)
          alert('差し戻しは保存しましたが、通知できませんでした。CRMから連絡先を確認してください。');
        window.location.reload();
      } else alert(data.error || '差し戻しに失敗しました');
    });
  });
</script>
