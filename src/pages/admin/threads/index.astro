---
export const prerender = false;

import Layout from '~/layouts/PageLayout.astro';
import { getProfile } from '~/lib/auth';
import { createSupabaseAdminClient } from '~/lib/supabase/server';

const profile = await getProfile(Astro.cookies, Astro.locals as never);
if (!profile || profile.role !== 'admin') return Astro.redirect('/account');

const admin = createSupabaseAdminClient(Astro.locals as never);
const { data: threads } = await admin
  .from('threads')
  .select('id, kind, status, contact_disclosed, created_at, buyer_org_id, seller_org_id')
  .order('created_at', { ascending: false })
  .limit(100);

const metadata = { title: '仲介ワークスペース' };
---

<Layout metadata={metadata}>
  <section class="py-12 md:py-16">
    <div class="max-w-5xl mx-auto px-4 sm:px-6">
      <a href="/admin" class="text-sm text-brand-600 hover:underline">← 管理画面</a>
      <h1 class="text-2xl font-bold text-text mt-4 mb-6">仲介ワークスペース</h1>
      <ul class="space-y-3">
        {(threads ?? []).map((t) => (
          <li>
            <a href={`/admin/threads/${t.id}`} class="block rounded-xl border border-border p-4 hover:shadow-sm">
              <div class="flex justify-between text-sm">
                <span>{t.kind === 'qa' ? 'Q&A' : '仲介'} — {t.status}</span>
                {t.contact_disclosed && <span class="text-accent-market">連絡先開示済</span>}
              </div>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>
</Layout>
