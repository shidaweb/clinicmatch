---
export const prerender = false;

import Layout from '~/layouts/PageLayout.astro';
import { getProfile } from '~/lib/auth';
import { createSupabaseAdminClient } from '~/lib/supabase/server';
import { MEDIATION_STATUS_LABELS } from '~/lib/deals';

const profile = await getProfile(Astro.cookies, Astro.locals as never);
if (!profile || profile.role !== 'admin') return Astro.redirect('/account');

const admin = createSupabaseAdminClient(Astro.locals as never);
const { data: agreements } = await admin
  .from('mediation_agreements')
  .select('id, seller_org_id, status, commission_rate, signed_at, created_at, listing_id')
  .order('created_at', { ascending: false });

const metadata = { title: '仲介契約管理' };
---

<Layout metadata={metadata}>
  <section class="py-12 md:py-16">
    <div class="max-w-5xl mx-auto px-4 sm:px-6">
      <a href="/admin" class="text-sm text-brand-600 hover:underline">← 管理画面</a>
      <h1 class="text-2xl font-bold text-text mt-4 mb-6">仲介契約管理</h1>

      <form id="agreement-form" class="rounded-xl border border-border bg-surface p-5 mb-8 space-y-3">
        <h2 class="font-semibold text-text">新規仲介契約</h2>
        <input name="seller_org_id" placeholder="売り手 org UUID" required class="w-full rounded-xl border border-border px-3 py-2 text-sm" />
        <input name="listing_id" placeholder="listing UUID（任意）" class="w-full rounded-xl border border-border px-3 py-2 text-sm" />
        <textarea name="terms" rows="2" placeholder="条項（任意）" class="w-full rounded-xl border border-border px-3 py-2 text-sm"></textarea>
        <button type="submit" class="rounded-xl bg-brand-600 px-4 py-2 text-sm text-white">作成・送付</button>
      </form>

      <ul class="space-y-3">
        {(agreements ?? []).map((a) => (
          <li class="rounded-xl border border-border p-4 flex flex-wrap justify-between items-center gap-3">
            <div class="text-sm">
              <p>ID: {a.id.slice(0, 8)}…</p>
              <p class="text-text-muted">{MEDIATION_STATUS_LABELS[a.status] ?? a.status}</p>
            </div>
            {
              a.status === 'sent' && (
                <button class="sign-btn rounded-xl border border-border px-4 py-2 text-sm" data-id={a.id}>
                  売り手合意（signed）
                </button>
              )
            }
          </li>
        ))}
      </ul>
    </div>
  </section>
</Layout>

<script>
  document.getElementById('agreement-form')?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const form = e.target as HTMLFormElement;
    const data = Object.fromEntries(new FormData(form));
    const res = await fetch('/api/admin/agreements', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(data),
    });
    if (res.ok) window.location.reload();
    else alert((await res.json()).error ?? '作成に失敗しました');
  });

  document.querySelectorAll('.sign-btn').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const id = btn.getAttribute('data-id');
      const res = await fetch(`/api/admin/agreements/${id}/sign`, { method: 'POST' });
      if (res.ok) window.location.reload();
      else alert('更新に失敗しました');
    });
  });
</script>
