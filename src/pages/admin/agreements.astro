---
export const prerender = false;

import AdminLayout from '~/layouts/AdminLayout.astro';
import { getProfile } from '~/lib/auth';
import { createSupabaseAdminClient } from '~/lib/supabase/server';
import { MEDIATION_STATUS_LABELS } from '~/lib/deals';

const profile = await getProfile(Astro.cookies, Astro.locals as never);
if (!profile || profile.role !== 'admin') return Astro.redirect('/account');

const admin = createSupabaseAdminClient(Astro.locals as never);
const { data: agreements } = await admin
  .from('mediation_agreements')
  .select('id, seller_org_id, status, commission_rate, signed_at, created_at, listing_id')
  .order('created_at', { ascending: false });

const metadata = { title: '仲介契約管理' };
---

<AdminLayout metadata={metadata} title="仲介契約管理" maxWidth="5xl">
  <form id="agreement-form" class="cm-card p-5 mb-8 space-y-3">
    <h2 class="font-heading font-semibold text-plum">新規仲介契約</h2>
    <input name="seller_org_id" placeholder="売り手 org UUID" required class="cm-input" />
    <input name="listing_id" placeholder="listing UUID（任意）" class="cm-input" />
    <textarea name="terms" rows="2" placeholder="条項（任意）" class="cm-input"></textarea>
    <button type="submit" class="cm-btn-primary text-sm !px-4 !py-2">作成・送付</button>
  </form>

  <ul class="space-y-3">
    {(agreements ?? []).map((a) => (
      <li class="cm-list-item flex flex-wrap justify-between items-center gap-3">
        <div class="text-sm">
          <p class="text-plum">ID: {a.id.slice(0, 8)}…</p>
          <p class="text-plum-soft">{MEDIATION_STATUS_LABELS[a.status] ?? a.status}</p>
        </div>
        {
          a.status === 'sent' && (
            <button class="sign-btn rounded-xl border border-line px-4 py-2 text-sm text-plum" data-id={a.id}>
              売り手合意（signed）
            </button>
          )
        }
      </li>
    ))}
  </ul>
</AdminLayout>

<script>
  document.getElementById('agreement-form')?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const form = e.target as HTMLFormElement;
    const data = Object.fromEntries(new FormData(form));
    const res = await fetch('/api/admin/agreements', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(data),
    });
    if (res.ok) window.location.reload();
    else alert((await res.json()).error ?? '作成に失敗しました');
  });

  document.querySelectorAll('.sign-btn').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const id = btn.getAttribute('data-id');
      const res = await fetch(`/api/admin/agreements/${id}/sign`, { method: 'POST' });
      if (res.ok) window.location.reload();
      else alert('更新に失敗しました');
    });
  });
</script>
