---
export const prerender = false;

import Layout from '~/layouts/PageLayout.astro';
import { getProfile } from '~/lib/auth';
import { createSupabaseAdminClient } from '~/lib/supabase/server';

const profile = await getProfile(Astro.cookies, Astro.locals as never);
if (!profile || profile.role !== 'admin') return Astro.redirect('/account');

const admin = createSupabaseAdminClient(Astro.locals as never);
const { data: approaches } = await admin
  .from('approaches')
  .select('id, kind, status, message, created_at, listing_id, wanted_request_id')
  .order('created_at', { ascending: false })
  .limit(100);

const kindLabels: Record<string, string> = { interest: '関心（買→売）', offer: '提案（売→買）' };
const metadata = { title: 'アプローチ管理' };
---

<Layout metadata={metadata}>
  <section class="py-12 md:py-16">
    <div class="max-w-5xl mx-auto px-4 sm:px-6">
      <a href="/admin" class="text-sm text-brand-600 hover:underline">← 管理画面</a>
      <h1 class="text-2xl font-bold text-text mt-4 mb-6">アプローチ管理</h1>
      <ul class="space-y-4">
        {(approaches ?? []).map((a) => (
          <li class="rounded-xl border border-border p-4">
            <div class="flex flex-wrap justify-between gap-3 mb-2">
              <span class="text-sm font-medium">{kindLabels[a.kind] ?? a.kind}</span>
              <span class="text-xs text-text-muted">{a.status}</span>
            </div>
            {a.message && <p class="text-sm text-text-muted mb-3">{a.message}</p>}
            {
              a.status === 'new' && (
                <button
                  class="start-mediation-btn rounded-xl bg-brand-600 px-4 py-2 text-sm text-white"
                  data-approach-id={a.id}
                >
                  仲介スレッドを開始
                </button>
              )
            }
          </li>
        ))}
      </ul>
    </div>
  </section>
</Layout>

<script>
  document.querySelectorAll('.start-mediation-btn').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const approachId = btn.getAttribute('data-approach-id');
      const res = await fetch('/api/admin/threads', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ approach_id: approachId }),
      });
      const json = await res.json();
      if (res.ok) window.location.href = `/admin/threads/${json.thread_id}`;
      else alert(json.error ?? '開始に失敗しました');
    });
  });
</script>
