---
export const prerender = false;

import AdminLayout from '~/layouts/AdminLayout.astro';
import { getProfile } from '~/lib/auth';
import { createSupabaseAdminClient } from '~/lib/supabase/server';

const profile = await getProfile(Astro.cookies, Astro.locals as never);
if (!profile || profile.role !== 'admin') return Astro.redirect('/account');

const admin = createSupabaseAdminClient(Astro.locals as never);
const { data: approaches, error: loadError } = await admin
  .from('approaches')
  .select('id, kind, status, message, created_at, listing_id, wanted_request_id')
  .order('created_at', { ascending: false })
  .limit(100);

const kindLabels: Record<string, string> = { interest: '関心（買→売）', offer: '提案（売→買）' };
const metadata = { title: 'アプローチ管理' };
---

<AdminLayout metadata={metadata} title="関心・提案" maxWidth="5xl">
  {
    loadError && (
      <p role="alert" class="text-danger">
        関心・提案を取得できませんでした。時間をおいて再読み込みしてください。
      </p>
    )
  }
  {
    !loadError && !approaches?.length && (
      <div class="border-t border-line py-8">
        <>
          <h2 class="font-semibold">関心・提案はまだありません</h2>
          <p class="text-sm text-plum-soft mt-2">
            出品への関心や買い希望への提案が届くと、ここから仲介を開始できます。
          </p>
          <a href="/admin/crm" class="cm-link inline-block mt-4">
            全案件を確認する →
          </a>
        </>
      </div>
    )
  }
  <ul class="space-y-4">
    {
      (approaches ?? []).map((a) => (
        <li class="cm-list-item">
          <a class="cm-link" href={`/admin/crm/approaches/${a.id}`}>
            相手・条件・対応予定を確認
          </a>
          <div class="flex flex-wrap justify-between gap-3 mb-2">
            <span class="text-sm font-medium text-plum">{kindLabels[a.kind] ?? a.kind}</span>
            <span class="text-xs text-plum-soft">{a.status}</span>
          </div>
          {a.message && <p class="text-sm text-plum-soft mb-3">{a.message}</p>}
          {a.status === 'new' && (
            <button class="start-mediation-btn cm-btn-primary text-sm !px-4 !py-2" data-approach-id={a.id}>
              仲介スレッドを開始
            </button>
          )}
        </li>
      ))
    }
  </ul>
</AdminLayout>

<script>
  document.querySelectorAll('.start-mediation-btn').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const approachId = btn.getAttribute('data-approach-id');
      const res = await fetch('/api/admin/threads', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ approach_id: approachId }),
      });
      const json = await res.json();
      if (res.ok) window.location.href = `/admin/threads/${json.thread_id}`;
      else alert(json.error ?? '開始に失敗しました');
    });
  });
</script>
