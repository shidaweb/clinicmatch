---
export const prerender = false;

const url = new URL(Astro.url);
const target = new URL('/cases', url.origin);
url.searchParams.forEach((value, key) => target.searchParams.set(key, value));
if (!target.searchParams.has('view')) target.searchParams.set('view', 'active');
return Astro.redirect(target.pathname + target.search);
