---
import Layout from '~/layouts/PageLayout.astro';
import WidgetWrapper from '~/components/ui/WidgetWrapper.astro';

export const prerender = true;
---

<Layout metadata={{ title: '送信完了（購入希望）' }}>
  <WidgetWrapper containerClass="max-w-2xl mx-auto">
    <div class="cm-card p-8 text-center">
      <h1 class="cm-heading text-2xl md:text-3xl font-bold mb-4">送信完了</h1>
      <p class="text-plum-soft mb-6">
        購入希望フォームを受け付けました。通常1営業日以内にご連絡します。
      </p>

      <div class="rounded-2xl bg-cream p-5 text-left text-sm text-plum-soft mb-6">
        <p class="font-heading font-semibold text-plum mb-2">次にやること</p>
        <ol class="list-decimal list-inside space-y-1">
          <li>運営からのメール・電話をお待ちください</li>
          <li>予算・希望条件の詳細があれば共有をお願いします</li>
          <li>LINEでも追加のご相談が可能です</li>
        </ol>
      </div>

      <a href="https://lin.ee/vepVhWc" target="_blank" rel="noopener noreferrer" class="cm-btn-primary">
        LINEで友だち追加
      </a>
      <a href="/cases?view=active" class="mt-3 block text-sm text-rose hover:underline">在庫一覧を見る</a>
    </div>
  </WidgetWrapper>
</Layout>
