---
import Layout from '~/layouts/PageLayout.astro';
import WidgetWrapper from '~/components/ui/WidgetWrapper.astro';
import BuyForm from '~/components/interactive/BuyForm';
import Breadcrumb from '~/components/seo/Breadcrumb.astro';
import { getPermalink, getHomePermalink } from '~/utils/permalinks';

export const prerender = true;

const metadata = {
  title: '購入希望フォーム',
  description: '中古美容医療機器の購入をご希望の方はこちらのフォームからお問い合わせください。',
};
---

<Layout metadata={metadata}>
  <WidgetWrapper containerClass="max-w-2xl mx-auto" bg='<div class="absolute inset-0 bg-cream"></div>'>
    <Breadcrumb
      class="mb-6"
      items={[
        { name: 'トップ', url: getHomePermalink() },
        { name: 'お問い合わせ', url: getPermalink('contact') },
        { name: '購入希望' },
      ]}
    />

    <header class="mb-8">
      <p class="cm-eyebrow mb-2">Buy</p>
      <h1 class="cm-heading text-2xl md:text-3xl font-bold mb-2">購入希望フォーム</h1>
      <p class="text-plum-soft text-sm">入力項目と所要時間（約2分）・匿名OK</p>
      <div class="mt-4 h-1.5 rounded-full bg-line overflow-hidden">
        <div class="h-full w-1/3 rounded-full bg-gold" aria-hidden="true"></div>
      </div>
    </header>

    <div class="cm-card p-6">
      <BuyForm client:load />
    </div>
  </WidgetWrapper>
</Layout>
