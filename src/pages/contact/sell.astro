---
import Layout from '~/layouts/PageLayout.astro';
import WidgetWrapper from '~/components/ui/WidgetWrapper.astro';
import SellForm from '~/components/interactive/SellForm';
import Breadcrumb from '~/components/seo/Breadcrumb.astro';
import { getPermalink, getHomePermalink } from '~/utils/permalinks';

export const prerender = true;

const metadata = {
  title: '売りたい機器を登録・相談する',
  description: '中古美容医療機器の売却をご希望の方はこちらのフォームからお問い合わせください。',
};
---

<Layout metadata={metadata}>
  <WidgetWrapper animate={false} containerClass="max-w-4xl mx-auto" bg='<div class="absolute inset-0 bg-cream"></div>'>
    <Breadcrumb
      class="mb-6"
      items={[
        { name: 'トップ', url: getHomePermalink() },
        { name: 'お問い合わせ', url: getPermalink('contact') },
        { name: '売却希望' },
      ]}
    />

    <header class="mb-8">
      <h1 class="cm-heading text-[26px] md:text-[32px] font-bold mb-2">売りたい機器を登録・相談する</h1>
      <p class="text-plum-soft text-sm">3ステップ・所要時間 約2分・匿名OK</p>
    </header>

    <div class="grid lg:grid-cols-[1fr_280px] gap-8 items-start">
      <div class="cm-card p-6">
        <SellForm client:load />
      </div>
      <aside class="rounded-[14px] bg-blush border border-line p-5 lg:sticky lg:top-24 space-y-4 text-sm">
        <p class="font-heading font-semibold text-plum">安心してご利用いただけます</p>
        <ul class="space-y-3 text-plum-soft">
          <li class="flex gap-2"><span class="text-sage shrink-0">✓</span><span>クリニック名は非公開（匿名）</span></li>
          <li class="flex gap-2"><span class="text-sage shrink-0">✓</span><span>会員登録は法人・個人に対応</span></li>
          <li class="flex gap-2"><span class="text-sage shrink-0">✓</span><span>連絡先は合意後に開示</span></li>
          <li class="flex gap-2"><span class="text-sage shrink-0">✓</span><span>写真・機種名だけでもOK</span></li>
        </ul>
        <p class="text-xs text-plum-soft border-t border-line pt-4">通常1営業日以内にご連絡します。</p>
      </aside>
    </div>
    <section class="mt-12 border-t border-line pt-8" aria-labelledby="photo-guide-title">
      <h2 id="photo-guide-title" class="cm-heading text-xl font-semibold">本体と付属品が分かる写真をご用意ください</h2>
      <p class="mt-3 text-sm leading-relaxed text-plum-soft">
        機器の全体、ハンドピース、付属品をそれぞれ撮影すると、内容を確認しやすくなります。個人名や連絡先が写り込まないようご注意ください。
      </p>
      <div class="mt-6 grid grid-cols-1 sm:grid-cols-3 gap-5">
        <figure>
          <img
            src="/images/equipment/ulthera-handpiece-480.webp"
            width="491"
            height="299"
            alt="ウルセラのハンドピースの参考画像"
            loading="lazy"
            class="w-full h-44 object-contain bg-white rounded-lg"
          /><figcaption class="mt-2 text-xs text-plum-soft">ハンドピースの例（ウルセラ）</figcaption>
        </figure>
        <figure>
          <img
            src="/images/equipment/gentlemax-accessories.webp"
            width="600"
            height="800"
            alt="ジェントルマックスプロの付属品の参考写真"
            loading="lazy"
            class="w-full h-44 object-cover rounded-lg"
          /><figcaption class="mt-2 text-xs text-plum-soft">付属品の例（ジェントルマックスプロ）</figcaption>
        </figure>
        <figure>
          <img
            src="/images/equipment/xeo-accessories.webp"
            width="600"
            height="800"
            alt="ゼオのゴーグルなど付属品の参考写真"
            loading="lazy"
            class="w-full h-44 object-cover rounded-lg"
          /><figcaption class="mt-2 text-xs text-plum-soft">ゴーグルなどの例（ゼオ）</figcaption>
        </figure>
      </div>
      <p class="mt-4 text-xs text-plum-soft">
        提供いただいた写真を使った撮影例です。各出品に付属するものを示すものではありません。
      </p>
    </section>
  </WidgetWrapper>
</Layout>
