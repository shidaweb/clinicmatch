---
export const prerender = false;

import Layout from '~/layouts/PageLayout.astro';
import MaintenanceBadge from '~/components/MaintenanceBadge.astro';
import ConsultButton from '~/components/ConsultButton.astro';
import MatchSuggestions from '~/components/MatchSuggestions.astro';
import { createSupabaseServerClient } from '~/lib/supabase/server';
import {
  anonymousOrgLabel,
  formatLocation,
  formatPriceYen,
  PUBLIC_LISTING_SELECT,
  PUBLIC_WANTED_SELECT,
  type PublicListing,
  type PublicWanted,
} from '~/lib/marketplace';
import { hasSupabaseConfig } from '~/lib/env';
import { getProfile } from '~/lib/auth';
import { matchWantedForListing } from '~/lib/matching';

const { id } = Astro.params;
if (!id) return Astro.redirect('/market');

let listing: PublicListing | null = null;

if (hasSupabaseConfig(Astro.locals as never)) {
  const supabase = createSupabaseServerClient(Astro.cookies, Astro.locals as never);
  const { data } = await supabase
    .from('listings')
    .select(PUBLIC_LISTING_SELECT)
    .eq('id', id)
    .eq('status', 'published')
    .single();
  listing = data as PublicListing | null;
}

if (!listing) return Astro.redirect('/market');

let matchWanted: ReturnType<typeof matchWantedForListing> = [];
if (hasSupabaseConfig(Astro.locals as never)) {
  const supabase = createSupabaseServerClient(Astro.cookies, Astro.locals as never);
  const { data: wantedList } = await supabase
    .from('wanted_requests')
    .select(PUBLIC_WANTED_SELECT)
    .eq('status', 'published')
    .eq('category_slug', listing.category_slug)
    .limit(30);
  matchWanted = matchWantedForListing(listing, (wantedList ?? []) as PublicWanted[]);
}

const profile = await getProfile(Astro.cookies, Astro.locals as never);
const supabaseUrl = import.meta.env.PUBLIC_SUPABASE_URL ?? '';
const images = (listing.listing_images ?? []).map((img) => ({
  ...img,
  url: supabaseUrl ? `${supabaseUrl}/storage/v1/object/public/listing-images/${img.storage_path}` : null,
}));

const metadata = {
  title: `${listing.maker} ${listing.model}（売りたい）`,
};
---

<Layout metadata={metadata}>
  <section class="py-12 md:py-16">
    <div class="max-w-5xl mx-auto px-4 sm:px-6">
      <div class="mb-6 flex flex-wrap items-center gap-3">
        <span class="inline-flex rounded-full bg-sell px-3 py-1 text-xs font-semibold text-white">売りたい</span>
        <span class="text-sm text-text-muted">{anonymousOrgLabel(listing.location_city)}</span>
      </div>

      <div class="grid lg:grid-cols-2 gap-8">
        <div class="space-y-3">
          {
            images.length ? (
              images.map((img) => (
                img.url ? (
                  <img src={img.url} alt="" class="w-full rounded-xl object-cover bg-surface-muted" loading="lazy" />
                ) : null
              ))
            ) : (
              <div class="h-64 rounded-xl bg-surface-muted flex items-center justify-center text-text-muted">画像なし</div>
            )
          }
        </div>

        <div>
          <p class="text-sm text-text-muted">{listing.categories?.name}</p>
          <h1 class="text-3xl font-bold text-text mt-1">{listing.maker} {listing.model}</h1>
          <p class="mt-4 text-2xl font-bold text-brand-600">{formatPriceYen(listing.asking_price)}</p>
          <p class="mt-2 text-sm text-text-muted">所在地：{formatLocation(listing.location_prefecture, listing.location_city)}</p>

          <div class="mt-6">
            <MaintenanceBadge
              makerMaintenance={listing.maker_maintenance}
              maintenanceTransferable={listing.maintenance_transferable}
              hasAccessories={listing.has_accessories}
            />
          </div>

          {
            listing.accessories_detail && (
              <div class="mt-4 rounded-xl bg-surface-muted p-4 text-sm">
                <p class="font-medium text-text mb-1">付属品</p>
                <p class="text-text-muted whitespace-pre-wrap">{listing.accessories_detail}</p>
              </div>
            )
          }

          {
            listing.maintenance_notes && (
              <div class="mt-4 rounded-xl bg-surface-muted p-4 text-sm">
                <p class="font-medium text-text mb-1">保守に関する補足</p>
                <p class="text-text-muted whitespace-pre-wrap">{listing.maintenance_notes}</p>
              </div>
            )
          }

          {
            listing.description && (
              <div class="mt-4 prose prose-sm max-w-none text-text">
                <p class="whitespace-pre-wrap">{listing.description}</p>
              </div>
            )
          }

          <div class="mt-8 flex flex-wrap gap-3">
            {
              profile ? (
                <>
                  <button id="interest-btn" class="btn-market-primary" data-listing-id={listing.id}>
                    関心リクエストを送る
                  </button>
                  <button id="qa-btn" class="btn-market-secondary" data-listing-id={listing.id}>
                    保守・付属品について質問
                  </button>
                </>
              ) : (
                <>
                  <a href={`/auth/login?redirect=/listings/${listing.id}`} class="btn-market-primary">
                    ログインして関心リクエスト
                  </a>
                  <a href={`/auth/login?redirect=/listings/${listing.id}`} class="btn-market-secondary">
                    ログインしてQ&A
                  </a>
                </>
              )
            }
            <ConsultButton label="この件を相談する" relatedListingId={listing.id} />
          </div>
          <p id="interest-status" class="mt-3 text-sm text-text-muted hidden"></p>
          <p id="qa-status" class="mt-1 text-sm text-text-muted hidden"></p>
        </div>
      </div>

      <MatchSuggestions title="マッチする買いたいリクエスト" matches={matchWanted} />
    </div>
  </section>
</Layout>

<script>
  const btn = document.getElementById('interest-btn');
  const status = document.getElementById('interest-status');
  const qaBtn = document.getElementById('qa-btn');
  const qaStatus = document.getElementById('qa-status');

  btn?.addEventListener('click', async () => {
    if (!status) return;
    const listingId = btn.getAttribute('data-listing-id');
    status.textContent = '送信中…';
    status.classList.remove('hidden');

    const res = await fetch('/api/approaches', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ kind: 'interest', listing_id: listingId, message: '関心があります。' }),
    });
    const json = await res.json();
    status.textContent = res.ok ? '関心リクエストを送信しました。運営よりご連絡します。' : (json.error ?? '送信に失敗しました');
  });

  qaBtn?.addEventListener('click', async () => {
    if (!qaStatus) return;
    const listingId = qaBtn.getAttribute('data-listing-id');
    const message = window.prompt('保守・付属品についての質問を入力してください（匿名）');
    if (!message?.trim()) return;

    qaStatus.textContent = '送信中…';
    qaStatus.classList.remove('hidden');

    const res = await fetch('/api/threads', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ listing_id: listingId, message: message.trim() }),
    });
    const json = await res.json();
    if (res.ok) {
      qaStatus.textContent = 'Q&Aを開始しました。';
      window.location.href = `/account/threads/${json.thread_id}`;
    } else {
      qaStatus.textContent = json.error ?? '送信に失敗しました';
    }
  });
</script>

<style>
  .btn-market-primary {
    @apply inline-flex items-center justify-center rounded-xl bg-brand-600 px-5 py-2.5 text-sm font-semibold text-white shadow-sm hover:opacity-90 transition;
  }
  .btn-market-secondary {
    @apply inline-flex items-center justify-center rounded-xl border border-brand-600 text-brand-600 px-5 py-2.5 text-sm font-semibold hover:bg-surface-muted transition;
  }
</style>
