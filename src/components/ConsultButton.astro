---
interface Props {
  href?: string;
  label?: string;
  variant?: 'default' | 'inline' | 'primary';
  relatedListingId?: string;
  relatedWantedId?: string;
  class?: string;
}

const {
  href,
  label = '出品・購入を相談する',
  variant = 'default',
  relatedListingId,
  relatedWantedId,
  class: className = '',
} = Astro.props;

const params = new URLSearchParams();
if (relatedListingId) params.set('listing', relatedListingId);
if (relatedWantedId) params.set('wanted', relatedWantedId);
const query = params.toString();
const consultHref = href ?? `/contact${query ? `?${query}` : ''}`;

const baseClass =
  variant === 'primary'
    ? 'cm-btn-primary'
    : variant === 'inline'
      ? 'inline-flex items-center justify-center rounded-full border border-line bg-ivory px-4 py-2 text-sm font-medium text-plum hover:bg-cream transition'
      : 'inline-flex items-center justify-center rounded-full border border-rose/40 bg-ivory px-5 py-2.5 text-sm font-semibold text-rose shadow-sm hover:bg-cream transition';
---

<a href={consultHref} class:list={[baseClass, className]}>
  {label}
</a>
