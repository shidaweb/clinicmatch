---
interface Props {
  href?: string;
  label?: string;
  variant?: 'default' | 'inline';
  relatedListingId?: string;
  relatedWantedId?: string;
  class?: string;
}

const {
  href,
  label = '出品・購入を相談する',
  variant = 'default',
  relatedListingId,
  relatedWantedId,
  class: className = '',
} = Astro.props;

const params = new URLSearchParams();
if (relatedListingId) params.set('listing', relatedListingId);
if (relatedWantedId) params.set('wanted', relatedWantedId);
const query = params.toString();
const consultHref = href ?? `/consult${query ? `?${query}` : ''}`;

const baseClass =
  variant === 'inline'
    ? 'inline-flex items-center justify-center rounded-xl border border-border bg-surface px-4 py-2 text-sm font-medium text-text hover:bg-surface-muted transition'
    : 'inline-flex items-center justify-center rounded-xl border border-border bg-surface px-5 py-2.5 text-sm font-semibold text-text shadow-sm hover:bg-surface-muted transition';
---

<a href={consultHref} class:list={[baseClass, className]}>
  {label}
</a>
