---
import { Icon } from 'astro-icon/components';
import { SITE } from 'astrowind:config';
import ConsultButton from '~/components/ConsultButton.astro';
import { getHomePermalink } from '~/utils/permalinks';

interface Link {
  text?: string;
  href?: string;
  ariaLabel?: string;
  icon?: string;
  target?: string;
  dataOpenAsPopup?: boolean;
}

interface Links {
  title?: string;
  links: Array<Link>;
}

export interface Props {
  links: Array<Links>;
  secondaryLinks: Array<Link>;
  socialLinks: Array<Link>;
  footNote?: string;
  theme?: string;
  showConsult?: boolean;
}

const { socialLinks = [], secondaryLinks = [], links = [], footNote = '', theme = 'light', showConsult = false } = Astro.props;
---

<footer class:list={[{ dark: theme === 'dark' }, 'relative border-t border-plum-soft/20 not-prose bg-plum text-cream']}>
  <div class="relative max-w-7xl mx-auto px-4 sm:px-6 intersect-once intersect-quarter intersect-no-queue motion-safe:md:opacity-0 motion-safe:md:intersect:animate-fade">
    <div class="grid grid-cols-12 gap-4 gap-y-8 sm:gap-8 py-8 md:py-12">
      <div class="col-span-12 lg:col-span-4">
        <div class="mb-2">
          <a class="inline-flex items-center gap-2 font-heading font-bold text-3xl text-cream hover:text-rose transition" href={getHomePermalink()}>
            <Icon name="tabler:stethoscope" class="w-7 h-7 flex-shrink-0 text-rose" />
            {SITE?.name}
          </a>
        </div>
        <div class="text-sm text-cream/70 flex gap-1">
          {
            secondaryLinks.map(({ text, href }, index) => (
              <>
                {index !== 0 ? ' · ' : ''}
                <a
                  class="text-cream/70 hover:text-cream hover:underline transition duration-150 ease-in-out"
                  href={href}
                  set:html={text}
                />
              </>
            ))
          }
        </div>
      </div>
      {
        links.map(({ title, links }) => (
          <div class="col-span-6 md:col-span-3 lg:col-span-2">
            <div class="text-cream/90 font-heading font-medium mb-2">{title}</div>
            {links && Array.isArray(links) && links.length > 0 && (
              <ul class="text-sm">
                {links.map(({ text, href, ariaLabel, target, dataOpenAsPopup }) => (
                  <li class="mb-2">
                    <a
                      class="text-cream/70 hover:text-cream hover:underline transition duration-150 ease-in-out"
                      href={href}
                      aria-label={ariaLabel}
                      {...(target ? { target, rel: 'noopener noreferrer' } : {})}
                      {...(dataOpenAsPopup ? { 'data-open-as-popup': '1' } : {})}
                    >
                      <Fragment set:html={text} />
                    </a>
                  </li>
                ))}
              </ul>
            )}
          </div>
        ))
      }
    </div>
    {(socialLinks?.length || (footNote && footNote.trim()) || showConsult) && (
      <div class="md:flex md:items-center md:justify-between py-6 md:py-8 gap-4 border-t border-cream/10">
        {showConsult && (
          <ConsultButton variant="primary" class="!text-white" />
        )}
        {
          socialLinks?.length ? (
            <ul class="flex mb-4 md:order-1 -ml-2 md:ml-4 md:mb-0 rtl:ml-0 rtl:-mr-2 rtl:md:ml-0 rtl:md:mr-4">
              {socialLinks.map(({ ariaLabel, href, text, icon }) => (
                <li>
                  <a
                    class="text-cream/70 hover:bg-cream/10 focus:outline-none focus:ring-4 focus:ring-cream/20 rounded-lg text-sm p-2.5 inline-flex items-center"
                    aria-label={ariaLabel}
                    href={href}
                  >
                    {icon && <Icon name={icon} class="w-5 h-5" />}
                    <Fragment set:html={text} />
                  </a>
                </li>
              ))}
            </ul>
          ) : (
            ''
          )
        }

        {footNote && footNote.trim() && (
          <div class="text-sm mr-4 text-cream/60">
            <Fragment set:html={footNote} />
          </div>
        )}
      </div>
    )}
  </div>
</footer>
