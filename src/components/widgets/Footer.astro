---
import { Icon } from 'astro-icon/components';
import { SITE } from 'astrowind:config';
import LineConsultButton from '~/components/LineConsultButton.astro';
import { getHomePermalink } from '~/utils/permalinks';

interface Link {
  text?: string;
  href?: string;
  ariaLabel?: string;
  icon?: string;
  target?: string;
  dataOpenAsPopup?: boolean;
}

interface Links {
  title?: string;
  links: Array<Link>;
}

export interface Props {
  links: Array<Links>;
  secondaryLinks: Array<Link>;
  footNote?: string;
  theme?: string;
  showConsult?: boolean;
}

const { secondaryLinks = [], links = [], footNote = '', theme = 'light' } = Astro.props;
---

<footer class:list={[{ dark: theme === 'dark' }, 'relative not-prose bg-plum']}>
  <div class="relative max-w-content mx-auto px-4 sm:px-6 pb-28 max-lg:pb-28 lg:pb-0">
    <div class="grid grid-cols-12 gap-4 gap-y-8 sm:gap-8 py-10 md:py-14">
      <div class="col-span-12 lg:col-span-4">
        <div class="mb-3">
          <a class="inline-flex items-center gap-2 font-heading font-bold text-2xl md:text-3xl hover:text-rose transition" style="color: #F4E3DD;" href={getHomePermalink()}>
            <Icon name="tabler:stethoscope" class="w-7 h-7 flex-shrink-0 text-rose" />
            {SITE?.name}
          </a>
        </div>
        <p class="text-sm leading-relaxed max-w-xs" style="color: #D8C4BD;">
          美容医療機器の中古売買マーケット。匿名で探せて、運営が仲介。連絡先は合意後に開示されます。
        </p>
      </div>
      {
        links.map(({ title, links }) => (
          <div class="col-span-6 md:col-span-3 lg:col-span-2">
            <div class="font-heading font-medium mb-3" style="color: #F4E3DD;">{title}</div>
            {links && Array.isArray(links) && links.length > 0 && (
              <ul class="text-sm">
                {links.map(({ text, href, ariaLabel, target, dataOpenAsPopup }) => (
                  <li class="mb-2">
                    <a
                      class="text-[#D8C4BD] hover:text-[#F4E3DD] hover:underline transition duration-150 ease-in-out"
                      href={href}
                      aria-label={ariaLabel}
                      {...(target ? { target, rel: 'noopener noreferrer' } : {})}
                      {...(dataOpenAsPopup ? { 'data-open-as-popup': '1' } : {})}
                    >
                      <Fragment set:html={text} />
                    </a>
                  </li>
                ))}
              </ul>
            )}
          </div>
        ))
      }
    </div>
    <div class="border-t py-6 md:py-8" style="border-color: rgb(216 196 189 / 0.2);">
      <div class="md:flex md:items-center md:justify-between gap-4">
        <div class="mb-4 md:mb-0">
          <LineConsultButton />
        </div>
        {footNote && footNote.trim() && (
          <div class="text-sm" style="color: #D8C4BD;">
            <Fragment set:html={footNote} />
          </div>
        )}
        <div class="text-sm flex gap-3 mt-4 md:mt-0">
          {
            secondaryLinks.map(({ text, href }) => (
              <a href={href} class="hover:underline" style="color: #D8C4BD;">{text}</a>
            ))
          }
        </div>
      </div>
    </div>
  </div>
</footer>
