---
import '@fontsource/noto-sans-jp/400.css';
import '@fontsource/noto-sans-jp/500.css';
import '@fontsource/noto-sans-jp/700.css';

// 'DM Sans'
// Nunito
// Dosis
// Outfit
// Roboto
// Literata
// 'IBM Plex Sans'
// Karla
// Poppins
// 'Fira Sans'
// 'Libre Franklin'
// Inconsolata
// Raleway
// Oswald
// 'Space Grotesk'
// Urbanist
---

<style is:inline>
  :root {
    --aw-font-sans: 'Noto Sans JP', ui-sans-serif, system-ui, sans-serif;
    --aw-font-serif: 'Shippori Mincho', 'Noto Serif JP', ui-serif, serif;
    --aw-font-heading: 'Shippori Mincho', 'Noto Serif JP', ui-serif, serif;

    --aw-color-primary: rgb(201 139 151);
    --aw-color-secondary: rgb(168 106 119);
    --aw-color-accent: rgb(143 169 155);

    --aw-color-text-heading: rgb(70 52 58);
    --aw-color-text-default: rgb(70 52 58);
    --aw-color-text-muted: rgb(122 92 99 / 85%);
    --aw-color-bg-page: #fbf5f1;

    --aw-color-bg-page-dark: rgb(70 52 58);

    ::selection {
      background-color: rgb(244 220 226);
    }
  }

  .dark {
    --aw-font-sans: 'Noto Sans JP', ui-sans-serif, system-ui, sans-serif;
    --aw-font-serif: 'Shippori Mincho', 'Noto Serif JP', ui-serif, serif;
    --aw-font-heading: 'Shippori Mincho', 'Noto Serif JP', ui-serif, serif;

    --aw-color-primary: rgb(201 139 151);
    --aw-color-secondary: rgb(168 106 119);
    --aw-color-accent: rgb(143 169 155);

    --aw-color-text-heading: rgb(251 245 241);
    --aw-color-text-default: rgb(251 245 241);
    --aw-color-text-muted: rgb(251 245 241 / 70%);
    --aw-color-bg-page: rgb(70 52 58);

    ::selection {
      background-color: rgb(168 106 119 / 35%);
      color: rgb(251 245 241);
    }
  }
</style>
