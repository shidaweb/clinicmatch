---
import { anonymousOrgLabel, formatLocation, formatPriceYen, type PublicListing, type PublicWanted } from '~/lib/marketplace';

interface Props {
  post: PublicListing | PublicWanted;
  kind: 'listing' | 'wanted';
}

const { post, kind } = Astro.props;
const isListing = kind === 'listing';
const listing = isListing ? (post as PublicListing) : null;
const wanted = !isListing ? (post as PublicWanted) : null;

const href = `/cases/${post.id}?type=${kind}`;
const categoryName = post.categories?.name ?? post.category_slug;
const title = isListing
  ? `${listing!.maker} ${listing!.model}`
  : wanted!.maker && wanted!.model
    ? `${wanted!.maker} ${wanted!.model}`
    : categoryName;

const priceLabel = isListing ? formatPriceYen(listing!.asking_price) : formatPriceYen(wanted!.budget);
const location = isListing
  ? formatLocation(listing!.location_prefecture, listing!.location_city)
  : wanted!.area_prefecture && wanted!.area_city
    ? formatLocation(wanted!.area_prefecture, wanted!.area_city)
    : 'エリア指定なし';

const anonLabel = anonymousOrgLabel(isListing ? listing!.location_city : wanted!.area_city ?? '');
const yearLabel = isListing && listing!.manufacture_year ? `${listing!.manufacture_year}年` : null;
const conditionLabel = isListing ? listing!.condition : wanted!.condition_pref;

const coverImage =
  isListing && listing!.listing_images?.length
    ? listing!.listing_images.find((img) => img.is_cover) ?? listing!.listing_images[0]
    : null;

const supabaseUrl = import.meta.env.PUBLIC_SUPABASE_URL ?? '';
const imageUrl = coverImage && supabaseUrl
  ? `${supabaseUrl}/storage/v1/object/public/listing-images/${coverImage.storage_path}`
  : null;
---

<a href={href} class="group block cm-card p-4 hover:shadow-lg transition">
  <div class="flex items-start justify-between gap-3 mb-3">
    <span class:list={[isListing ? 'cm-tag-sell' : 'cm-tag-buy']}>
      {isListing ? '売りたい' : '買いたい'}
    </span>
    <span class="text-xs text-ink-muted">{anonLabel}</span>
  </div>

  {
    imageUrl && (
      <img
        src={imageUrl}
        alt=""
        class="mb-3 h-36 w-full rounded-xl object-cover bg-cream"
        loading="lazy"
      />
    )
  }

  <p class="text-xs text-plum-soft mb-1">{categoryName}</p>
  <h3 class="font-heading font-semibold text-plum group-hover:text-rose line-clamp-2">{title}</h3>

  {
    (yearLabel || conditionLabel) && (
      <div class="mt-2 flex flex-wrap gap-1.5">
        {yearLabel && (
          <span class="rounded-full bg-cream px-2 py-0.5 text-xs text-plum-soft tabular-nums">{yearLabel}</span>
        )}
        {conditionLabel && (
          <span class="rounded-full bg-cream px-2 py-0.5 text-xs text-plum-soft">{conditionLabel}</span>
        )}
        {isListing && listing!.has_accessories && (
          <span class="rounded-full bg-cream px-2 py-0.5 text-xs text-plum-soft">付属品あり</span>
        )}
      </div>
    )
  }

  <dl class="mt-3 grid grid-cols-2 gap-2 text-sm">
    <div>
      <dt class="text-plum-soft text-xs">{isListing ? '希望価格' : '予算'}</dt>
      <dd class="font-semibold text-plum tabular-nums">{priceLabel}</dd>
    </div>
    <div>
      <dt class="text-plum-soft text-xs">{isListing ? '所在地' : '希望エリア'}</dt>
      <dd class="text-plum">{location}</dd>
    </div>
  </dl>
</a>
