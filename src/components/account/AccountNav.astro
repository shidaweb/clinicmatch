---
const links = [
  { href: '/account', label: 'マイページ', exact: true },
  { href: '/account/listings', label: '売りたい' },
  { href: '/account/wanted', label: '買いたい' },
  { href: '/account/approaches', label: '関心・提案' },
  { href: '/account/threads', label: 'メッセージ' },
  { href: '/account/deals', label: '契約・請求' },
  { href: '/account/settings', label: '設定' },
];
const path = Astro.url.pathname.replace(/\/$/, '') || '/account';
---

<nav class="account-nav" aria-label="マイページ">
  {
    links.map(({ href, label, exact }) => (
      <a
        href={href}
        aria-current={(exact ? path === href : path === href || path.startsWith(`${href}/`)) ? 'page' : undefined}
      >
        {label}
      </a>
    ))
  }
</nav>
<style>
  .account-nav {
    display: flex;
    gap: 24px;
    overflow-x: auto;
    border-bottom: 1px solid var(--line);
    margin-bottom: 28px;
  }
  .account-nav a {
    flex-shrink: 0;
    padding: 14px 0;
    font-size: 14px;
    color: var(--plum-soft);
    border-bottom: 2px solid transparent;
  }
  .account-nav a[aria-current] {
    color: var(--plum);
    font-weight: 700;
    border-bottom-color: var(--rose-deep);
  }
  .account-nav a:hover {
    color: var(--rose-deep);
  }
  @media (max-width: 639px) {
    .account-nav {
      gap: 20px;
    }
    .account-nav a {
      font-size: 13px;
    }
  }
</style>
