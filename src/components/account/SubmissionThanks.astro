---
interface Props {
  kind: 'wanted' | 'listing';
}

const { kind } = Astro.props;

const config =
  kind === 'wanted'
    ? {
        title: '買いたいの審査提出が完了しました',
        lead: 'ご登録ありがとうございます。運営が内容を確認したうえで公開します。',
        steps: [
          '運営が登録内容を確認します（通常1〜2営業日）',
          '問題なければ公開され、在庫・取引事例一覧に掲載されます',
          '公開時に登録メールアドレスへお知らせします',
          '該当する売り手から関心・提案があれば、運営よりご連絡します',
        ],
        listHref: '/account/wanted',
        listLabel: '買いたい一覧を見る',
      }
    : {
        title: '売りたいの審査提出が完了しました',
        lead: 'ご登録ありがとうございます。運営が内容を確認したうえで公開します。',
        steps: [
          '運営が登録内容を確認します（通常1〜2営業日）',
          '問題なければ公開され、在庫・取引事例一覧に掲載されます',
          '公開時に登録メールアドレスへお知らせします',
          '買い手から関心・提案があれば、運営よりご連絡します',
        ],
        listHref: '/account/listings',
        listLabel: '売りたい一覧を見る',
      };
---

<div class="cm-card p-8 text-center">
  <p class="inline-flex items-center justify-center rounded-full bg-sage/15 px-3 py-1 text-xs font-semibold text-sage mb-4">
    審査提出完了
  </p>
  <h2 class="cm-heading text-2xl font-semibold text-plum mb-3">{config.title}</h2>
  <p class="text-sm text-plum-soft leading-relaxed mb-6">{config.lead}</p>

  <div class="text-left max-w-md mx-auto mb-8">
    <p class="text-sm font-medium text-plum mb-3">このあと起きること</p>
    <ol class="text-sm text-plum-soft space-y-2 list-decimal list-inside">
      {config.steps.map((step) => (
        <li>{step}</li>
      ))}
    </ol>
  </div>

  <div class="flex flex-col sm:flex-row gap-3 justify-center">
    <a href={config.listHref} class="cm-btn-primary text-sm">
      {config.listLabel}
    </a>
    <a href="/account" class="cm-btn-secondary text-sm">
      マイページへ
    </a>
  </div>
</div>
