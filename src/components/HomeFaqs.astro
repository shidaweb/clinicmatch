---
interface FaqItem {
  q: string;
  a: string;
}

interface Props {
  title?: string;
  subtitle?: string;
  items: FaqItem[];
}

const { title = 'よくある質問', subtitle = '検討の初期段階で気になりやすい点をまとめました。', items } = Astro.props;
---

<section id="faq" class="py-[52px] md:py-[72px] bg-ivory border-t border-line">
  <div class="max-w-content mx-auto px-4 sm:px-6">
    <h2 class="cm-heading text-xl md:text-2xl font-semibold text-plum text-center">{title}</h2>
    {subtitle && <p class="mt-3 text-center text-plum-soft">{subtitle}</p>}

    <div class="mt-8 grid gap-2 md:grid-cols-2 md:gap-x-10 max-w-[980px] mx-auto">
      {
        items.map((item, index) => (
          <details class="home-faq border-b border-line py-1.5 group" open={index === 0}>
            <summary class="cursor-pointer list-none py-3 text-sm font-bold text-plum flex gap-2.5 items-baseline">
              {item.q}
            </summary>
            <p class="pb-3.5 pl-5 text-[13.5px] text-plum-soft leading-relaxed">{item.a}</p>
          </details>
        ))
      }
    </div>
  </div>
</section>

<style>
  .home-faq summary::-webkit-details-marker {
    display: none;
  }

  .home-faq summary::before {
    content: '›';
    color: var(--rose);
    font-weight: 700;
    transition: transform 0.2s ease;
    flex-shrink: 0;
  }

  .home-faq[open] summary::before {
    transform: rotate(90deg);
  }

  @media (prefers-reduced-motion: reduce) {
    .home-faq summary::before {
      transition: none;
    }
  }
</style>
