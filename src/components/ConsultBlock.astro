---
import ConsultButton from '~/components/ConsultButton.astro';
interface Props {
  class?: string;
}
const { class: className = '' } = Astro.props;
---

<section class:list={['customer-consult border-t border-line bg-cream', className]}>
  <div class="max-w-content mx-auto px-4 sm:px-6 customer-consult-inner">
    <figure class="consult-equipment">
      <img
        src="/images/equipment/collage-768.webp"
        alt="美容医療機器のイメージコラージュ"
        width="768"
        height="512"
        loading="lazy"
        decoding="async"
      /><figcaption>機器のイメージ</figcaption>
    </figure>
    <div>
      <h2 class="cm-heading text-xl md:text-2xl font-semibold">売却・購入について相談する</h2><p>
        機種や条件が決まっていなくても、分かる範囲でお知らせください。
      </p>
    </div>
    <ConsultButton variant="primary" />
  </div>
</section>
<style>
  .consult-equipment {
    width: 180px;
    flex-shrink: 0;
  }
  .consult-equipment img {
    border-radius: 6px;
    width: 100%;
    height: auto;
  }
  .consult-equipment figcaption {
    font-size: 11px;
    color: var(--plum-soft);
    margin-top: 6px;
  }
  .customer-consult {
    padding: 40px 0;
  }
  .customer-consult-inner {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 24px;
  }
  .customer-consult p {
    margin-top: 12px;
    color: var(--plum-soft);
    font-size: 14px;
    line-height: 1.8;
  }
  @media (max-width: 767px) {
    .customer-consult-inner {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>
