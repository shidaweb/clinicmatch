---
import { Icon } from 'astro-icon/components';
import { SITE } from 'astrowind:config';
---

<span class="self-center flex items-center gap-2.5 text-2xl md:text-[1.65rem] font-heading font-bold text-plum whitespace-nowrap">
  <span class="inline-flex items-center justify-center w-9 h-9 rounded-full bg-rose/10 border border-rose/25 shrink-0">
    <Icon name="tabler:stethoscope" class="w-5 h-5 text-rose" />
  </span>
  {SITE?.name}
</span>
