---
import { getPermalink } from '~/utils/permalinks';

interface Props {
  slug: string;
  title: string;
  categoryLabel: string;
  manufacturedDate: string;
  transactionDate: string;
  manufacturer?: string;
  model?: string;
}

const { slug, title, categoryLabel, manufacturedDate, transactionDate, manufacturer, model } = Astro.props;

function formatDateYMD(ym: string): string {
  if (!ym || ym.length < 6) return ym;
  const y = ym.slice(0, 4);
  const m = ym.slice(5, 7);
  return `${y}年${parseInt(m, 10)}月`;
}

const href = getPermalink(`cases/${slug}`);
const displayTitle = manufacturer && model ? `${manufacturer} ${model}` : title;
---

<a
  href={href}
  class="group block rounded-xl border border-border bg-surface p-4 shadow-sm hover:shadow-md transition"
>
  <div class="flex items-start justify-between gap-3 mb-3">
    <span class="inline-flex rounded-full bg-done px-2.5 py-0.5 text-xs font-semibold text-white">成約済</span>
    <span class="text-xs text-text-muted">{formatDateYMD(transactionDate)}</span>
  </div>

  <p class="text-xs text-text-muted mb-1">{categoryLabel}</p>
  <h3 class="font-semibold text-text group-hover:text-brand-600 line-clamp-2">{displayTitle}</h3>

  <dl class="mt-3 grid grid-cols-2 gap-2 text-sm">
    <div>
      <dt class="text-text-muted text-xs">製造</dt>
      <dd class="font-medium text-text tabular-nums">{formatDateYMD(manufacturedDate)}</dd>
    </div>
    <div>
      <dt class="text-text-muted text-xs">取引時期</dt>
      <dd class="font-medium text-text tabular-nums">{formatDateYMD(transactionDate)}</dd>
    </div>
  </dl>
</a>
