---
import { getPermalink } from '~/utils/permalinks';

interface Props {
  slug: string;
  title: string;
  categoryLabel: string;
  manufacturedDate: string;
  transactionDate: string;
  manufacturer?: string;
  model?: string;
}

const { slug, title, categoryLabel, manufacturedDate, transactionDate, manufacturer, model } = Astro.props;

function formatDateYMD(ym: string): string {
  if (!ym || ym.length < 6) return ym;
  const y = ym.slice(0, 4);
  const m = ym.slice(5, 7);
  return `${y}年${parseInt(m, 10)}月`;
}

const href = getPermalink(`cases/${slug}`);
const displayTitle = manufacturer && model ? `${manufacturer} ${model}` : title;
---

<a href={href} class="group block cm-card p-4 hover:shadow-lg transition">
  <div class="flex items-start justify-between gap-3 mb-3">
    <span class="cm-tag-done">成約済</span>
    <span class="text-xs text-ink-muted">{formatDateYMD(transactionDate)}</span>
  </div>

  <p class="text-xs text-plum-soft mb-1">{categoryLabel}</p>
  <h3 class="font-heading font-semibold text-plum group-hover:text-rose line-clamp-2">{displayTitle}</h3>

  <dl class="mt-3 grid grid-cols-2 gap-2 text-sm">
    <div>
      <dt class="text-plum-soft text-xs">製造</dt>
      <dd class="font-medium text-plum tabular-nums">{formatDateYMD(manufacturedDate)}</dd>
    </div>
    <div>
      <dt class="text-plum-soft text-xs">取引時期</dt>
      <dd class="font-medium text-plum tabular-nums">{formatDateYMD(transactionDate)}</dd>
    </div>
  </dl>
</a>
