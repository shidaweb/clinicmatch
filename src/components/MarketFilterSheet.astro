---
import MarketFilters from '~/components/MarketFilters.astro';
import type { CasesFilterParams } from '~/lib/cases-page';

interface Props extends Partial<CasesFilterParams> {
  activeCount?: number;
}

const props = Astro.props;
const { activeCount = 0, ...filterProps } = props;
---

<div class="lg:hidden mb-4">
  <button
    type="button"
    id="filter-open"
    class="w-full rounded-pill border border-rose/35 bg-ivory px-4 py-3 text-left shadow-sm"
    aria-expanded="false"
    aria-controls="filter-sheet-panel"
  >
    <span class="flex items-center justify-between gap-3">
      <span>
        <span class="block text-sm font-semibold text-plum">
          {activeCount > 0 ? '条件を変更する' : '条件を指定して探す'}
        </span>
        <span class="mt-0.5 block text-xs text-plum-soft">カテゴリ・価格・エリアで絞り込めます</span>
      </span>
      {activeCount > 0 ? (
        <span class="inline-flex rounded-pill bg-rose px-2.5 py-1 text-xs font-semibold text-white">{activeCount}件</span>
      ) : (
        <span class="text-xs text-rose">設定</span>
      )}
    </span>
  </button>
</div>

<div
  id="filter-sheet"
  class="fixed inset-0 z-50 hidden lg:hidden"
  role="dialog"
  aria-modal="true"
  aria-labelledby="filter-sheet-title"
>
  <div id="filter-backdrop" class="absolute inset-0 bg-plum/40"></div>
  <div
    id="filter-sheet-panel"
    class="absolute bottom-0 inset-x-0 bg-ivory rounded-t-card border-t border-line p-6 max-h-[88vh] overflow-y-auto shadow-float"
  >
    <div class="flex items-center justify-between mb-4">
      <h2 id="filter-sheet-title" class="font-heading text-lg font-semibold text-plum">検索条件を設定</h2>
      <button type="button" id="filter-close" class="text-sm text-plum-soft hover:text-rose px-2 py-1">閉じる</button>
    </div>
    <MarketFilters {...filterProps} />
  </div>
</div>

<script>
  const openBtn = document.getElementById('filter-open');
  const sheet = document.getElementById('filter-sheet');
  const backdrop = document.getElementById('filter-backdrop');
  const closeBtn = document.getElementById('filter-close');

  function openSheet() {
    sheet?.classList.remove('hidden');
    openBtn?.setAttribute('aria-expanded', 'true');
    document.body.style.overflow = 'hidden';
  }

  function closeSheet() {
    sheet?.classList.add('hidden');
    openBtn?.setAttribute('aria-expanded', 'false');
    document.body.style.overflow = '';
  }

  openBtn?.addEventListener('click', openSheet);
  closeBtn?.addEventListener('click', closeSheet);
  backdrop?.addEventListener('click', closeSheet);
</script>
