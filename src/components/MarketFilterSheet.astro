---
import MarketFilters from '~/components/MarketFilters.astro';
import type { CasesFilterParams } from '~/lib/cases-page';

interface Props extends Partial<CasesFilterParams> {
  activeCount?: number;
}

const props = Astro.props;
const { activeCount = 0, ...filterProps } = props;
---

<div class="lg:hidden mb-4">
  <button
    type="button"
    id="filter-open"
    class="w-full rounded-pill border border-rose/35 bg-ivory px-4 py-3 text-left shadow-sm"
    aria-expanded="false"
    aria-controls="filter-sheet-panel"
  >
    <span class="flex items-center justify-between gap-3">
      <span>
        <span class="block text-sm font-semibold text-plum">
          {activeCount > 0 ? '条件を変更する' : '条件を指定して探す'}
        </span>
        <span class="mt-0.5 block text-xs text-plum-soft">カテゴリ・価格・エリアで絞り込めます</span>
      </span>
      {activeCount > 0 ? (
        <span class="inline-flex rounded-pill bg-rose px-2.5 py-1 text-xs font-semibold text-white">{activeCount}件</span>
      ) : (
        <span class="text-xs text-rose">設定</span>
      )}
    </span>
  </button>
</div>

<div
  id="filter-sheet"
  class="fixed inset-0 z-[60] hidden lg:hidden"
  role="dialog"
  aria-modal="true"
  aria-labelledby="filter-sheet-title"
>
  <div class="absolute inset-0 bg-plum/40" data-filter-close role="presentation"></div>
  <div
    id="filter-sheet-panel"
    class="absolute inset-x-0 bottom-0 max-h-[min(85vh,100dvh-4rem)] overflow-y-auto overscroll-contain rounded-t-3xl border-t border-line bg-ivory p-5 shadow-soft pb-[calc(1.25rem+env(safe-area-inset-bottom))]"
  >
    <div class="mb-4 flex items-center justify-between gap-3 sticky top-0 z-10 bg-ivory pb-2">
      <h2 id="filter-sheet-title" class="font-heading text-lg font-semibold text-plum">検索条件を設定</h2>
      <button type="button" id="filter-close" class="shrink-0 px-2 py-1 text-sm text-plum-soft hover:text-rose">
        閉じる
      </button>
    </div>
    <MarketFilters {...filterProps} />
  </div>
</div>

<script is:inline>
  let filterSheetAbort = null;

  function initMarketFilterSheet() {
    filterSheetAbort?.abort();
    filterSheetAbort = new AbortController();
    const { signal } = filterSheetAbort;

    const openBtn = document.getElementById('filter-open');
    const sheet = document.getElementById('filter-sheet');
    if (!openBtn || !sheet) return;

    const closeBtn = document.getElementById('filter-close');
    const backdrop = sheet.querySelector('[data-filter-close]');

    const openSheet = () => {
      sheet.classList.remove('hidden');
      openBtn.setAttribute('aria-expanded', 'true');
    };

    const closeSheet = () => {
      sheet.classList.add('hidden');
      openBtn.setAttribute('aria-expanded', 'false');
    };

    openBtn.addEventListener('click', openSheet, { signal });
    closeBtn?.addEventListener('click', closeSheet, { signal });
    backdrop?.addEventListener('click', closeSheet, { signal });
    document.addEventListener(
      'keydown',
      (event) => {
        if (event.key === 'Escape' && !sheet.classList.contains('hidden')) {
          closeSheet();
        }
      },
      { signal },
    );
  }

  document.addEventListener('astro:page-load', initMarketFilterSheet);
</script>
