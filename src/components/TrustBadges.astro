---
import { Icon } from 'astro-icon/components';

interface Props {
  compact?: boolean;
}

const { compact = false } = Astro.props;

const items = [
  { label: '運営が仲介', sub: '条件整理から合意まで', icon: 'tabler:shield-check' },
  { label: '匿名相談OK', sub: '連絡先は合意後開示', icon: 'tabler:user-shield' },
  { label: '累計38件', sub: '成約実績', icon: 'tabler:chart-bar' },
  { label: '法人確認', sub: '法人番号で登録', icon: 'tabler:building-bank' },
];
---

<div class:list={['cm-trust-bar', compact ? 'max-w-3xl mx-auto' : '']}>
  {
    items.map(({ label, sub, icon }) => (
      <div>
        <Icon name={icon} class="w-5 h-5 text-sage mx-auto mb-2" />
        <p class="font-heading text-sm font-semibold text-plum">{label}</p>
        <p class="mt-0.5 text-[11px] text-plum-soft tracking-wide">{sub}</p>
      </div>
    ))
  }
</div>
