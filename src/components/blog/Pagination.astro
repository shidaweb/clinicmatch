---
import { getPermalink } from '~/utils/permalinks';

export interface Props {
  prevUrl?: string;
  nextUrl?: string;
  prevText?: string;
  nextText?: string;
  currentPage?: number;
  totalPages?: number;
}

const {
  prevUrl,
  nextUrl,
  prevText = '新しい記事',
  nextText = '過去の記事',
  currentPage = 1,
  totalPages = 1,
} = Astro.props;
---

{
  (prevUrl || nextUrl || totalPages > 1) && (
    <nav class="cm-pagination mt-10" aria-label="ブログページネーション">
      {
        prevUrl ? (
          <a href={getPermalink(prevUrl)} class="cm-pagination-nav" aria-label="前のページ">‹</a>
        ) : (
          <span class="cm-pagination-nav is-disabled" aria-hidden="true">‹</span>
        )
      }

      {totalPages > 1 && (
        <span class="cm-pagination-current" aria-current="page">
          {currentPage}
        </span>
      )}

      {
        nextUrl ? (
          <a href={getPermalink(nextUrl)} class="cm-pagination-nav" aria-label="次のページ">›</a>
        ) : (
          <span class="cm-pagination-nav is-disabled" aria-hidden="true">›</span>
        )
      }

      <span class="sr-only">
        {prevUrl ? prevText : ''} {nextUrl ? nextText : ''}
      </span>
    </nav>
  )
}
