---
const { title = await Astro.slots.render('default'), subtitle = await Astro.slots.render('subtitle') } = Astro.props;
---

<header class="mb-8 md:mb-16 text-center max-w-3xl mx-auto">
  <h1 class="cm-heading text-[26px] md:text-[32px] font-semibold" set:html={title} />
  {
    subtitle && (
      <div class="mt-2 md:mt-3 mx-auto text-sm text-plum-soft max-w-2xl" set:html={subtitle} />
    )
  }
</header>
