---
import { PREFECTURES } from '~/lib/marketplace';
import { buildCasesUrl, type CasesFilterParams } from '~/lib/cases-page';

interface Props extends Partial<CasesFilterParams> {
  basePath?: string;
}

const {
  view = 'active',
  type = 'all',
  category = '',
  prefecture = '',
  city = '',
  minPrice = '',
  maxPrice = '',
  sort = 'new',
  q = '',
  listingKind = '',
  clinicalUse = '',
  validOnly = '',
  basePath = '/cases',
} = Astro.props;

const filters: CasesFilterParams = {
  view,
  type,
  category,
  prefecture,
  city,
  minPrice,
  maxPrice,
  sort,
  q,
  listingKind,
  clinicalUse,
  validOnly,
  page: '',
};

const buildUrl = (overrides: Partial<CasesFilterParams>) => {
  const url = buildCasesUrl(overrides, filters);
  return basePath === '/cases' ? url : url.replace('/cases', basePath);
};
---

<form method="get" action={basePath} class="cm-card p-4 space-y-4 lg:border-0 lg:shadow-none lg:p-0 lg:bg-transparent">
  <input type="hidden" name="view" value={view} />

  <div>
    <label for="category" class="cm-label">カテゴリ</label>
    <select id="category" name="category" class="cm-input">
      <option value="">すべて</option>
      <option value="hair-removal" selected={category === 'hair-removal'}>脱毛</option>
      <option value="pico-laser" selected={category === 'pico-laser'}>ピコレーザー</option>
      <option value="ipl" selected={category === 'ipl'}>IPL・光治療</option>
      <option value="hifu" selected={category === 'hifu'}>HIFU</option>
      <option value="rf" selected={category === 'rf'}>RF・高周波</option>
      <option value="body" selected={category === 'body'}>痩身・ボディ</option>
    </select>
  </div>

  <div>
    <label for="type" class="cm-label">種別（募集中）</label>
    <select id="type" name="type" class="cm-input">
      <option value="all" selected={type === 'all'}>売りたい＋買いたい</option>
      <option value="listing" selected={type === 'listing'}>売りたいのみ</option>
      <option value="wanted" selected={type === 'wanted'}>買いたいのみ</option>
    </select>
  </div>

  <div>
    <label for="listingKind" class="cm-label">出品種別（売りたい）</label>
    <select id="listingKind" name="listingKind" class="cm-input">
      <option value="">すべて</option>
      <option value="device" selected={listingKind === 'device'}>機器本体</option>
      <option value="consumable_valid" selected={listingKind === 'consumable_valid'}>消耗品（期限内）</option>
      <option value="consumable_expired" selected={listingKind === 'consumable_expired'}>消耗品（期限切れ・研修用）</option>
    </select>
  </div>

  <div>
    <label for="clinicalUse" class="cm-label">患者施術可否（売りたい）</label>
    <select id="clinicalUse" name="clinicalUse" class="cm-input">
      <option value="">すべて</option>
      <option value="patient_ok" selected={clinicalUse === 'patient_ok'}>患者施術可</option>
      <option value="training_only" selected={clinicalUse === 'training_only'}>患者施術不可</option>
    </select>
  </div>

  <label class="inline-flex items-center gap-2 text-sm">
    <input type="checkbox" name="validOnly" value="1" checked={validOnly === '1'} />
    期限内のみ表示（消耗品）
  </label>

  <div>
    <label for="prefecture" class="cm-label">都道府県</label>
    <select id="prefecture" name="prefecture" class="cm-input">
      <option value="">すべて</option>
      {PREFECTURES.map((pref) => (
        <option value={pref} selected={prefecture === pref}>{pref}</option>
      ))}
    </select>
  </div>

  <div>
    <label for="city" class="cm-label">市区町村</label>
    <input
      id="city"
      name="city"
      type="text"
      value={city}
      placeholder="例：渋谷区"
      class="cm-input"
    />
  </div>

  <div class="space-y-3">
    <p class="cm-label mb-0">価格帯</p>
    <div>
      <label for="minPrice" class="cm-label text-xs">下限</label>
      <input
        id="minPrice"
        name="minPrice"
        type="number"
        inputmode="numeric"
        value={minPrice}
        placeholder="例：3000000"
        class="cm-input"
      />
    </div>
    <div>
      <label for="maxPrice" class="cm-label text-xs">上限</label>
      <input
        id="maxPrice"
        name="maxPrice"
        type="number"
        inputmode="numeric"
        value={maxPrice}
        placeholder="例：10000000"
        class="cm-input"
      />
    </div>
  </div>

  <div>
    <label for="sort" class="cm-label">並び替え</label>
    <select id="sort" name="sort" class="cm-input">
      <option value="new" selected={sort === 'new'}>新着順</option>
      <option value="price" selected={sort === 'price'}>価格順</option>
      <option value="year" selected={sort === 'year'}>年式順</option>
    </select>
  </div>

  <button type="submit" class="cm-btn-primary w-full">絞り込む</button>
</form>
