---
import { PREFECTURES } from '~/lib/marketplace';
import { buildCasesUrl, type CasesFilterParams } from '~/lib/cases-page';

interface Props extends Partial<CasesFilterParams> {
  basePath?: string;
}

const {
  view = 'active',
  type = 'all',
  category = '',
  prefecture = '',
  city = '',
  minPrice = '',
  maxPrice = '',
  sort = 'new',
  q = '',
  basePath = '/cases',
} = Astro.props;

const filters: CasesFilterParams = { view, type, category, prefecture, city, minPrice, maxPrice, sort, q };

const buildUrl = (overrides: Partial<CasesFilterParams>) => {
  const url = buildCasesUrl(overrides, filters);
  return basePath === '/cases' ? url : url.replace('/cases', basePath);
};
---

<form method="get" action={basePath} class="cm-card p-4 space-y-4">
  <input type="hidden" name="view" value={view} />

  <div>
    <label for="category" class="block text-sm font-medium text-text mb-1">カテゴリ</label>
    <select id="category" name="category" class="w-full rounded-xl border border-border px-3 py-2 text-sm">
      <option value="">すべて</option>
      <option value="hair-removal" selected={category === 'hair-removal'}>脱毛</option>
      <option value="pico-laser" selected={category === 'pico-laser'}>ピコレーザー</option>
      <option value="ipl" selected={category === 'ipl'}>IPL・光治療</option>
      <option value="hifu" selected={category === 'hifu'}>HIFU</option>
      <option value="rf" selected={category === 'rf'}>RF・高周波</option>
      <option value="body" selected={category === 'body'}>痩身・ボディ</option>
    </select>
  </div>

  <div>
    <label for="type" class="block text-sm font-medium text-text mb-1">種別（募集中）</label>
    <select id="type" name="type" class="w-full rounded-xl border border-border px-3 py-2 text-sm">
      <option value="all" selected={type === 'all'}>売りたい＋買いたい</option>
      <option value="listing" selected={type === 'listing'}>売りたいのみ</option>
      <option value="wanted" selected={type === 'wanted'}>買いたいのみ</option>
    </select>
  </div>

  <div>
    <label for="prefecture" class="block text-sm font-medium text-text mb-1">都道府県</label>
    <select id="prefecture" name="prefecture" class="w-full rounded-xl border border-border px-3 py-2 text-sm">
      <option value="">すべて</option>
      {PREFECTURES.map((pref) => (
        <option value={pref} selected={prefecture === pref}>{pref}</option>
      ))}
    </select>
  </div>

  <div>
    <label for="city" class="block text-sm font-medium text-text mb-1">市区町村</label>
    <input
      id="city"
      name="city"
      type="text"
      value={city}
      placeholder="例：渋谷区"
      class="w-full rounded-xl border border-border px-3 py-2 text-sm"
    />
  </div>

  <div class="grid grid-cols-2 gap-3">
    <div>
      <label for="minPrice" class="block text-sm font-medium text-text mb-1">価格下限</label>
      <input id="minPrice" name="minPrice" type="number" value={minPrice} placeholder="円" class="w-full rounded-xl border border-border px-3 py-2 text-sm" />
    </div>
    <div>
      <label for="maxPrice" class="block text-sm font-medium text-text mb-1">価格上限</label>
      <input id="maxPrice" name="maxPrice" type="number" value={maxPrice} placeholder="円" class="w-full rounded-xl border border-border px-3 py-2 text-sm" />
    </div>
  </div>

  <div>
    <label for="sort" class="block text-sm font-medium text-text mb-1">並び替え</label>
    <select id="sort" name="sort" class="w-full rounded-xl border border-border px-3 py-2 text-sm">
      <option value="new" selected={sort === 'new'}>新着順</option>
      <option value="price" selected={sort === 'price'}>価格順</option>
      <option value="year" selected={sort === 'year'}>年式順</option>
    </select>
  </div>

  <button type="submit" class="btn-market-primary w-full">絞り込む</button>
</form>

<style>
  .btn-market-primary {
    @apply inline-flex items-center justify-center rounded-full bg-rose px-5 py-2.5 text-sm font-semibold text-white shadow-sm hover:bg-rose-deep transition w-full;
  }
</style>
