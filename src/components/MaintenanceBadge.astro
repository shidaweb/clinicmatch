---
import { MAINTENANCE_LABELS, TRANSFER_LABELS } from '~/lib/marketplace';

interface Props {
  makerMaintenance?: string | null;
  maintenanceTransferable?: string | null;
  hasAccessories?: boolean | null;
}

const { makerMaintenance, maintenanceTransferable, hasAccessories } = Astro.props;
---

<div class="flex flex-wrap gap-2">
  {
    makerMaintenance && (
      <span class="cm-tag-sage">
        {MAINTENANCE_LABELS[makerMaintenance] ?? makerMaintenance}
      </span>
    )
  }
  {
    maintenanceTransferable && (
      <span class="inline-flex rounded-full bg-gold/15 px-2.5 py-0.5 text-xs font-medium text-gold" style="background-color: rgb(194 163 107 / 0.15);">
        {TRANSFER_LABELS[maintenanceTransferable] ?? maintenanceTransferable}
      </span>
    )
  }
  {
    hasAccessories != null && (
      <span class="inline-flex rounded-full bg-cream px-2.5 py-0.5 text-xs font-medium text-plum-soft">
        {hasAccessories ? '付属品あり' : '付属品なし'}
      </span>
    )
  }
</div>
