---
interface Props {
  title?: string;
  message?: string;
  actionHref?: string;
  actionLabel?: string;
}

const {
  title = 'まだ投稿がありません',
  message = '条件を変えるか、新しく出品・買いたいを登録してください。',
  actionHref,
  actionLabel,
} = Astro.props;
---

<div class="rounded-2xl border border-dashed border-line bg-cream px-6 py-12 text-center">
  <h3 class="font-heading text-lg font-semibold text-plum">{title}</h3>
  <p class="mt-2 text-sm text-plum-soft">{message}</p>
  {
    actionHref && actionLabel && (
      <a href={actionHref} class="mt-6 cm-btn-primary">
        {actionLabel}
      </a>
    )
  }
</div>
