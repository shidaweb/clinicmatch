---
import { buildCasesUrl, type CasesFilterParams } from '~/lib/cases-page';

interface Props {
  currentPage: number;
  totalPages: number;
  filters: CasesFilterParams;
  class?: string;
}

const { currentPage, totalPages, filters, class: className = '' } = Astro.props;

const getHref = (page: number) =>
  buildCasesUrl({ ...filters, page: page > 1 ? String(page) : '' }, filters);

function pageRange(current: number, total: number): number[] {
  if (total <= 7) return Array.from({ length: total }, (_, i) => i + 1);
  const pages = new Set<number>([1, total, current, current - 1, current + 1]);
  return [...pages].filter((p) => p >= 1 && p <= total).sort((a, b) => a - b);
}

const pages = pageRange(currentPage, totalPages);
---

{
  totalPages > 1 && (
    <nav class:list={['cm-pagination', className]} aria-label="ページネーション">
      {
        currentPage > 1 ? (
          <a href={getHref(currentPage - 1)} class="cm-pagination-nav" aria-label="前のページ">
            ‹
          </a>
        ) : (
          <span class="cm-pagination-nav is-disabled" aria-hidden="true">‹</span>
        )
      }

      <ol class="flex items-center gap-1">
        {
          pages.map((page, index) => {
            const prev = pages[index - 1];
            const showEllipsis = prev !== undefined && page - prev > 1;
            return (
              <li class="flex items-center gap-1">
                {showEllipsis && <span class="px-1 text-muted text-sm">…</span>}
                {
                  page === currentPage ? (
                    <span class="cm-pagination-current" aria-current="page">{page}</span>
                  ) : (
                    <a href={getHref(page)} class="cm-pagination-page">{page}</a>
                  )
                }
              </li>
            );
          })
        }
      </ol>

      {
        currentPage < totalPages ? (
          <a href={getHref(currentPage + 1)} class="cm-pagination-nav" aria-label="次のページ">
            ›
          </a>
        ) : (
          <span class="cm-pagination-nav is-disabled" aria-hidden="true">›</span>
        )
      }
    </nav>
  )
}
